def help_lines() -> List[Tuple[str, str, str]]:
    """Build the drawable help rows (kind, keys, text) from KEY_BINDINGS.

    Returns:
        One tuple per screen row: ("title", "", title), ("section", "", name), ("key", keys,
        description) or ("blank", "", ""). Sections come in the order list, viewer, both and
        are separated by a blank row; KEY_BINDINGS rows without a text are not shown.

    Example: help_lines()[:3] -> [("title", "", HELP_TITLE), ("blank", "", ""),
    ("section", "", "Session list")]
    """
    rows: List[Tuple[str, str, str]] = [("title", "", HELP_TITLE)]
    for section in ("list", "viewer", "both"):
        rows.append(("blank", "", ""))
        rows.append(("section", "", SECTION_TITLES[section]))
        rows.extend(("key", b.label, b.text)
                    for b in KEY_BINDINGS if b.section == section and b.text)
    return rows


def build_keymap(owner: Any, where: str) -> Dict[str, Callable[[], Optional[bool]]]:
    """Key name (see Screen.key) -> handler method of owner, from KEY_BINDINGS.

    Args:
        owner: The App or Viewer whose on_* methods handle the keys.
        where: "list" or "viewer": which rows of KEY_BINDINGS apply.

    Returns:
        A dict mapping each key name to its bound method. A handler name that owner lacks
        raises AttributeError.

    Example: build_keymap(app, "list")["j"] is app.on_down; build_keymap(viewer, "viewer")["n"]
    is viewer.on_next_hit
    """
    return {key: getattr(owner, b.handler)
            for b in KEY_BINDINGS if where in b.where for key in b.keys}


class Screen(object):
    """The curses window plus its attribute table: drawing primitives, key input, the footer
    line editor and the help screen. Shared by App and Viewer.
    """

    def __init__(self, scr: Window, attrs: Optional[Dict[str, int]] = None) -> None:
        """Wrap the curses window scr.

        Args:
            scr: The curses window.
            attrs: Attribute table (name -> curses attribute, see Theme.curses_attrs); default
                empty, App.init_colors fills it.

        Example: Screen(scr).attrs == {}; Screen(scr, {"head": A_REVERSE}).attrs["head"] == A_REVERSE
        """
        self.scr = scr
        self.attrs: Dict[str, int] = attrs if attrs is not None else {}

    # -- drawing primitives
    def put(self, y: int, x: int, s: str, attr: int = 0) -> None:
        """Write s at row y, column x with attr, ignoring curses errors (e.g. off-screen writes).

        Args:
            y: Row.
            x: Column.
            s: Text to write.
            attr: curses attribute (default 0, plain).

        Example: put(0, 0, "hi", A_BOLD) draws "hi" at the top-left; put(99, 0, "hi") on a 24-row
        screen draws nothing and does not raise.
        """
        try:
            self.scr.addstr(y, x, s, attr)
        except curses.error:
            pass

    def text(self, y: int, x: int, s: str, maxw: int, attr: int,
             pat: Optional[Pattern[str]] = None, spans: Tuple[Span, ...] = ()) -> None:
        """Draw s at (y, x): sanitized, newlines flattened, clipped to maxw columns, with inline
        styles from spans and matches of pat drawn in the highlight attribute.

        Each character gets attr combined with the attributes of the spans covering it (a style
        attribute with a color replaces attr's color; others are OR'ed in); search matches then
        override that with the highlight. Runs of equal attributes are drawn in one call. Span
        offsets are character offsets into s; clean() leaves render()'s text unchanged, so they
        stay valid.

        Args:
            y: Row.
            x: Column.
            s: Text to draw.
            maxw: Maximum width in columns; nothing is drawn if <= 0.
            attr: curses attribute for the normal text.
            pat: Compiled regex whose matches are highlighted, or None for no highlighting.
            spans: (start, end, style) inline styles, style a key of self.attrs (default none).

        Example: text(3, 0, "fix the bug", 20, 0, re.compile("bug", re.I)) draws "fix the " plain
        at column 0 and "bug" highlighted at column 8; with maxw=5 it draws only "fix t".
        With spans ((4, 7, "bold"),) the "the" is drawn bold.
        """
        s = clip(clean(s).replace("\n", " "), maxw)
        if not s or maxw <= 0:
            return
        if pat is None and not spans:
            self.put(y, x, s, attr)
            return
        color_mask = getattr(curses, "A_COLOR", 0xff00)
        attr_of = [attr] * len(s)
        for start, end, style in spans:
            extra = self.attrs.get(style, 0)
            for k in range(max(start, 0), min(end, len(s))):
                base = attr_of[k]
                attr_of[k] = ((base & ~color_mask) | extra) if extra & color_mask else (base | extra)
        if pat is not None:
            for m in pat.finditer(s):
                for k in range(m.start(), m.end()):
                    attr_of[k] = self.attrs["hl"]
        start = 0
        col = x
        while start < len(s):
            end = start + 1
            while end < len(s) and attr_of[end] == attr_of[start]:
                end += 1
            self.put(y, col, s[start:end], attr_of[start])
            col += str_width(s[start:end])
            start = end

    def draw_line(self, y: int, x: int, s: str, maxw: int, kind: str,
                  pat: Optional[Pattern[str]] = None, spans: Tuple[Span, ...] = ()) -> None:
        """Draw one rendered transcript row in the attribute for its kind. "prompt" rows first
        get the whole width painted with the prompt attribute so the band spans the row.

        Args:
            y: Row.
            x: Column.
            s: Row text.
            maxw: Width in columns available to the row.
            kind: The row's kind (see Line); unknown kinds draw plain.
            pat: Regex whose matches are highlighted, or None.
            spans: The row's inline style spans (see Line), default none.

        Example: draw_line(3, 0, "  fix it", 40, "prompt") paints 40 grey cells on row 3, then
        writes "  fix it" over them; in the basic theme (no "prompt" attribute) it is just text().
        draw_line(3, 0, "  a b", 40, "text", None, ((4, 5, "bold"),)) draws the "b" bold.
        """
        if kind == "prompt" and "prompt" in self.attrs and maxw > 0:
            self.put(y, x, " " * maxw, self.attrs["prompt"])
        self.text(y, x, s, maxw, self.attrs.get(kind, 0), pat, spans)

    def fill(self, y: int, attr: int) -> None:
        """Paint row y with attr across the full width (for the header/footer bars).

        Args:
            y: Row to paint.
            attr: curses attribute to paint with.

        Example: on an 80x24 screen, fill(23, attrs["head"]) paints all 80 cells of the last row
        with spaces in the header attribute.
        """
        h, w = self.scr.getmaxyx()
        self.put(y, 0, " " * (w - 1), attr)
        # addstr into the bottom-right cell raises (the cursor cannot advance past it),
        # so the last column is written with addch; the error it may also raise is
        # harmless because the cell has already been drawn.
        try:
            self.scr.addch(y, w - 1, " ", attr)
        except curses.error:
            pass

    # -- key input
    def key(self) -> Optional[str]:
        """Read one key and return its name: printable keys as themselves; special keys as names
        ("ENTER", "ESC", "BS", "CU", "TAB", "CTRL_C", "UP", "DOWN", "PGUP", "PGDN", "HOME", "END",
        "SUP", "SDOWN", "RESIZE", "MOUSE"); unmapped special keys as "UNKNOWN"; None if nothing arrived.

        Returns:
            A key name (a printable character or a name from the list above), or None if no key
            arrived.

        Examples: pressing j -> "j"; pressing Enter -> "ENTER"; pressing F5 -> "UNKNOWN";
        Ctrl-U -> "CU"; read timeout -> None
        """
        try:
            k = self.scr.get_wch()
        except KeyboardInterrupt:
            return "CTRL_C"
        except curses.error:
            return None
        if isinstance(k, str):
            return {"\n": "ENTER", "\r": "ENTER", "\x1b": "ESC", "\x7f": "BS", "\b": "BS",
                    "\x15": "CU", "\t": "TAB", "\x03": "CTRL_C"}.get(k, k)
        names: Dict[int, str] = {curses.KEY_UP: "UP", curses.KEY_DOWN: "DOWN", curses.KEY_PPAGE: "PGUP",
                 curses.KEY_NPAGE: "PGDN", curses.KEY_HOME: "HOME", curses.KEY_END: "END",
                 curses.KEY_RESIZE: "RESIZE", curses.KEY_BACKSPACE: "BS", curses.KEY_ENTER: "ENTER",
                 curses.KEY_MOUSE: "MOUSE"}
        for nm, val in (("KEY_SR", "SUP"), ("KEY_SF", "SDOWN"), ("KEY_BTAB", "TAB")):
            if hasattr(curses, nm):
                names[getattr(curses, nm)] = val
        # Unmapped special keys (F-keys etc.) get a name no keymap binds, so they are
        # ignored; they must not collide with a printable key such as "?" (help).
        return names.get(k, "UNKNOWN")

    @staticmethod
    def edit(buf: str, k: Optional[str]) -> Tuple[str, Optional[str]]:
        """Apply a line-edit key to buf; return (new, done) where done in (None,'ok','cancel').

        Args:
            buf: The text being edited.
            k: A key name from key(), or None.

        Returns:
            A (new_buf, done) tuple: new_buf is the edited text; done is "ok" after Enter, "cancel"
            after Esc or Ctrl-C, else None.

        Examples:
            edit("ab", "c") -> ("abc", None)
            edit("ab", "BS") -> ("a", None)
            edit("ab", "CU") -> ("", None)
            edit("ab", "ENTER") -> ("ab", "ok")
            edit("ab", "ESC") -> ("ab", "cancel")
            edit("ab", "UP") -> ("ab", None)   (non-printable keys are ignored)
        """
        if k == "ENTER":
            return buf, "ok"
        if k == "ESC" or k == "CTRL_C":
            return buf, "cancel"
        if k == "BS":
            return buf[:-1], None
        if k == "CU":
            return "", None
        if isinstance(k, str) and len(k) == 1 and k.isprintable():
            return buf + k, None
        return buf, None

    def prompt(self, label: str, initial: str, live: Optional[Callable[[str], None]] = None,
               redraw: Optional[Callable[[], None]] = None) -> Tuple[str, bool]:
        """Footer line editor. Returns (text, accepted); Esc/^C cancel, ^U erases.

        live(text) is called after each edit (the filter prompt re-filters as you type).
        redraw, if given, is called before each keystroke is read to repaint the whole view
        (so live changes show); the full-screen viewer passes None to keep its already-drawn
        frame and only repaint the footer.

        Args:
            label: Text shown before the input, e.g. "/".
            initial: Starting text of the input.
            live: Optional callback called with the text after every edit.
            redraw: Optional callback that repaints the whole view each keystroke (the list
                passes App.draw); None (default) leaves the current frame.

        Returns:
            A (text, accepted) tuple: the final text, and True for Enter or False if cancelled.

        Examples: prompt("/", "fi") with keys "x", ENTER -> ("fix", True);
                  prompt("/", "fi") with key ESC -> ("fi", False)
        """
        buf = initial
        while True:
            if redraw is not None:
                redraw()
            h, w = self.scr.getmaxyx()
            if h >= 2 and w > 2:
                self.fill(h - 1, self.attrs["head"])
                shown = label + buf
                self.put(h - 1, 0, clip(" " + shown, w - 2), self.attrs["head"])
                self.put(h - 1, min(w - 2, 1 + str_width(clip(shown, w - 3))), "_",
                         self.attrs["head"])
                self.scr.refresh()
            k = self.key()
            if k is None or k == "RESIZE":
                continue
            buf, done = self.edit(buf, k)
            if done == "ok":
                return buf, True
            if done == "cancel":
                return buf, False
            if live is not None:
                live(buf)

    def show_help(self) -> None:
        """Show the key bindings full-screen and wait for a key. j/k, arrows and PgUp/PgDn scroll
        when the help is taller than the screen; any other key closes it. Redraws on resize.

        Example: show_help() draws HELP_TITLE (bold), a "Session list" heading, rows such as
        "  /              filter (terms ANDed)", and returns when the user presses "x".
        """
        rows = help_lines()
        top = 0
        while True:
            self.scr.erase()
            h, w = self.scr.getmaxyx()
            body = max(1, h - 1)  # last row is the footer
            top = max(0, min(top, len(rows) - body))
            for y, (kind, keys, text) in enumerate(rows[top:top + body]):
                if kind == "title":
                    self.put(y, 1, clip(text, w - 2), self.attrs["bold"])
                elif kind == "section":
                    self.put(y, 1, clip(text, w - 2), self.attrs["head"])
                elif kind == "key":
                    self.put(y, 3, clip(keys, w - 4), self.attrs["asst"])
                    if w > 3 + HELP_KEY_WIDTH:
                        self.put(y, 3 + HELP_KEY_WIDTH, clip(text, w - 4 - HELP_KEY_WIDTH))
            more = len(rows) > body
            footer = HELP_FOOTER + ("  j/k scroll" if more else "")
            self.put(h - 1, 1, clip(footer, w - 2), self.attrs["dim"])
            self.scr.refresh()
            k = self.key()
            if k in (None, "RESIZE", "MOUSE"):
                continue
            if more and k in ("j", "DOWN", "SDOWN"):
                top += 1
            elif more and k in ("k", "UP", "SUP"):
                top -= 1
            elif more and k in ("PGDN", " "):
                top += body
            elif more and k in ("PGUP", "b"):
                top -= body
            else:
                return


class App(object):
    def __init__(self, scr: Window, sessions: List[Session], query: str,
                 source: str = "all",
                 background: Optional[Tuple[int, int, int]] = None) -> None:
        """Set up UI state (filter, sort, selection, scroll, caches), colors, the filtered view
        and the key map. scr is the curses window; query/source are the initial filter.

        Args:
            scr: The curses window.
            sessions: All sessions to browse.
            query: Initial filter text.
            source: Initial source filter: "all" (default), "claude" or "codex".
            background: Terminal background (r, g, b) for the Theme (row stripe, palette), or None.

        Example: App(scr, sessions, "fix", "claude") -> .view holds the Claude sessions matching
        "fix", newest first; .sel == 0; .filter.sort == "last"; .split is None (layout chosen by width)
        """
        self.screen = Screen(scr)
        self.all = sessions
        self.filter = SessionFilter(query, source)
        self.theme = Theme(background)
        self.show_results = False
        self.mine_only = False
        self.split: Optional[str] = None  # "side" / "stack" / "list"; None: by terminal width
        self.sel = 0
        self.top = 0
        self.preview_offset = 0
        self.status = ""
        self.resume: Optional[Session] = None
        self.resume_override: Optional[List[str]] = None
        self.view: List[Session] = []
        self._preview_cache_key: Optional[Tuple[Any, ...]] = None
        self._preview_cache: Tuple[List[Line], int, List[int]] = ([], 0, [])
        self._preview_scroll_key: Optional[Tuple[Any, ...]] = None
        self.init_colors()
        self.refilter()
        self.keymap = build_keymap(self, "list")

    # -- setup
    def init_colors(self) -> None:
        """Fill self.screen.attrs from the theme (see Theme.curses_attrs) and hide the cursor.

        Example: on a basic color terminal -> self.screen.attrs["sel"] == A_REVERSE
        """
        self.screen.attrs = self.theme.curses_attrs()
        try:
            curses.curs_set(0)
        except curses.error:
            pass

    # -- state
    def refilter(self, keep: bool = True) -> None:
        """Recompute self.view from the query/source/project filters and the sort mode, reset the
        scroll, and (when keep is true) keep the same session selected if it is still listed.

        Args:
            keep: If True (default), keep the currently selected session selected when it is still
                in the new view; otherwise select the first row.

        Example: view [A, B, C] with C selected (sel == 2), then query "c" leaves [C] ->
        view == [C], sel == 0; with keep=False after a filter change -> sel == 0.
        """
        cur = self.view[self.sel].path if (keep and self.view and self.sel < len(self.view)) else None
        self.view = self.filter.apply(self.all)
        self.sel = 0
        if cur:
            for i, s in enumerate(self.view):
                if s.path == cur:
                    self.sel = i
                    break
        self.top = 0

    def current(self) -> Optional[Session]:
        return self.view[self.sel] if self.view and 0 <= self.sel < len(self.view) else None

    def filter_desc(self) -> str:
        """Human-readable summary of the active filters for the header bar.

        Returns:
            Text such as "source=Codex project=proj /fix", or "none".

        Examples:
            no filters -> "none"
            source "claude", project "/work/proj", query "fix" -> "source=Claude Code project=proj /fix"
            starred_only with query "fix" -> "starred /fix"
        """
        parts = self.filter.describe()
        return " ".join(parts) if parts else "none"

    # -- layout
    def layout(self) -> Dict[str, Any]:
        """Compute screen regions for the list and preview. Returns {"mode": "side" | "stack" |
        "list", "list": Box, "prev": Box, "sep": column (side) or row (stack) of the separator}.
        Mode is self.split, else "side" when the terminal is at least SIDE_BY_SIDE_MIN_COLS wide.
        In "list" mode the list fills the body, the preview box is empty and "sep" is None.

        Returns:
            A dict with "mode" ("side", "stack" or "list"), "list" and "prev" (Box regions) and
            "sep" (separator column or row, or None).

        Examples:
            120 cols x 40 rows -> {"mode": "side", "list": (1, 0, 38, 54),
                                   "prev": (1, 55, 38, 65), "sep": 54}
            80 cols x 24 rows -> {"mode": "stack", "list": (1, 0, 11, 80),
                                  "prev": (13, 0, 10, 80), "sep": 12}
            80 cols x 24 rows, split "list" -> {"mode": "list", "list": (1, 0, 22, 80),
                                                "prev": (1, 0, 0, 0), "sep": None}
        """
        h, w = self.screen.scr.getmaxyx()
        body_top, body_bot = 1, h - 2  # inclusive rows
        bh = body_bot - body_top + 1
        mode = self.split or ("side" if w >= SIDE_BY_SIDE_MIN_COLS else "stack")
        if mode == "list":
            return {"mode": "list", "list": (body_top, 0, bh, w),
                    "prev": (body_top, 0, 0, 0), "sep": None}
        if mode == "side":
            lw = int(w * 0.45)
            return {"mode": "side", "list": (body_top, 0, bh, lw),
                    "prev": (body_top, lw + 1, bh, w - lw - 1), "sep": lw}
        lh = max(3, bh // 2)
        return {"mode": "stack", "list": (body_top, 0, lh, w),
                "prev": (body_top + lh + 1, 0, bh - lh - 1, w), "sep": body_top + lh}

    def draw(self) -> None:
        """Repaint the whole list view: header bar (counts, filter, sort), session list, separator,
        preview, and footer (status message or key hints).

        Example: 3 of 10 sessions match "fix" on a 100x30 screen -> the top row reads
        " ai-sessions  3/10 sessions  filter: /fix  sort: last activity", the footer shows the
        key hints (or self.status if set); a screen under 24x6 shows only "terminal too small".
        """
        scr = self.screen.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 6 or w < 24:
            self.screen.put(0, 0, clip("terminal too small", max(w - 1, 1)))
            scr.refresh()
            return
        pat = self.filter.regex()
        total = len(self.all)
        self.screen.fill(0, self.screen.attrs["head"])
        hdr = " ai-sessions  %d/%d sessions  filter: %s  sort: %s%s" % (
            len(self.view), total, self.filter_desc(),
            "last activity" if self.filter.sort == "last" else "start time",
            "  [results]" if self.show_results else "") + ("  [mine]" if self.mine_only else "")
        self.screen.put(0, 0, clip(hdr, w - 1), self.screen.attrs["head"])
        lay = self.layout()
        self.draw_list(lay["list"], pat)
        hz, vt = rule_chars()
        if lay["mode"] == "side":
            for y in range(1, h - 1):
                self.screen.put(y, lay["sep"], vt, self.screen.attrs["dim"])
        elif lay["mode"] == "stack":
            self.screen.put(lay["sep"], 0, hz * (w - 1), self.screen.attrs["dim"])
        self.draw_preview(lay["prev"], pat)
        self.screen.fill(h - 1, self.screen.attrs["head"])
        foot = self.status or (" j/k move  / filter  Tab source  p project  * star  S starred  s sort  "
                               "t results  u mine  Enter view  r resume  e edit+resume  y copy  R rescan  ? help  q quit")
        self.screen.put(h - 1, 0, clip(foot, w - 1), self.screen.attrs["head"])
        scr.refresh()

    def draw_list(self, box: Box, pat: Optional[Pattern[str]]) -> None:
        """Draw the session rows into box, scrolling so the selection stays visible. Each row is
        "date  star  tag  project  title", with the selected row highlighted (reverse video in the basic theme), every other row on a
        slightly different background (Theme.stripe), and filter matches highlighted.

        Args:
            box: The (y, x, height, width) region to draw in.
            pat: Regex for highlighting filter matches, or None.

        Example: row for a starred Claude session -> "2025-03-01 10:00 * CC proj   Fix the bug"
        (an unstarred one has a blank in the star column); with no
        matching sessions the first row reads "(no matching sessions)".
        """
        y0, x0, bh, bw = box
        if bw < 20 or bh < 1:
            return
        if self.sel < self.top:
            self.top = self.sel
        if self.sel >= self.top + bh:
            self.top = self.sel - bh + 1
        if not self.view:
            self.screen.put(y0, x0, clip("(no matching sessions)", bw - 1), self.screen.attrs["dim"])
            return
        projw = min(14, max(6, bw // 6))
        for i in range(bh):
            idx = self.top + i
            if idx >= len(self.view):
                break
            s = self.view[idx]
            y = y0 + i
            cur = idx == self.sel
            # Every other row gets a slightly different background (see Theme.stripe);
            # the selected row uses the "sel" attributes (see Theme.curses_attrs).
            striped = idx % 2 == 1 and not cur
            row = "sel" if cur else ("stripe" if striped else "plain")
            pre = "" if row == "plain" else row + "_"  # attrs key prefix: "cc" vs "sel_cc"
            extra = self.screen.attrs[row]
            if cur or striped:
                self.screen.put(y, x0, " " * (bw - 1), extra)
            tag_attr = self.screen.attrs[pre + ("cc" if s.source == "claude" else "cx")]
            x = x0
            self.screen.put(y, x, fmt_ts(s.last_ts if self.filter.sort == "last" else s.first_ts), self.screen.attrs[pre + "dim"])
            x += DATE_COL_WIDTH
            if s.starred:
                self.screen.put(y, x, "*", self.screen.attrs[pre + "star"])
            x += STAR_COL_WIDTH
            self.screen.put(y, x, SOURCES[s.source].tag, tag_attr)
            x += TAG_COL_WIDTH
            self.screen.text(y, x, pad(s.project, projw), projw, extra, pat)
            x += projw + 1
            self.screen.text(y, x, s.title, bw - 1 - (x - x0), extra, pat)

    def preview_lines(self, s: Session, width: int,
                      pat_terms: List[str]) -> Tuple[List[Line], int, List[int]]:
        """Rendered preview for s at width, as (lines, body_start, hit_indexes). Cached until the
        session, its last_ts, width, toggles or terms change.

        Args:
            s: The session to preview.
            width: Display width in columns.
            pat_terms: Lowercase filter terms used to find hits.

        Returns:
            A (lines, body_start, hit_indexes) tuple, as from render() and hit_lines().

        Example: preview_lines(s, 60, ["bug"]) -> ([("Fix bug", "title"), ...], 6, [8]);
        a second identical call returns the very same cached tuple.
        """
        key = (s.path, s.last_ts, width, self.show_results, self.mine_only, tuple(pat_terms))
        if self._preview_cache_key == key:
            return self._preview_cache
        msgs = INDEX.transcript(s)
        lines, start = render(s, msgs, width, self.show_results, self.mine_only)
        hits = hit_lines(lines, start, pat_terms)
        self._preview_cache_key = key
        self._preview_cache = (lines, start, hits)
        return self._preview_cache

    def draw_preview(self, box: Box, pat: Optional[Pattern[str]]) -> None:
        """Draw the preview of the selected session into box. Scroll jumps to just before the first
        filter hit when the selection or filter changes, and is otherwise clamped to the content.

        Args:
            box: The (y, x, height, width) region to draw in.
            pat: Regex for highlighting filter matches, or None.

        Example: selected session with a match on rendered line 20 for query "bug" -> preview_offset
        becomes 18 (hit - 2) and lines 18.. are drawn; with no session selected nothing is drawn.
        """
        y0, x0, bh, bw = box
        s = self.current()
        if s is None or bh < 1 or bw < 12:
            return
        terms = self.filter.terms()
        lines, start, hits = self.preview_lines(s, bw - 1, terms)
        selkey = (s.path, tuple(terms), self.show_results, self.mine_only)
        if selkey != self._preview_scroll_key:
            self._preview_scroll_key = selkey
            self.preview_offset = max(0, hits[0] - 2) if hits else 0
        self.preview_offset = max(0, min(self.preview_offset, max(0, len(lines) - bh)))
        for i in range(bh):
            j = self.preview_offset + i
            if j >= len(lines):
                break
            t, kind, spans = lines[j]
            self.screen.draw_line(y0 + i, x0, t, bw - 1, kind, pat, spans)

    # -- actions
    def move(self, d: int) -> None:
        if self.view:
            self.sel = max(0, min(len(self.view) - 1, self.sel + d))

    def mouse_event(self) -> Optional[Tuple[int, int, int]]:
        """Fetch the pending mouse event (call after key() returned "MOUSE").

        Returns:
            (x, y, button state) in screen coordinates, or None if no event could be read.

        Example: a left click at column 5, row 3 -> (5, 3, curses.BUTTON1_PRESSED)
        """
        try:
            _, x, y, _, bstate = curses.getmouse()
        except curses.error:
            return None
        return x, y, bstate

    def on_mouse(self) -> None:
        """Move the selection to the session row that was clicked, like navigating there with
        j/k. It never opens the session. Clicks outside the list rows are ignored.

        Example: clicking the third visible row (with the list scrolled to the top) selects
        self.view[2]; clicking in the preview pane changes nothing.
        """
        ev = self.mouse_event()
        if ev is None:
            return
        x, y, bstate = ev
        if not bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
            return
        y0, x0, bh, bw = self.layout()["list"]
        if not (y0 <= y < y0 + bh and x0 <= x < x0 + bw):
            return
        # self.top is the scroll offset from the last draw, i.e. what is on screen now.
        idx = self.top + (y - y0)
        if idx < len(self.view):
            self.sel = idx

    def list_height(self) -> int:
        return max(1, self.layout()["list"][2])

    def preview_height(self) -> int:
        return max(1, self.layout()["prev"][2])

    # -- key handlers: each returns True to leave the main loop (quit / resume chosen)
    def on_quit(self) -> bool:
        return True

    def on_help(self) -> None:
        self.screen.show_help()

    def on_down(self) -> None:
        self.move(1)

    def on_up(self) -> None:
        self.move(-1)

    def on_page_down(self) -> None:
        self.move(self.list_height() - 1)

    def on_page_up(self) -> None:
        self.move(-(self.list_height() - 1))

    def on_first(self) -> None:
        self.sel = 0

    def on_last(self) -> None:
        self.sel = max(0, len(self.view) - 1)

    def on_preview_down(self) -> None:
        self.preview_offset += max(1, self.preview_height() // 2)

    def on_preview_up(self) -> None:
        self.preview_offset = max(0, self.preview_offset - max(1, self.preview_height() // 2))

    def on_filter(self) -> None:
        self.filter_mode()

    def on_clear_filter(self) -> None:
        """Esc in the list: drop the text filter and refilter; does nothing if there is none.

        Example: query "fix" -> query == "" and the view shows all sessions again.
        """
        if self.filter.query:
            self.filter.query = ""
            self.refilter()

    def on_cycle_source(self) -> None:
        """Tab: cycle the source filter all -> claude -> codex -> all, then refilter.

        Example: source "claude" -> source "codex"; source "codex" -> "all"
        """
        order = ["all"] + [s.key for s in SOURCE_LIST]
        self.filter.source = order[(order.index(self.filter.source) + 1) % len(order)]
        self.refilter()

    def on_toggle_project(self) -> None:
        """Restrict the list to the selected session's project (its cwd), or clear that restriction.

        Example: project None with a selected session in /work/proj -> project == "/work/proj";
        pressed again -> project is None. A selected session with no cwd leaves project None.
        """
        s = self.current()
        if self.filter.project is not None:
            self.filter.project = None
        elif s is not None and s.cwd:
            self.filter.project = s.cwd
        self.refilter()

    def on_toggle_sort(self) -> None:
        """Switch the sort mode between last activity and start time, then refilter.

        Example: sort "last" -> sort "start" -> sort "last"
        """
        self.filter.sort = "start" if self.filter.sort == "last" else "last"
        self.refilter()

    def on_toggle_split(self) -> None:
        """Cycle the layout side by side -> stacked -> list only -> side by side, starting from
        the layout in effect now (which is chosen by terminal width until the first press).

        Example: on a 120-column terminal with split None -> split == "stack" and
        status == " layout: list above preview"; pressing again -> split == "list" and
        status == " layout: list only"
        """
        cycle = {"side": "stack", "stack": "list", "list": "side"}
        self.split = cycle[self.layout()["mode"]]
        self.status = " layout: %s" % {"side": "list beside preview",
                                       "stack": "list above preview",
                                       "list": "list only"}[self.split]

    def on_toggle_results(self) -> None:
        """Toggle display of tool results in transcripts and say so in the status line.

        Example: show_results False -> True and status == " tool results shown"
        """
        self.show_results = not self.show_results
        self.status = " tool results %s" % ("shown" if self.show_results else "hidden")

    def on_toggle_mine(self) -> None:
        """Toggle showing only your own input (prompts and slash commands) and update the status line.

        Example: mine_only False -> True and status == " showing only your input"
        """
        self.mine_only = not self.mine_only
        self.status = " showing %s" % ("only your input" if self.mine_only else "full transcript")

    def on_toggle_starred_only(self) -> None:
        """S: toggle listing only starred sessions, and say so in the status line.

        Example: starred_only False -> True and the view holds just the starred sessions
        """
        self.filter.starred_only = not self.filter.starred_only
        self.refilter()
        self.status = " showing %s" % ("only starred sessions" if self.filter.starred_only else "all sessions")

    def toggle_star(self, s: Session) -> None:
        """Flip the star on s: write stars.json, update s.starred and report in the status line.
        If the starred-only filter is on, refilter so an unstarred session leaves the list.

        Args:
            s: The session to star or unstar.

        Example: unstarred s -> s.starred is True, status == " starred: Fix bug" and
        stars.json lists s.id; on a write error s.starred is unchanged and
        status == " could not save stars: [Errno 13] Permission denied: ..."
        """
        on = not s.starred
        try:
            STARS.set(s.id, on)
        except OSError as e:
            self.status = " could not save stars: %s" % e
            return
        s.starred = on
        self.status = " %s: %s" % ("starred" if on else "unstarred", s.title)
        if self.filter.starred_only and not on:
            self.refilter()

    def on_star(self) -> None:
        """*: star or unstar the selected session (see toggle_star)."""
        s = self.current()
        if s is not None:
            self.toggle_star(s)

    def on_rescan(self) -> None:
        """Reload all sessions from disk (picking up new or changed transcripts) and refilter.

        Example: after a new transcript appears, on_rescan() -> len(self.all) grows by 1 and
        status == " rescanned: 11 sessions"
        """
        self.all = INDEX.load()
        self.refilter()
        self.status = " rescanned: %d sessions" % len(self.all)

    def on_open(self) -> bool:
        s = self.current()
        return s is not None and self.viewer(s)

    def on_resume(self) -> bool:
        """r: choose the current session for resuming and leave the main loop.

        Returns:
            True to leave the main loop (a session was chosen), else False.

        Example: with a session selected whose cwd exists -> resume == that session, returns True;
        with an empty list or a vanished cwd -> returns False (status explains why).
        """
        s = self.current()
        return s is not None and self.choose_resume(s, edit=False)

    def on_edit_resume(self) -> bool:
        """e: let the user edit the resume command, then choose the session for resuming.

        Returns:
            True to leave the main loop (a session was chosen), else False.

        Example: current session a1, user edits to "claude --resume a1 --model opus" and presses
        Enter -> resume == the session, resume_override == ["claude", "--resume", "a1",
        "--model", "opus"], returns True; pressing Esc -> returns False.
        """
        s = self.current()
        return s is not None and self.choose_resume(s, edit=True)

    def on_copy(self) -> None:
        s = self.current()
        if s is not None:
            self.copy_resume_command(s)

    def copy_resume_command(self, s: Session) -> None:
        """Copy s's resume command to the clipboard, reporting the outcome in the status.

        Args:
            s: The session whose resume command to copy.

        Example: with pbcopy available -> status == " copied via pbcopy: cd /work/proj && claude
        --resume a1"; with no clipboard tool -> status == " no clipboard tool found
        (pbcopy/wl-copy/xclip/xsel)"
        """
        how = copy_clipboard(s.resume_cmd())
        self.status = (" copied via %s: %s" % (how, s.resume_cmd())) if how \
            else " no clipboard tool found (pbcopy/wl-copy/xclip/xsel)"

    def can_resume(self, s: Session) -> bool:
        """Resuming runs in the session's cwd; refuse (with a status message) if it is gone.

        Args:
            s: The session to check.

        Returns:
            True if s can be resumed (its cwd exists or is unset), else False.

        Examples: cwd exists (or is empty) -> True; cwd "/gone" missing -> False and
        status == " cwd no longer exists: /gone"
        """
        if s.cwd and not os.path.isdir(s.cwd):
            self.status = " cwd no longer exists: " + s.cwd
            return False
        return True

    def edit_resume_command(self, s: Session, redraw: bool = True) -> Optional[List[str]]:
        """Let the user edit the resume command line; return its argv, or None if cancelled.

        Args:
            s: The session whose resume command is edited.
            redraw: True (default) repaints the whole list each keystroke (the footer prompt is
                given App.draw as its redraw callback); the viewer passes False.

        Returns:
            The edited command as an argv list, or None if the user cancelled.

        Examples: the prompt starts as "claude --resume a1";
            user types " --model opus" and presses Enter -> ["claude", "--resume", "a1", "--model", "opus"]
            user presses Esc, or clears the line -> None and status == " resume cancelled"
            user enters an unbalanced quote -> status == " bad command: ..." and the prompt reopens
        """
        initial = " ".join(shell_quote(w) for w in s.resume_argv())
        while True:
            buf, ok = self.screen.prompt("resume: ", initial,
                                          redraw=self.draw if redraw else None)
            if not ok:
                self.status = " resume cancelled"
                return None
            try:
                argv = shlex.split(buf)
            except ValueError as e:
                self.status = " bad command: %s" % e
                initial = buf  # keep what was typed so it can be fixed
                continue
            if not argv:
                self.status = " resume cancelled"
                return None
            return argv

    def choose_resume(self, s: Session, edit: bool, redraw: bool = True) -> bool:
        """Choose s for resuming (what r / e do in the list and the viewer), optionally after
        letting the user edit the resume command.

        Args:
            s: The session to resume.
            edit: True to let the user edit the command line first (e); False to use it as is (r).
            redraw: Passed to edit_resume_command; the viewer passes False.

        Returns:
            True if s was chosen (self.resume is set, and self.resume_override if edited);
            False if its cwd is gone or the edit was cancelled (status explains why).

        Examples: edit=False, cwd exists -> resume == s, returns True;
            edit=True, user enters "claude --resume a1 --model opus" -> resume == s,
            resume_override == ["claude", "--resume", "a1", "--model", "opus"], returns True;
            edit=True and Esc -> returns False, status == " resume cancelled"
        """
        if not self.can_resume(s):
            return False
        if edit:
            argv = self.edit_resume_command(s, redraw)
            if argv is None:
                return False
            self.resume_override = argv
        self.resume = s
        return True

    def run(self) -> None:
        """Main loop: draw, read a key, dispatch. Returns on quit or when a resume is chosen.

        Example: keys "j", "j", "q" -> selection moves down twice, then run() returns; keys "r" on
        a resumable session -> sets self.resume and returns.
        """
        while True:
            self.draw()
            k = self.screen.key()
            self.status = ""  # status messages last for one keypress
            if k is None or k == "RESIZE":
                continue
            handler = self.keymap.get(k)
            if handler is not None and handler():
                return

    def filter_mode(self) -> None:
        """Prompt for the list filter ("/"), refiltering live as you type. Enter keeps the text;
        Esc clears the filter.

        Example: typing "fix" then Enter -> query == "fix" and the view only has matches;
        typing "fix" then Esc -> query == "" and the full list returns.
        """
        def live(b: str) -> None:
            self.filter.query = b
            self.refilter()
        buf, ok = self.screen.prompt("/", self.filter.query, live, redraw=self.draw)
        self.filter.query = buf if ok else ""  # Esc clears the filter rather than restoring it
        self.refilter()

    def viewer(self, s: Session) -> bool:
        """Open the full-screen viewer; True if a resume was chosen from it.

        Args:
            s: The session to show.

        Returns:
            True if a resume was chosen from the viewer, else False.
        """
        Viewer(self, s).run()
        return self.resume is not None


class Viewer(object):
    """Full-screen transcript viewer with search, opened from the list with Enter.

    Shares the App's window, colors and drawing helpers. Its t / u toggles change
    app.show_results / app.mine_only, which persist when you return to the list.
    The search query starts as the list filter but is local to the viewer.
    Its y and ? copy the resume command and show help, as in the list.
    Its r / e set app.resume (and app.resume_override) and leave the viewer, which
    then also ends the list's main loop.
    """

    def __init__(self, app: App, s: Session) -> None:
        """Load session s's transcript and set up scroll, search and render-cache state; the search
        query starts as the app's list filter.

        Args:
            app: The App whose window, colors and settings are shared.
            s: The session to show.

        Example: Viewer(app, s) with app.filter.query == "fix" -> .query == "fix", .offset == 0,
        .hit_index == -1, .msgs == INDEX.transcript(s)
        """
        self.app = app
        self.screen = app.screen
        self.session = s
        self.msgs = INDEX.transcript(s)
        self.query = app.filter.query
        self.offset = 0          # first visible line
        self.hit_index = -1      # current search hit (-1: none chosen yet)
        self.body_height = 1     # visible rows, set by draw()
        self.status = ""
        self.lines: List[Line] = []
        self.hits: List[int] = []
        # Re-render only when one of (width, results, mine, terms) changes.
        self._render_key: Optional[Tuple[Any, ...]] = None
        self.keymap = build_keymap(self, "viewer")

    # -- key handlers: True means "leave the viewer"
    def on_back(self) -> bool:
        return True

    def on_line_down(self) -> None:
        self.offset += 1

    def on_line_up(self) -> None:
        self.offset -= 1

    def on_page_down(self) -> None:
        self.offset += self.body_height - 1

    def on_page_up(self) -> None:
        self.offset -= self.body_height - 1

    def on_top(self) -> None:
        self.offset = 0

    def on_bottom(self) -> None:
        self.offset = len(self.lines)  # draw() clamps to the last page

    def on_toggle_results(self) -> None:
        self.app.show_results = not self.app.show_results

    def on_toggle_mine(self) -> None:
        self.app.mine_only = not self.app.mine_only

    def on_star(self) -> None:
        """*: star or unstar the open session and show the result in the viewer's footer.

        Example: unstarred session -> session.starred is True, status == " starred: Fix bug"
        and the title bar now starts with "* ".
        """
        self.app.toggle_star(self.session)
        self.take_app_status()

    def on_resume(self) -> bool:
        """r: choose this session for resuming and leave the viewer.

        Returns:
            True to leave the viewer (resume chosen), else False.

        Example: cwd exists -> app.resume == self.session and returns True; cwd gone -> returns
        False and the viewer footer shows " cwd no longer exists: /gone".
        """
        if not self.app.choose_resume(self.session, edit=False):
            self.take_app_status()
            return False
        return True

    def on_edit_resume(self) -> bool:
        """e: edit the resume command in the footer, then choose the session for resuming.

        Returns:
            True to leave the viewer (resume chosen), else False.

        Example: user edits to "claude --resume a1 --model opus" and presses Enter ->
        app.resume == self.session, app.resume_override == ["claude", "--resume", "a1",
        "--model", "opus"], returns True; Esc -> returns False with the status " resume cancelled".
        """
        if not self.app.choose_resume(self.session, edit=True, redraw=False):
            self.take_app_status()
            return False
        return True

    def on_copy(self) -> None:
        self.app.copy_resume_command(self.session)
        self.take_app_status()

    def on_help(self) -> None:
        self.screen.show_help()

    def take_app_status(self) -> None:
        """Show a status message the App's shared helpers left, in the viewer's footer.

        Example: app.status == " resume cancelled" -> self.status == " resume cancelled" and
        app.status == ""
        """
        self.status, self.app.status = self.app.status, ""

    def on_next_hit(self) -> None:
        self.goto_hit(1)

    def on_prev_hit(self) -> None:
        self.goto_hit(-1)

    def goto_hit(self, step: int) -> None:
        """Move to the next (step=1) or previous (step=-1) search hit, wrapping around, and scroll
        so the hit sits about a third of the way down the screen.

        Args:
            step: +1 for the next hit, -1 for the previous one.

        Example: hits [8, 20, 40], hit_index 2, body_height 30: goto_hit(1) -> hit_index == 0,
        offset == 0 (8 - 10 clamped); goto_hit(-1) from 1 -> hit_index == 0. With no hits: no change.
        """
        if self.hits:
            self.hit_index = (self.hit_index + step) % len(self.hits)
            self.offset = max(0, self.hits[self.hit_index] - self.body_height // 3)

    def on_search(self) -> None:
        """/: prompt for a search query in the footer; on Enter use it, restart hit navigation and
        force a re-render with the new terms; on Esc leave everything unchanged.

        Example: query "fix", user types "ing" and presses Enter -> query == "fixing",
        hit_index == -1.
        """
        buf, ok = self.screen.prompt("/", self.query)
        if ok:
            self.query = buf
            self.hit_index = -1
            self._render_key = None  # force a re-render with the new terms

    def handle_key(self, k: str) -> bool:
        handler = self.keymap.get(k)
        return handler is not None and bool(handler())

    # -- drawing
    def draw(self, h: int, w: int) -> None:
        """Draw one frame of the h x w viewer: re-render when width/toggles/terms changed, clamp the
        scroll, then paint the title bar (with "hit i/n"), transcript lines and footer (status or
        key hints plus scroll percentage).

        Args:
            h: Screen height in rows.
            w: Screen width in columns.

        Example: 40-line transcript, h=12 (10 body rows), query "bug" with 3 hits, offset 10 ->
        title bar " CC Fix bug  hit 1/3" (" CC * Fix bug ..." if starred), body shows lines 10-19, footer ends with "[50%]".
        """
        app = self.app
        terms = terms_of(self.query)
        render_key = (w, app.show_results, app.mine_only, tuple(terms))
        if render_key != self._render_key:
            self._render_key = render_key
            self.lines, start = render(self.session, self.msgs, w - 1, app.show_results,
                                       app.mine_only)
            self.hits = hit_lines(self.lines, start, terms)
            if self.hit_index >= len(self.hits):
                self.hit_index = -1
            if self.hits and self.hit_index < 0:
                self.hit_index = 0
                self.offset = max(0, self.hits[0] - h // 3)
        bh = self.body_height = h - 2
        self.offset = max(0, min(self.offset, max(0, len(self.lines) - bh)))
        pat = term_regex(terms)
        self.screen.scr.erase()
        self.screen.fill(0, self.screen.attrs["head"])
        title = clip(("* " if self.session.starred else "") + self.session.title, max(0, w - 40))
        hit_text = ("hit %d/%d" % (self.hit_index + 1, len(self.hits))) if self.hits else \
            ("no hits" if terms else "")
        self.screen.put(0, 0, clip(" %s %s  %s" % (SOURCES[self.session.source].tag, title, hit_text), w - 1),
                self.screen.attrs["head"])
        for i in range(bh):
            j = self.offset + i
            if j >= len(self.lines):
                break
            t, kind, spans = self.lines[j]
            self.screen.draw_line(1 + i, 0, t, w - 1, kind, pat, spans)
        self.screen.fill(h - 1, self.screen.attrs["head"])
        pct = 100 if len(self.lines) <= bh else int(100 * (self.offset + bh) / len(self.lines))
        foot = self.status or (" j/k scroll  spc/b page  g/G ends  / search  n/N hit  "
                               "t results  u mine  * star  r/e resume  y copy  ? help  q back  [%d%%]" % min(pct, 100))
        self.screen.put(h - 1, 0, clip(foot, w - 1), self.screen.attrs["head"])
        self.screen.scr.refresh()
        self.status = ""

    def run(self) -> None:
        """Viewer main loop: draw, read a key, dispatch until a handler asks to leave. A too-small
        terminal shows "too small" and waits for q / Esc / Ctrl-C.

        Example: keys "j", "j", "q" -> offset 2 and then run() returns; key "r" on a resumable
        session -> sets app.resume and returns.
        """
        app = self.app
        while True:
            h, w = self.screen.scr.getmaxyx()
            if h < 4 or w < 12:
                self.screen.scr.erase()
                self.screen.put(0, 0, "too small")
                self.screen.scr.refresh()
                if self.screen.key() in ("q", "ESC", "CTRL_C"):
                    return
                continue
            self.draw(h, w)
            k = self.screen.key()
            if k is None or k == "RESIZE":
                continue
            if self.handle_key(k):
                return


def browse(scr: Window, sessions: List[Session], query: str,
           source: str,
           background: Optional[Tuple[int, int, int]] = None) -> Tuple[Optional[Session], Optional[List[str]]]:
    """Run the interactive browser (called inside curses.wrapper).

    Returns (session chosen for resume or None, edited resume argv or None).

    Args:
        scr: The curses window.
        sessions: All sessions to browse.
        query: Initial filter text.
        source: Initial source filter: "all", "claude" or "codex".
        background: Terminal background (r, g, b) for the row stripe color, or None.

    Returns:
        A (session, argv) tuple: the session chosen for resume (None if the user quit) and the
        edited resume argv (None if the default command should be used).

    Example: browse(scr, sessions, "fix", "all") with keys "r" on session a1 -> (a1, None);
    with keys "q" -> (None, None).
    """
    scr.keypad(True)
    try:
        # Report left-button presses (not full clicks, which ncurses delays by mouseinterval)
        # so clicking a list row selects it immediately.
        curses.mousemask(curses.BUTTON1_PRESSED)
        curses.mouseinterval(0)
    except curses.error:
        pass  # no mouse support in this terminal; keys still work
    app = App(scr, sessions, query, source, background)
    app.run()
    return app.resume, app.resume_override


def run_tui(query: str, source: Optional[str] = None) -> int:
    """Run the interactive browser and, if a session was chosen, exec its resume command in the
    session's directory. Returns an exit code (it does not return after a successful exec).

    Args:
        query: Initial filter text.
        source: "claude", "codex" or None for both.

    Returns:
        The exit code: 0 normal, 2 not a terminal, 127 resume command not found, 130 Ctrl-C.

    Examples: not a terminal -> prints "interactive mode needs a terminal (try --list)" to
    stderr, returns 2; user quits with q -> 0; Ctrl-C -> 130; resume command not on PATH ->
    127; resume chosen -> execvp("claude", ["claude", "--resume", "a1"]) after chdir.
    """
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        sys.stderr.write("ai-sessions: interactive mode needs a terminal (try --list)\n")
        return 2
    sessions = INDEX.load(progress=True)
    # Ask the terminal for its background before curses starts (it would swallow the reply).
    background = None
    if not (os.environ.get("AI_SESSIONS_STRIPE") or "").strip():
        background = Theme.query_background()
    try:
        chosen, argv_override = curses.wrapper(browse, sessions, query, source or "all", background)
    except KeyboardInterrupt:
        return 130
    if chosen is not None:
        # The terminal is restored by now; replace this process with the resumed CLI,
        # started in the session's own directory (Claude finds sessions per cwd).
        if chosen.cwd and os.path.isdir(chosen.cwd):
            os.chdir(chosen.cwd)
        argv = argv_override or chosen.resume_argv()
        if not argv_override:
            warning = chosen.resume_warning()
            if warning:
                sys.stderr.write("ai-sessions: %s; using default\n" % warning)
        if not shutil.which(argv[0]):
            sys.stderr.write("ai-sessions: %s not found in PATH\n" % argv[0])
            return 127
        os.execvp(argv[0], argv)
    return 0


# ---------------------------------------------------------------- CLI

def cmd_list(sessions: List[Session], query: str, source: Optional[str],
             starred_only: bool = False) -> int:
    """Print matching sessions newest first, one tab-separated line each: date, source, id,
    project, title. Returns 0.

    Args:
        sessions: All sessions.
        query: Search terms; "" lists everything.
        source: "claude", "codex" or None for both.
        starred_only: True to list only starred sessions (the columns do not change).

    Returns:
        Exit code 0.

    Example: stdout gets "2025-03-01 10:00\\tclaude\\ta1\\tproj\\tFix bug\\n" for a1.
    """
    for s in SessionFilter(query, source or "all", starred_only=starred_only).apply(sessions):
        row = (fmt_ts(s.last_ts), s.source, s.id, s.project, s.title)
        sys.stdout.write("\t".join(one_line(c) for c in row) + "\n")
    return 0


def find_session(sessions: List[Session], ident: str) -> Tuple[Optional[Session], Optional[str]]:
    """Find the session whose id equals ident, or else the one whose id starts with ident.

    Args:
        sessions: All sessions.
        ident: A session id or a unique prefix of one.

    Returns:
        (session, None) on a unique match, else (None, message) where message is the complete
        stderr text (newline-terminated; for an ambiguous prefix it also lists the candidates).

    Examples: ids a1, a2: find_session(ss, "a1") -> (<a1>, None);
    find_session(ss, "zz") -> (None, "ai-sessions: no session matches 'zz'\\n");
    find_session(ss, "a") -> (None, "ai-sessions: 'a' is ambiguous:\\n  claude a1 Title\\n  ...\\n")
    """
    ms = [s for s in sessions if s.id == ident] or [s for s in sessions if s.id.startswith(ident)]
    if not ms:
        return None, "ai-sessions: no session matches %r\n" % ident
    if len(ms) > 1:
        msg = "ai-sessions: %r is ambiguous:\n" % ident
        for s in ms:
            msg += "  %s %s %s\n" % (s.source, s.id, s.title)
        return None, msg
    return ms[0], None


def current_session_id(source: Optional[str], env: Optional[Dict[str, str]] = None) -> Optional[str]:
    """The id of the Claude Code / Codex session this process is running inside, if any.

    CODEX_THREAD_ID is checked before CLAUDE_CODE_SESSION_ID, because Codex is more likely to
    be nested inside Claude Code than the other way round.

    Args:
        source: "claude" (only CLAUDE_CODE_SESSION_ID), "codex" (only CODEX_THREAD_ID) or None (both).
        env: Environment mapping to read; defaults to os.environ.

    Returns:
        The id, or None if no matching variable is set (or it is empty).

    Examples: env {"CODEX_THREAD_ID": "x", "CLAUDE_CODE_SESSION_ID": "y"} -> "x";
    same env with source "claude" -> "y"; empty env -> None
    """
    if env is None:
        env = dict(os.environ)
    # Codex is checked first (see above); an unrecognized source means "both".
    for src in (SOURCES["codex"], SOURCES["claude"]):
        if (source not in SOURCES or source == src.key) and env.get(src.session_env_var):
            return env[src.session_env_var]
    return None


def cmd_star(sessions: List[Session], ident: Optional[str], on: Optional[bool],
             source: Optional[str], env: Optional[Dict[str, str]] = None) -> int:
    """Star (on=True), unstar (on=False) or just report (on=None) a session's star, printing
    one line: "starred ...", "unstarred ..." or, for a report, "starred ..." / "not starred ...".

    With ident None the session comes from the environment (current_session_id); that id is
    exact and is stored even if no loaded session has it (e.g. a brand-new session whose
    transcript is not written yet). An explicit ident must resolve via find_session.

    Args:
        sessions: All sessions (already restricted to source, if given).
        ident: A session id or unique prefix, or None to use the current session.
        on: True to star, False to unstar, None to only report whether it is starred.
        source: "claude", "codex" or None; limits which environment variable is read.
        env: Environment mapping for current_session_id; defaults to os.environ.

    Returns:
        Exit code: 0 on success, 1 if ident matches nothing / is ambiguous or stars.json cannot
        be written, 2 if no ident was given and no session id is in the environment.

    Examples: cmd_star(ss, "a1", True, None) -> prints "starred claude a1-full-id Fix bug", 0;
    cmd_star(ss, None, False, None) inside Claude Code -> "unstarred claude <id> <title>", 0
    (or "unstarred <id>" if that id is not among the sessions); outside any session -> 2;
    cmd_star(ss, "a1", None, None) -> prints "not starred claude a1-full-id Fix bug", 0
    """
    found: Optional[Session]
    if ident is None:
        sid = current_session_id(source, env)
        if sid is None:
            sys.stderr.write("ai-sessions: no session id given and not running inside "
                             "Claude Code or Codex\n")
            return 2
        found = next((s for s in sessions if s.id == sid), None)
    else:
        found, err = find_session(sessions, ident)
        if found is None:
            sys.stderr.write(err or "")
            return 1
        sid = found.id
    if on is None:
        word = "starred" if sid in STARS.read() else "not starred"
    else:
        try:
            STARS.set(sid, on)
        except OSError as e:
            sys.stderr.write("ai-sessions: cannot save stars to %s: %s\n" % (STARS.path(), e))
            return 1
        word = "starred" if on else "unstarred"
    if found is None:
        sys.stdout.write("%s %s\n" % (word, sid))
    else:
        sys.stdout.write("%s %s %s %s\n" % (word, found.source, found.id, one_line(found.title)))
    return 0


def cmd_show(sessions: List[Session], ident: str, tools: bool, mine_only: bool = False) -> int:
    """Print the transcript of the session whose id equals ident or starts with it, as plain text:
    the same rows the browser shows (assistant replies as laid-out Markdown with the markers
    removed, tables box-drawn), with the inline styles dropped. Returns 0; 1 (with a message on stderr) if nothing matches or the prefix is ambiguous.

    Args:
        sessions: All sessions.
        ident: A session id or a unique prefix of one.
        tools: True to include tool results.
        mine_only: True to show only your own input (default False).

    Returns:
        Exit code: 0 on success, 1 if no session or several sessions match.

    Examples: cmd_show(sessions, "a1", False) -> prints the 100-column transcript, returns 0;
    cmd_show(sessions, "zz", False) -> "ai-sessions: no session matches 'zz'", returns 1;
    cmd_show(sessions, "a", False) with ids a1 and a2 -> lists both as ambiguous, returns 1.
    """
    s, err = find_session(sessions, ident)
    if s is None:
        sys.stderr.write(err or "")
        return 1
    lines, _ = render(s, INDEX.transcript(s), 100, tools, mine_only)
    sys.stdout.write("\n".join(t for t, _, _ in lines) + "\n")
    return 0


def build_arg_parser() -> argparse.ArgumentParser:
    """Build the command-line parser for ai-sessions.

    Returns:
        The ArgumentParser with the query, --list, --starred, --search, --source, --show, --star,
        --unstar, --star-status, --tools, --mine, --claude-cmd and --codex-cmd options.

    Example: build_arg_parser().parse_args(["--list", "fix"]).query -> ["fix"]
    """
    ap = argparse.ArgumentParser(
        prog="ai-sessions",
        description="Browse and search Claude Code and Codex CLI session transcripts. "
                    "With no --list/--show, launches a curses browser (? for keys).")
    ap.add_argument("query", nargs="*", help="initial filter (TUI) or search terms (with --list)")
    ap.add_argument("--list", action="store_true",
                    help="print tab-separated rows: date, source, id, project, title")
    ap.add_argument("--search", metavar="QUERY", help="with --list: only sessions matching QUERY")
    ap.add_argument("--source", choices=tuple(s.key for s in SOURCE_LIST), help="restrict to one source")
    ap.add_argument("--show", metavar="ID", help="print a transcript (id or unique prefix)")
    ap.add_argument("--starred", action="store_true", help="with --list: only starred sessions")
    star = ap.add_mutually_exclusive_group()
    star.add_argument("--star", metavar="ID", nargs="?", const="",
                      help="star a session (id or unique prefix); without ID, the session "
                           "this runs inside ($CODEX_THREAD_ID / $CLAUDE_CODE_SESSION_ID)")
    star.add_argument("--unstar", metavar="ID", nargs="?", const="",
                      help="unstar a session; ID as for --star")
    star.add_argument("--star-status", metavar="ID", nargs="?", const="",
                      help="print whether a session is starred ('starred ...' or "
                           "'not starred ...'); ID as for --star")
    ap.add_argument("--tools", action="store_true", help="with --show: include tool results")
    ap.add_argument("--mine", action="store_true",
                    help="with --show: only your input (prompts and slash commands)")
    ap.add_argument("--claude-cmd", metavar="CMD",
                    help="command to resume Claude sessions (default: $AI_SESSIONS_CLAUDE_CMD or "
                         "'claude'); {id} is replaced by the session id, else '--resume ID' is appended")
    ap.add_argument("--codex-cmd", metavar="CMD",
                    help="command to resume Codex sessions (default: $AI_SESSIONS_CODEX_CMD or "
                         "'codex'); {id} is replaced by the session id, else 'resume ID' is appended")
    return ap


def main() -> int:
    """Command-line entry point: parse arguments, then --list, --show, --star/--unstar or the TUI. Returns the
    process exit code.

    Returns:
        The process exit code.

    Examples: `ai-sessions --list fix` -> tab-separated rows of sessions matching "fix", 0;
    `ai-sessions --show a1b2 --tools` -> that transcript including tool results, 0;
    `ai-sessions --star a1b2` -> "starred claude a1b2... Title", 0;
    `ai-sessions --star-status a1b2` -> "starred ..." or "not starred claude a1b2... Title", 0;
    `ai-sessions` -> curses browser; `ai-sessions --list | head -1` exits 0 on a closed pipe.
    """
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    ap = build_arg_parser()
    args = ap.parse_args()
    if args.claude_cmd:
        SOURCES["claude"].cmd_override = args.claude_cmd
    if args.codex_cmd:
        SOURCES["codex"].cmd_override = args.codex_cmd
    stream: Any
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="replace")
        except (AttributeError, ValueError):
            pass
    q = " ".join(([args.search] if args.search else []) + args.query)
    # (flag value, action for cmd_star): True star, False unstar, None report
    star_ops = [(v, on) for v, on in ((args.star, True), (args.unstar, False),
                                      (args.star_status, None)) if v is not None]
    if star_ops and (args.list or args.show):
        ap.error("--star/--unstar/--star-status cannot be combined with --list or --show")
    if args.starred and not args.list:
        ap.error("--starred requires --list")
    if star_ops:
        sessions = INDEX.load()
        if args.source:
            sessions = [s for s in sessions if s.source == args.source]
        ident, on = star_ops[0]
        return cmd_star(sessions, ident or None, on, args.source)
    if args.list or args.show:
        sessions = INDEX.load()
        if args.source:
            sessions = [s for s in sessions if s.source == args.source]
        try:
            if args.show:
                return cmd_show(sessions, args.show, args.tools, args.mine)
            return cmd_list(sessions, q, args.source, args.starred)
        except BrokenPipeError:
            try:
                sys.stdout = None
            except Exception:
                pass
            return 0
    return run_tui(q, args.source)


if __name__ == "__main__":
    sys.exit(main())
