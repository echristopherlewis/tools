#!/usr/bin/env python3
"""ai-sessions: browse and search Claude Code and Codex CLI session transcripts.

Interactive (curses) by default; --list and --show are plain-text, scriptable.
--star / --unstar mark sessions as favorites and --star-status reports it; without an
ID they act on the session they are run from inside (see CODEX_THREAD_ID / CLAUDE_CODE_SESSION_ID below).
Standard library only; works on Python 3.6+.

Environment:
  AI_SESSIONS_CLAUDE_DIR  Claude Code projects dir (default ~/.claude/projects)
  AI_SESSIONS_CODEX_DIR   Codex home dir          (default ~/.codex)
  AI_SESSIONS_CLAUDE_CMD  command used to resume Claude sessions (default "claude")
  AI_SESSIONS_CODEX_CMD   command used to resume Codex sessions  (default "codex")
                          A word containing {id} gets the session id substituted;
                          otherwise the default resume args are appended
                          (claude: --resume ID, codex: resume ID). Examples:
                            claude --dangerously-skip-permissions --model opus
                            codex resume {id} --yolo
                          --claude-cmd / --codex-cmd override these.
  AI_SESSIONS_STRIPE      background color (0-255) of every other session-list row,
                          or "off" (default: a grey just off the terminal background as
                          reported by the terminal (OSC 11), else 236, or 255 if COLORFGBG
                          says the background is light; 256-color terminals only)
  AI_SESSIONS_THEME       "claude" (default): Claude Code's 256-color palette, light or dark to
                          match the terminal background (OSC 11, else COLORFGBG); "basic": the
                          original 8-color look. Terminals with fewer than 256 colors always
                          use basic.
  XDG_CACHE_HOME          cache root (index in $XDG_CACHE_HOME/ai-sessions/index.json)
  XDG_DATA_HOME           data root (stars in $XDG_DATA_HOME/ai-sessions/stars.json;
                          default ~/.local/share)
  CODEX_THREAD_ID         set by Codex; the session that --star / --unstar / --star-status act on
                          when given no ID (checked first)
  CLAUDE_CODE_SESSION_ID  set by Claude Code; same, checked second
"""

import argparse
