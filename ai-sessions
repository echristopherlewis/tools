class App(object):
    def __init__(self, scr: Window, sessions: List[Session], query: str,
                 source: str = "all") -> None:
        """Set up UI state (filter, sort, selection, scroll, caches), colors, the filtered view
        and the key map. scr is the curses window; query/source are the initial filter.

        Args:
            scr: The curses window.
            sessions: All sessions to browse.
            query: Initial filter text.
            source: Initial source filter: "all" (default), "claude" or "codex".

        Example: App(scr, sessions, "fix", "claude") -> .view holds the Claude sessions matching
        "fix", newest first; .sel == 0; .sort == "last"; .split is None (layout chosen by width)
        """
        self.scr = scr
        self.all = sessions
        self.query = query
        self.source = source
        self.project: Optional[str] = None
        self.sort = "last"
        self.show_results = False
        self.mine_only = False
        self.split: Optional[str] = None  # "side" / "stack"; None: by terminal width
        self.sel = 0
        self.top = 0
        self.preview_offset = 0
        self.status = ""
        self.resume: Optional[Session] = None
        self.resume_override: Optional[List[str]] = None
        self.view: List[Session] = []
        self._preview_cache_key: Optional[Tuple[Any, ...]] = None
        self._preview_cache: Tuple[List[Line], int, List[int]] = ([], 0, [])
        self._preview_scroll_key: Optional[Tuple[Any, ...]] = None
        self.attrs: Dict[str, int] = {}
        self.init_colors()
        self.refilter()
        self.keymap = self.build_keymap()

    # -- setup
    def init_colors(self) -> None:
        """Fill self.attrs (name -> curses attribute) and hide the cursor. Uses color pairs when the
        terminal has colors; otherwise (or on curses errors) it keeps the bold/dim/reverse fallbacks.

        Example: on a color terminal -> self.attrs["cc"] == color_pair(1) | A_BOLD;
        on a monochrome one -> self.attrs["cc"] == A_BOLD and self.attrs["hl"] == A_REVERSE | A_BOLD
        """
        attrs: Dict[str, int] = {"plain": 0, "dim": curses.A_DIM, "bold": curses.A_BOLD, "rev": curses.A_REVERSE,
             "cc": curses.A_BOLD, "cx": curses.A_UNDERLINE, "user": curses.A_BOLD,
             "asst": curses.A_BOLD, "hl": curses.A_REVERSE | curses.A_BOLD,
             "title": curses.A_BOLD, "tool": curses.A_DIM, "result": curses.A_DIM,
             "meta": 0, "head": curses.A_REVERSE}
        try:
            if curses.has_colors():
                curses.start_color()
                try:
                    curses.use_default_colors()
                    bg = -1
                except curses.error:
                    bg = curses.COLOR_BLACK
                # (pair number, foreground, background); numbers match the color_pair() uses below.
                pairs = [(1, curses.COLOR_GREEN, bg), (2, curses.COLOR_MAGENTA, bg),
                         (3, curses.COLOR_GREEN, bg), (4, curses.COLOR_CYAN, bg),
                         (5, curses.COLOR_BLACK, curses.COLOR_YELLOW),
                         (6, curses.COLOR_YELLOW, bg), (7, curses.COLOR_WHITE, curses.COLOR_BLUE)]
                for n, f, b in pairs:
                    curses.init_pair(n, f, b)
                attrs["cc"] = curses.color_pair(1) | curses.A_BOLD
                attrs["cx"] = curses.color_pair(2) | curses.A_BOLD
                attrs["user"] = curses.color_pair(3) | curses.A_BOLD
                attrs["asst"] = curses.color_pair(4) | curses.A_BOLD
                attrs["hl"] = curses.color_pair(5)
                attrs["title"] = curses.A_BOLD
                attrs["tool"] = curses.color_pair(6)
                attrs["result"] = curses.A_DIM
                attrs["head"] = curses.color_pair(7) | curses.A_BOLD
        except curses.error:
            pass
        self.attrs = attrs
        try:
            curses.curs_set(0)
        except curses.error:
            pass

    # -- drawing primitives
    def put(self, y: int, x: int, s: str, attr: int = 0) -> None:
        """Write s at row y, column x with attr, ignoring curses errors (e.g. off-screen writes).

        Args:
            y: Row.
            x: Column.
            s: Text to write.
            attr: curses attribute (default 0, plain).

        Example: put(0, 0, "hi", A_BOLD) draws "hi" at the top-left; put(99, 0, "hi") on a 24-row
        screen draws nothing and does not raise.
        """
        try:
            self.scr.addstr(y, x, s, attr)
        except curses.error:
            pass

    def text(self, y: int, x: int, s: str, maxw: int, attr: int,
             pat: Optional[Pattern[str]] = None) -> None:
        """Draw s at (y, x): sanitized, newlines flattened, clipped to maxw columns, with matches of
        pat drawn in the highlight attribute.

        Args:
            y: Row.
            x: Column.
            s: Text to draw.
            maxw: Maximum width in columns; nothing is drawn if <= 0.
            attr: curses attribute for the normal text.
            pat: Compiled regex whose matches are highlighted, or None for no highlighting.

        Example: text(3, 0, "fix the bug", 20, 0, re.compile("bug", re.I)) draws "fix the " plain
        at column 0 and "bug" highlighted at column 8; with maxw=5 it draws only "fix t".
        """
        s = clip(clean(s).replace("\n", " "), maxw)
        if not s or maxw <= 0:
            return
        if pat is None:
            self.put(y, x, s, attr)
            return
        pos = 0
        for m in pat.finditer(s):
            if m.start() > pos:
                self.put(y, x + str_width(s[:pos]), s[pos:m.start()], attr)
            self.put(y, x + str_width(s[:m.start()]), m.group(0), self.attrs["hl"])
            pos = m.end()
        if pos < len(s):
            self.put(y, x + str_width(s[:pos]), s[pos:], attr)

    def fill(self, y: int, attr: int) -> None:
        """Paint row y with attr across the full width (for the header/footer bars).

        Args:
            y: Row to paint.
            attr: curses attribute to paint with.

        Example: on an 80x24 screen, fill(23, attrs["head"]) paints all 80 cells of the last row
        with spaces in the header attribute.
        """
        h, w = self.scr.getmaxyx()
        self.put(y, 0, " " * (w - 1), attr)
        # addstr into the bottom-right cell raises (the cursor cannot advance past it),
        # so the last column is written with addch; the error it may also raise is
        # harmless because the cell has already been drawn.
        try:
            self.scr.addch(y, w - 1, " ", attr)
        except curses.error:
            pass

    # -- state
    def refilter(self, keep: bool = True) -> None:
        """Recompute self.view from the query/source/project filters and the sort mode, reset the
        scroll, and (when keep is true) keep the same session selected if it is still listed.

        Args:
            keep: If True (default), keep the currently selected session selected when it is still
                in the new view; otherwise select the first row.

        Example: view [A, B, C] with C selected (sel == 2), then query "c" leaves [C] ->
        view == [C], sel == 0; with keep=False after a filter change -> sel == 0.
        """
        cur = self.view[self.sel].path if (keep and self.view and self.sel < len(self.view)) else None
        v = filter_sessions(self.all, self.query, self.source, self.project)
        self.view = sort_sessions(v, self.sort)
        self.sel = 0
        if cur:
            for i, s in enumerate(self.view):
                if s.path == cur:
                    self.sel = i
                    break
        self.top = 0

    def current(self) -> Optional[Session]:
        return self.view[self.sel] if self.view and 0 <= self.sel < len(self.view) else None

    def filter_desc(self) -> str:
        """Human-readable summary of the active filters for the header bar.

        Returns:
            Text such as "source=Codex project=proj /fix", or "none".

        Examples:
            no filters -> "none"
            source "claude", project "/work/proj", query "fix" -> "source=Claude Code project=proj /fix"
        """
        parts: List[str] = []
        if self.source != "all":
            parts.append("source=" + LABEL[self.source])
        if self.project is not None:
            parts.append("project=" + (os.path.basename(self.project.rstrip("/")) or "-"))
        if self.query:
            parts.append("/" + self.query)
        return " ".join(parts) if parts else "none"

    # -- key input
    def key(self) -> Optional[str]:
        """Read one key and return its name: printable keys as themselves; special keys as names
        ("ENTER", "ESC", "BS", "CU", "TAB", "CTRL_C", "UP", "DOWN", "PGUP", "PGDN", "HOME", "END",
        "SUP", "SDOWN", "RESIZE"); unmapped special keys as "UNKNOWN"; None if nothing arrived.

        Returns:
            A key name (a printable character or a name from the list above), or None if no key
            arrived.

        Examples: pressing j -> "j"; pressing Enter -> "ENTER"; pressing F5 -> "UNKNOWN";
        Ctrl-U -> "CU"; read timeout -> None
        """
        try:
            k = self.scr.get_wch()
        except KeyboardInterrupt:
            return "CTRL_C"
        except curses.error:
            return None
        if isinstance(k, str):
            return {"\n": "ENTER", "\r": "ENTER", "\x1b": "ESC", "\x7f": "BS", "\b": "BS",
                    "\x15": "CU", "\t": "TAB", "\x03": "CTRL_C"}.get(k, k)
        names: Dict[int, str] = {curses.KEY_UP: "UP", curses.KEY_DOWN: "DOWN", curses.KEY_PPAGE: "PGUP",
                 curses.KEY_NPAGE: "PGDN", curses.KEY_HOME: "HOME", curses.KEY_END: "END",
                 curses.KEY_RESIZE: "RESIZE", curses.KEY_BACKSPACE: "BS", curses.KEY_ENTER: "ENTER",
                 }
        for nm, val in (("KEY_SR", "SUP"), ("KEY_SF", "SDOWN"), ("KEY_BTAB", "TAB")):
            if hasattr(curses, nm):
                names[getattr(curses, nm)] = val
        # Unmapped special keys (F-keys etc.) get a name no keymap binds, so they are
        # ignored; they must not collide with a printable key such as "?" (help).
        return names.get(k, "UNKNOWN")

    def edit(self, buf: str, k: Optional[str]) -> Tuple[str, Optional[str]]:
        """Apply a line-edit key to buf; return (new, done) where done in (None,'ok','cancel').

        Args:
            buf: The text being edited.
            k: A key name from key(), or None.

        Returns:
            A (new_buf, done) tuple: new_buf is the edited text; done is "ok" after Enter, "cancel"
            after Esc or Ctrl-C, else None.

        Examples:
            edit("ab", "c") -> ("abc", None)
            edit("ab", "BS") -> ("a", None)
            edit("ab", "CU") -> ("", None)
            edit("ab", "ENTER") -> ("ab", "ok")
            edit("ab", "ESC") -> ("ab", "cancel")
            edit("ab", "UP") -> ("ab", None)   (non-printable keys are ignored)
        """
        if k == "ENTER":
            return buf, "ok"
        if k == "ESC" or k == "CTRL_C":
            return buf, "cancel"
        if k == "BS":
            return buf[:-1], None
        if k == "CU":
            return "", None
        if isinstance(k, str) and len(k) == 1 and k.isprintable():
            return buf + k, None
        return buf, None

    # -- layout
    def layout(self) -> Dict[str, Any]:
        """Compute screen regions for the list and preview. Returns {"mode": "side" | "stack",
        "list": Box, "prev": Box, "sep": column (side) or row (stack) of the separator}.
        Mode is self.split, else "side" when the terminal is at least SIDE_BY_SIDE_MIN_COLS wide.

        Returns:
            A dict with "mode" ("side" or "stack"), "list" and "prev" (Box regions) and "sep"
            (separator column or row).

        Examples:
            120 cols x 40 rows -> {"mode": "side", "list": (1, 0, 38, 54),
                                   "prev": (1, 55, 38, 65), "sep": 54}
            80 cols x 24 rows -> {"mode": "stack", "list": (1, 0, 11, 80),
                                  "prev": (13, 0, 10, 80), "sep": 12}
        """
        h, w = self.scr.getmaxyx()
        body_top, body_bot = 1, h - 2  # inclusive rows
        bh = body_bot - body_top + 1
        mode = self.split or ("side" if w >= SIDE_BY_SIDE_MIN_COLS else "stack")
        if mode == "side":
            lw = int(w * 0.45)
            return {"mode": "side", "list": (body_top, 0, bh, lw),
                    "prev": (body_top, lw + 1, bh, w - lw - 1), "sep": lw}
        lh = max(3, bh // 2)
        return {"mode": "stack", "list": (body_top, 0, lh, w),
                "prev": (body_top + lh + 1, 0, bh - lh - 1, w), "sep": body_top + lh}

    def draw(self) -> None:
        """Repaint the whole list view: header bar (counts, filter, sort), session list, separator,
        preview, and footer (status message or key hints).

        Example: 3 of 10 sessions match "fix" on a 100x30 screen -> the top row reads
        " ai-sessions  3/10 sessions  filter: /fix  sort: last activity", the footer shows the
        key hints (or self.status if set); a screen under 24x6 shows only "terminal too small".
        """
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 6 or w < 24:
            self.put(0, 0, clip("terminal too small", max(w - 1, 1)))
            scr.refresh()
            return
        pat = term_regex(terms_of(self.query))
        total = len(self.all)
        self.fill(0, self.attrs["head"])
        hdr = " ai-sessions  %d/%d sessions  filter: %s  sort: %s%s" % (
            len(self.view), total, self.filter_desc(),
            "last activity" if self.sort == "last" else "start time",
            "  [results]" if self.show_results else "") + ("  [mine]" if self.mine_only else "")
        self.put(0, 0, clip(hdr, w - 1), self.attrs["head"])
        lay = self.layout()
        self.draw_list(lay["list"], pat)
        hz, vt = rule_chars()
        if lay["mode"] == "side":
            for y in range(1, h - 1):
                self.put(y, lay["sep"], vt, self.attrs["dim"])
        else:
            self.put(lay["sep"], 0, hz * (w - 1), self.attrs["dim"])
        self.draw_preview(lay["prev"], pat)
        self.fill(h - 1, self.attrs["head"])
        foot = self.status or (" j/k move  / filter  Tab source  p project  s sort  t results  u mine  "
                               "Enter view  r resume  e edit+resume  y copy  R rescan  ? help  q quit")
        self.put(h - 1, 0, clip(foot, w - 1), self.attrs["head"])
        scr.refresh()

    def draw_list(self, box: Box, pat: Optional[Pattern[str]]) -> None:
        """Draw the session rows into box, scrolling so the selection stays visible. Each row is
        "date  tag  project  title", with the selected row in reverse video and filter matches
        highlighted.

        Args:
            box: The (y, x, height, width) region to draw in.
            pat: Regex for highlighting filter matches, or None.

        Example: row for a Claude session -> "2025-03-01 10:00 CC proj   Fix the bug"; with no
        matching sessions the first row reads "(no matching sessions)".
        """
        y0, x0, bh, bw = box
        if bw < 20 or bh < 1:
            return
        if self.sel < self.top:
            self.top = self.sel
        if self.sel >= self.top + bh:
            self.top = self.sel - bh + 1
        if not self.view:
            self.put(y0, x0, clip("(no matching sessions)", bw - 1), self.attrs["dim"])
            return
        projw = min(14, max(6, bw // 6))
        for i in range(bh):
            idx = self.top + i
            if idx >= len(self.view):
                break
            s = self.view[idx]
            y = y0 + i
            cur = idx == self.sel
            extra = curses.A_REVERSE if cur else 0
            if cur:
                self.put(y, x0, " " * (bw - 1), extra)
            x = x0
            self.put(y, x, fmt_ts(s.last_ts if self.sort == "last" else s.first_ts), extra | self.attrs["dim"])
            x += DATE_COL_WIDTH
            self.put(y, x, TAG[s.source], extra | self.attrs["cc" if s.source == "claude" else "cx"])
            x += TAG_COL_WIDTH
            self.text(y, x, pad(s.project, projw), projw, extra, pat)
            x += projw + 1
            self.text(y, x, s.title, bw - 1 - (x - x0), extra, pat)

    def preview_lines(self, s: Session, width: int,
                      pat_terms: List[str]) -> Tuple[List[Line], int, List[int]]:
        """Rendered preview for s at width, as (lines, body_start, hit_indexes). Cached until the
        session, its last_ts, width, toggles or terms change.

        Args:
            s: The session to preview.
            width: Display width in columns.
            pat_terms: Lowercase filter terms used to find hits.

        Returns:
            A (lines, body_start, hit_indexes) tuple, as from render() and hit_lines().

        Example: preview_lines(s, 60, ["bug"]) -> ([("Fix bug", "title"), ...], 6, [8]);
        a second identical call returns the very same cached tuple.
        """
        key = (s.path, s.last_ts, width, self.show_results, self.mine_only, tuple(pat_terms))
        if self._preview_cache_key == key:
            return self._preview_cache
        msgs = get_transcript(s)
        lines, start = render(s, msgs, width, self.show_results, self.mine_only)
        hits = hit_lines(lines, start, pat_terms)
        self._preview_cache_key = key
        self._preview_cache = (lines, start, hits)
        return self._preview_cache

    def draw_preview(self, box: Box, pat: Optional[Pattern[str]]) -> None:
        """Draw the preview of the selected session into box. Scroll jumps to just before the first
        filter hit when the selection or filter changes, and is otherwise clamped to the content.

        Args:
            box: The (y, x, height, width) region to draw in.
            pat: Regex for highlighting filter matches, or None.

        Example: selected session with a match on rendered line 20 for query "bug" -> preview_offset
        becomes 18 (hit - 2) and lines 18.. are drawn; with no session selected nothing is drawn.
        """
        y0, x0, bh, bw = box
        s = self.current()
        if s is None or bh < 1 or bw < 12:
            return
        terms = terms_of(self.query)
        lines, start, hits = self.preview_lines(s, bw - 1, terms)
        selkey = (s.path, tuple(terms), self.show_results, self.mine_only)
        if selkey != self._preview_scroll_key:
            self._preview_scroll_key = selkey
            self.preview_offset = max(0, hits[0] - 2) if hits else 0
        self.preview_offset = max(0, min(self.preview_offset, max(0, len(lines) - bh)))
        for i in range(bh):
            j = self.preview_offset + i
            if j >= len(lines):
                break
            t, kind = lines[j]
            self.text(y0 + i, x0, t, bw - 1, self.attrs.get(kind, 0), pat)

    # -- actions
    def move(self, d: int) -> None:
        if self.view:
            self.sel = max(0, min(len(self.view) - 1, self.sel + d))

    def list_height(self) -> int:
        return max(1, self.layout()["list"][2])

    def preview_height(self) -> int:
        return max(1, self.layout()["prev"][2])

    # -- key handlers: each returns True to leave the main loop (quit / resume chosen)
    def on_quit(self) -> bool:
        return True

    def on_help(self) -> None:
        self.help()

    def on_down(self) -> None:
        self.move(1)

    def on_up(self) -> None:
        self.move(-1)

    def on_page_down(self) -> None:
        self.move(self.list_height() - 1)

    def on_page_up(self) -> None:
        self.move(-(self.list_height() - 1))

    def on_first(self) -> None:
        self.sel = 0

    def on_last(self) -> None:
        self.sel = max(0, len(self.view) - 1)

    def on_preview_down(self) -> None:
        self.preview_offset += max(1, self.preview_height() // 2)

    def on_preview_up(self) -> None:
        self.preview_offset = max(0, self.preview_offset - max(1, self.preview_height() // 2))

    def on_filter(self) -> None:
        self.filter_mode()

    def on_clear_filter(self) -> None:
        """Esc in the list: drop the text filter and refilter; does nothing if there is none.

        Example: query "fix" -> query == "" and the view shows all sessions again.
        """
        if self.query:
            self.query = ""
            self.refilter()

    def on_cycle_source(self) -> None:
        """Tab: cycle the source filter all -> claude -> codex -> all, then refilter.

        Example: source "claude" -> source "codex"; source "codex" -> "all"
        """
        order = ["all", "claude", "codex"]
        self.source = order[(order.index(self.source) + 1) % len(order)]
        self.refilter()

    def on_toggle_project(self) -> None:
        """Restrict the list to the selected session's project (its cwd), or clear that restriction.

        Example: project None with a selected session in /work/proj -> project == "/work/proj";
        pressed again -> project is None. A selected session with no cwd leaves project None.
        """
        s = self.current()
        if self.project is not None:
            self.project = None
        elif s is not None and s.cwd:
            self.project = s.cwd
        self.refilter()

    def on_toggle_sort(self) -> None:
        """Switch the sort mode between last activity and start time, then refilter.

        Example: sort "last" -> sort "start" -> sort "last"
        """
        self.sort = "start" if self.sort == "last" else "last"
        self.refilter()

    def on_toggle_split(self) -> None:
        """Flip between side-by-side and stacked layouts (relative to the layout in effect now).

        Example: on a 120-column terminal with split None -> split == "stack" and
        status == " layout: list above preview"
        """
        self.split = "stack" if self.layout()["mode"] == "side" else "side"
        self.status = " layout: %s" % ("list beside preview" if self.split == "side"
                                       else "list above preview")

    def on_toggle_results(self) -> None:
        """Toggle display of tool results in transcripts and say so in the status line.

        Example: show_results False -> True and status == " tool results shown"
        """
        self.show_results = not self.show_results
        self.status = " tool results %s" % ("shown" if self.show_results else "hidden")

    def on_toggle_mine(self) -> None:
        """Toggle showing only your own input (prompts and slash commands) and update the status line.

        Example: mine_only False -> True and status == " showing only your input"
        """
        self.mine_only = not self.mine_only
        self.status = " showing %s" % ("only your input" if self.mine_only else "full transcript")

    def on_rescan(self) -> None:
        """Reload all sessions from disk (picking up new or changed transcripts) and refilter.

        Example: after a new transcript appears, on_rescan() -> len(self.all) grows by 1 and
        status == " rescanned: 11 sessions"
        """
        self.all = load_sessions()
        self.refilter()
        self.status = " rescanned: %d sessions" % len(self.all)

    def on_open(self) -> bool:
        s = self.current()
        return s is not None and self.viewer(s)

    def on_resume(self) -> bool:
        """r: choose the current session for resuming and leave the main loop.

        Returns:
            True to leave the main loop (a session was chosen), else False.

        Example: with a session selected whose cwd exists -> resume == that session, returns True;
        with an empty list or a vanished cwd -> returns False (status explains why).
        """
        s = self.current()
        if s is None or not self.can_resume(s):
            return False
        self.resume = s
        return True

    def on_edit_resume(self) -> bool:
        """e: let the user edit the resume command, then choose the session for resuming.

        Returns:
            True to leave the main loop (a session was chosen), else False.

        Example: current session a1, user edits to "claude --resume a1 --model opus" and presses
        Enter -> resume == the session, resume_override == ["claude", "--resume", "a1",
        "--model", "opus"], returns True; pressing Esc -> returns False.
        """
        s = self.current()
        if s is None or not self.can_resume(s):
            return False
        argv = self.edit_resume_command(s)
        if argv is None:
            return False
        self.resume = s
        self.resume_override = argv
        return True

    def on_copy(self) -> None:
        s = self.current()
        if s is not None:
            self.copy_resume_command(s)

    def copy_resume_command(self, s: Session) -> None:
        """Copy s's resume command to the clipboard, reporting the outcome in the status.

        Args:
            s: The session whose resume command to copy.

        Example: with pbcopy available -> status == " copied via pbcopy: cd /work/proj && claude
        --resume a1"; with no clipboard tool -> status == " no clipboard tool found
        (pbcopy/wl-copy/xclip/xsel)"
        """
        how = copy_clipboard(s.resume_cmd())
        self.status = (" copied via %s: %s" % (how, s.resume_cmd())) if how \
            else " no clipboard tool found (pbcopy/wl-copy/xclip/xsel)"

    def can_resume(self, s: Session) -> bool:
        """Resuming runs in the session's cwd; refuse (with a status message) if it is gone.

        Args:
            s: The session to check.

        Returns:
            True if s can be resumed (its cwd exists or is unset), else False.

        Examples: cwd exists (or is empty) -> True; cwd "/gone" missing -> False and
        status == " cwd no longer exists: /gone"
        """
        if s.cwd and not os.path.isdir(s.cwd):
            self.status = " cwd no longer exists: " + s.cwd
            return False
        return True

    def edit_resume_command(self, s: Session, redraw_screen: bool = True) -> Optional[List[str]]:
        """Let the user edit the resume command line; return its argv, or None if cancelled.

        Args:
            s: The session whose resume command is edited.
            redraw_screen: True (default) repaints the whole list each keystroke; the viewer passes
                False.

        Returns:
            The edited command as an argv list, or None if the user cancelled.

        Examples: the prompt starts as "claude --resume a1";
            user types " --model opus" and presses Enter -> ["claude", "--resume", "a1", "--model", "opus"]
            user presses Esc, or clears the line -> None and status == " resume cancelled"
            user enters an unbalanced quote -> status == " bad command: ..." and the prompt reopens
        """
        initial = " ".join(shell_quote(w) for w in s.resume_argv())
        while True:
            buf, ok = self.prompt("resume: ", initial, redraw_screen=redraw_screen)
            if not ok:
                self.status = " resume cancelled"
                return None
            try:
                argv = shlex.split(buf)
            except ValueError as e:
                self.status = " bad command: %s" % e
                initial = buf  # keep what was typed so it can be fixed
                continue
            if not argv:
                self.status = " resume cancelled"
                return None
            return argv

    def build_keymap(self) -> Dict[str, Callable[[], Optional[bool]]]:
        """Key name (see App.key) -> handler for the session list.

        Returns:
            A dict mapping each key name to its handler method.

        Example: build_keymap()["j"] is self.on_down; build_keymap()["ENTER"] is self.on_open
        """
        bindings: List[Tuple[Tuple[str, ...], Callable[[], Optional[bool]]]] = [
            (("q", "CTRL_C"), self.on_quit),
            (("?",), self.on_help),
            (("j", "DOWN"), self.on_down),
            (("k", "UP"), self.on_up),
            (("PGDN",), self.on_page_down),
            (("PGUP",), self.on_page_up),
            (("g", "HOME"), self.on_first),
            (("G", "END"), self.on_last),
            (("J", "SDOWN"), self.on_preview_down),
            (("K", "SUP"), self.on_preview_up),
            (("/",), self.on_filter),
            (("ESC",), self.on_clear_filter),
            (("TAB",), self.on_cycle_source),
            (("p",), self.on_toggle_project),
            (("s",), self.on_toggle_sort),
            (("l",), self.on_toggle_split),
            (("t",), self.on_toggle_results),
            (("u",), self.on_toggle_mine),
            (("R",), self.on_rescan),
            (("ENTER", "v"), self.on_open),
            (("r",), self.on_resume),
            (("e",), self.on_edit_resume),
            (("y",), self.on_copy),
        ]
        return {name: fn for names, fn in bindings for name in names}

    def run(self) -> None:
        """Main loop: draw, read a key, dispatch. Returns on quit or when a resume is chosen.

        Example: keys "j", "j", "q" -> selection moves down twice, then run() returns; keys "r" on
        a resumable session -> sets self.resume and returns.
        """
        while True:
            self.draw()
            k = self.key()
            self.status = ""  # status messages last for one keypress
            if k is None or k == "RESIZE":
                continue
            handler = self.keymap.get(k)
            if handler is not None and handler():
                return

    def prompt(self, label: str, initial: str, live: Optional[Callable[[str], None]] = None,
               redraw_screen: bool = True) -> Tuple[str, bool]:
        """Footer line editor. Returns (text, accepted); Esc/^C cancel, ^U erases.

        live(text) is called after each edit (the filter prompt re-filters as you type).
        redraw_screen=True repaints the whole list view each keystroke (so live changes
        show); the full-screen viewer passes False to keep its already-drawn frame and
        only repaint the footer.

        Args:
            label: Text shown before the input, e.g. "/".
            initial: Starting text of the input.
            live: Optional callback called with the text after every edit.
            redraw_screen: True (default) repaints the whole list each keystroke.

        Returns:
            A (text, accepted) tuple: the final text, and True for Enter or False if cancelled.

        Examples: prompt("/", "fi") with keys "x", ENTER -> ("fix", True);
                  prompt("/", "fi") with key ESC -> ("fi", False)
        """
        buf = initial
        while True:
            if redraw_screen:
                self.draw()
            h, w = self.scr.getmaxyx()
            if h >= 2 and w > 2:
                self.fill(h - 1, self.attrs["head"])
                shown = label + buf
                self.put(h - 1, 0, clip(" " + shown, w - 2), self.attrs["head"])
                self.put(h - 1, min(w - 2, 1 + str_width(clip(shown, w - 3))), "_",
                         self.attrs["head"])
                self.scr.refresh()
            k = self.key()
            if k is None or k == "RESIZE":
                continue
            buf, done = self.edit(buf, k)
            if done == "ok":
                return buf, True
            if done == "cancel":
                return buf, False
            if live is not None:
                live(buf)

    def filter_mode(self) -> None:
        """Prompt for the list filter ("/"), refiltering live as you type. Enter keeps the text;
        Esc clears the filter.

        Example: typing "fix" then Enter -> query == "fix" and the view only has matches;
        typing "fix" then Esc -> query == "" and the full list returns.
        """
        def live(b: str) -> None:
            self.query = b
            self.refilter()
        buf, ok = self.prompt("/", self.query, live)
        self.query = buf if ok else ""  # Esc clears the filter rather than restoring it
        self.refilter()

    def help(self) -> None:
        """Show the HELP text full-screen and wait for any key (resizes are ignored).

        Example: help() draws "ai-sessions - browse Claude Code and Codex transcripts" (bold) and
        the key list, returns when the user presses any key such as "x".
        """
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        for i, ln in enumerate(HELP[:h - 1]):
            self.put(i, 1, clip(ln, w - 2), self.attrs["bold"] if i == 0 else 0)
        self.scr.refresh()
        while True:
            k = self.key()
            if k not in (None, "RESIZE"):
                return

    def viewer(self, s: Session) -> bool:
        """Open the full-screen viewer; True if a resume was chosen from it.

        Args:
            s: The session to show.

        Returns:
            True if a resume was chosen from the viewer, else False.
        """
        Viewer(self, s).run()
        return self.resume is not None


class Viewer(object):
    """Full-screen transcript viewer with search, opened from the list with Enter.

    Shares the App's window, colors and drawing helpers. Its t / u toggles change
    app.show_results / app.mine_only, which persist when you return to the list.
    The search query starts as the list filter but is local to the viewer.
    Its y and ? copy the resume command and show help, as in the list.
    Its r / e set app.resume (and app.resume_override) and leave the viewer, which
    then also ends the list's main loop.
    """

    def __init__(self, app: App, s: Session) -> None:
        """Load session s's transcript and set up scroll, search and render-cache state; the search
        query starts as the app's list filter.

        Args:
            app: The App whose window, colors and settings are shared.
            s: The session to show.

        Example: Viewer(app, s) with app.query == "fix" -> .query == "fix", .offset == 0,
        .hit_index == -1, .msgs == get_transcript(s)
        """
        self.app = app
        self.session = s
        self.msgs = get_transcript(s)
        self.query = app.query
        self.offset = 0          # first visible line
        self.hit_index = -1      # current search hit (-1: none chosen yet)
        self.body_height = 1     # visible rows, set by draw()
        self.status = ""
        self.lines: List[Line] = []
        self.hits: List[int] = []
        # Re-render only when one of (width, results, mine, terms) changes.
        self._render_key: Optional[Tuple[Any, ...]] = None
        self.keymap = self.build_keymap()

    # -- key handlers: True means "leave the viewer"
    def on_back(self) -> bool:
        return True

    def on_line_down(self) -> None:
        self.offset += 1

    def on_line_up(self) -> None:
        self.offset -= 1

    def on_page_down(self) -> None:
        self.offset += self.body_height - 1

    def on_page_up(self) -> None:
        self.offset -= self.body_height - 1

    def on_top(self) -> None:
        self.offset = 0

    def on_bottom(self) -> None:
        self.offset = len(self.lines)  # draw() clamps to the last page

    def on_toggle_results(self) -> None:
        self.app.show_results = not self.app.show_results

    def on_toggle_mine(self) -> None:
        self.app.mine_only = not self.app.mine_only

    def on_resume(self) -> bool:
        """r: choose this session for resuming and leave the viewer.

        Returns:
            True to leave the viewer (resume chosen), else False.

        Example: cwd exists -> app.resume == self.session and returns True; cwd gone -> returns
        False and the viewer footer shows " cwd no longer exists: /gone".
        """
        if not self.app.can_resume(self.session):
            self.take_app_status()
            return False
        self.app.resume = self.session
        return True

    def on_edit_resume(self) -> bool:
        """e: edit the resume command in the footer, then choose the session for resuming.

        Returns:
            True to leave the viewer (resume chosen), else False.

        Example: user edits to "claude --resume a1 --model opus" and presses Enter ->
        app.resume == self.session, app.resume_override == ["claude", "--resume", "a1",
        "--model", "opus"], returns True; Esc -> returns False with the status " resume cancelled".
        """
        app = self.app
        if not app.can_resume(self.session):
            self.take_app_status()
            return False
        argv = app.edit_resume_command(self.session, redraw_screen=False)
        if argv is None:
            self.take_app_status()
            return False
        app.resume = self.session
        app.resume_override = argv
        return True

    def on_copy(self) -> None:
        self.app.copy_resume_command(self.session)
        self.take_app_status()

    def on_help(self) -> None:
        self.app.help()

    def take_app_status(self) -> None:
        """Show a status message the App's shared helpers left, in the viewer's footer.

        Example: app.status == " resume cancelled" -> self.status == " resume cancelled" and
        app.status == ""
        """
        self.status, self.app.status = self.app.status, ""

    def on_next_hit(self) -> None:
        self.goto_hit(1)

    def on_prev_hit(self) -> None:
        self.goto_hit(-1)

    def goto_hit(self, step: int) -> None:
        """Move to the next (step=1) or previous (step=-1) search hit, wrapping around, and scroll
        so the hit sits about a third of the way down the screen.

        Args:
            step: +1 for the next hit, -1 for the previous one.

        Example: hits [8, 20, 40], hit_index 2, body_height 30: goto_hit(1) -> hit_index == 0,
        offset == 0 (8 - 10 clamped); goto_hit(-1) from 1 -> hit_index == 0. With no hits: no change.
        """
        if self.hits:
            self.hit_index = (self.hit_index + step) % len(self.hits)
            self.offset = max(0, self.hits[self.hit_index] - self.body_height // 3)

    def on_search(self) -> None:
        """/: prompt for a search query in the footer; on Enter use it, restart hit navigation and
        force a re-render with the new terms; on Esc leave everything unchanged.

        Example: query "fix", user types "ing" and presses Enter -> query == "fixing",
        hit_index == -1.
        """
        buf, ok = self.app.prompt("/", self.query, redraw_screen=False)
        if ok:
            self.query = buf
            self.hit_index = -1
            self._render_key = None  # force a re-render with the new terms

    def build_keymap(self) -> Dict[str, Callable[[], Optional[bool]]]:
        """Key name (see App.key) -> handler for the viewer.

        Returns:
            A dict mapping each key name to its handler method.

        Example: build_keymap()["n"] is self.on_next_hit; build_keymap()[" "] is self.on_page_down
        """
        bindings: List[Tuple[Tuple[str, ...], Callable[[], Optional[bool]]]] = [
            (("q", "ESC", "CTRL_C"), self.on_back),
            (("j", "DOWN", "ENTER"), self.on_line_down),
            (("k", "UP"), self.on_line_up),
            (("PGDN", " ", "f"), self.on_page_down),
            (("PGUP", "b"), self.on_page_up),
            (("g", "HOME"), self.on_top),
            (("G", "END"), self.on_bottom),
            (("t",), self.on_toggle_results),
            (("u",), self.on_toggle_mine),
            (("n",), self.on_next_hit),
            (("N",), self.on_prev_hit),
            (("/",), self.on_search),
            (("r",), self.on_resume),
            (("e",), self.on_edit_resume),
            (("y",), self.on_copy),
            (("?",), self.on_help),
        ]
        return {name: fn for names, fn in bindings for name in names}

    def handle_key(self, k: str) -> bool:
        handler = self.keymap.get(k)
        return handler is not None and bool(handler())

    # -- drawing
    def draw(self, h: int, w: int) -> None:
        """Draw one frame of the h x w viewer: re-render when width/toggles/terms changed, clamp the
        scroll, then paint the title bar (with "hit i/n"), transcript lines and footer (status or
        key hints plus scroll percentage).

        Args:
            h: Screen height in rows.
            w: Screen width in columns.

        Example: 40-line transcript, h=12 (10 body rows), query "bug" with 3 hits, offset 10 ->
        title bar " CC Fix bug  hit 1/3", body shows lines 10-19, footer ends with "[50%]".
        """
        app = self.app
        terms = terms_of(self.query)
        render_key = (w, app.show_results, app.mine_only, tuple(terms))
        if render_key != self._render_key:
            self._render_key = render_key
            self.lines, start = render(self.session, self.msgs, w - 1, app.show_results,
                                       app.mine_only)
            self.hits = hit_lines(self.lines, start, terms)
            if self.hit_index >= len(self.hits):
                self.hit_index = -1
            if self.hits and self.hit_index < 0:
                self.hit_index = 0
                self.offset = max(0, self.hits[0] - h // 3)
        bh = self.body_height = h - 2
        self.offset = max(0, min(self.offset, max(0, len(self.lines) - bh)))
        pat = term_regex(terms)
        app.scr.erase()
        app.fill(0, app.attrs["head"])
        title = clip(self.session.title, max(0, w - 40))
        hit_text = ("hit %d/%d" % (self.hit_index + 1, len(self.hits))) if self.hits else \
            ("no hits" if terms else "")
        app.put(0, 0, clip(" %s %s  %s" % (TAG[self.session.source], title, hit_text), w - 1),
                app.attrs["head"])
        for i in range(bh):
            j = self.offset + i
            if j >= len(self.lines):
                break
            t, kind = self.lines[j]
            app.text(1 + i, 0, t, w - 1, app.attrs.get(kind, 0), pat)
        app.fill(h - 1, app.attrs["head"])
        pct = 100 if len(self.lines) <= bh else int(100 * (self.offset + bh) / len(self.lines))
        foot = self.status or (" j/k scroll  spc/b page  g/G ends  / search  n/N hit  "
                               "t results  u mine  r/e resume  y copy  ? help  q back  [%d%%]" % min(pct, 100))
        app.put(h - 1, 0, clip(foot, w - 1), app.attrs["head"])
        app.scr.refresh()
        self.status = ""

    def run(self) -> None:
        """Viewer main loop: draw, read a key, dispatch until a handler asks to leave. A too-small
        terminal shows "too small" and waits for q / Esc / Ctrl-C.

        Example: keys "j", "j", "q" -> offset 2 and then run() returns; key "r" on a resumable
        session -> sets app.resume and returns.
        """
        app = self.app
        while True:
            h, w = app.scr.getmaxyx()
            if h < 4 or w < 12:
                app.scr.erase()
                app.put(0, 0, "too small")
                app.scr.refresh()
                if app.key() in ("q", "ESC", "CTRL_C"):
                    return
                continue
            self.draw(h, w)
            k = app.key()
            if k is None or k == "RESIZE":
                continue
            if self.handle_key(k):
                return


def browse(scr: Window, sessions: List[Session], query: str,
           source: str) -> Tuple[Optional[Session], Optional[List[str]]]:
    """Run the interactive browser (called inside curses.wrapper).

    Returns (session chosen for resume or None, edited resume argv or None).

    Args:
        scr: The curses window.
        sessions: All sessions to browse.
        query: Initial filter text.
        source: Initial source filter: "all", "claude" or "codex".

    Returns:
        A (session, argv) tuple: the session chosen for resume (None if the user quit) and the
        edited resume argv (None if the default command should be used).

    Example: browse(scr, sessions, "fix", "all") with keys "r" on session a1 -> (a1, None);
    with keys "q" -> (None, None).
    """
    scr.keypad(True)
    app = App(scr, sessions, query, source)
    app.run()
    return app.resume, app.resume_override


def run_tui(query: str, source: Optional[str] = None) -> int:
    """Run the interactive browser and, if a session was chosen, exec its resume command in the
    session's directory. Returns an exit code (it does not return after a successful exec).

    Args:
        query: Initial filter text.
        source: "claude", "codex" or None for both.

    Returns:
        The exit code: 0 normal, 2 not a terminal, 127 resume command not found, 130 Ctrl-C.

    Examples: not a terminal -> prints "interactive mode needs a terminal (try --list)" to
    stderr, returns 2; user quits with q -> 0; Ctrl-C -> 130; resume command not on PATH ->
    127; resume chosen -> execvp("claude", ["claude", "--resume", "a1"]) after chdir.
    """
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        sys.stderr.write("ai-sessions: interactive mode needs a terminal (try --list)\n")
        return 2
    sessions = load_sessions(progress=True)
    try:
        chosen, argv_override = curses.wrapper(browse, sessions, query, source or "all")
    except KeyboardInterrupt:
        return 130
    if chosen is not None:
        # The terminal is restored by now; replace this process with the resumed CLI,
        # started in the session's own directory (Claude finds sessions per cwd).
        if chosen.cwd and os.path.isdir(chosen.cwd):
            os.chdir(chosen.cwd)
        argv = argv_override or chosen.resume_argv()
        if not argv_override:
            warning = chosen.resume_warning()
            if warning:
                sys.stderr.write("ai-sessions: %s; using default\n" % warning)
        if not shutil.which(argv[0]):
            sys.stderr.write("ai-sessions: %s not found in PATH\n" % argv[0])
            return 127
        os.execvp(argv[0], argv)
    return 0


# ---------------------------------------------------------------- CLI

def cmd_list(sessions: List[Session], query: str, source: Optional[str]) -> int:
    """Print matching sessions newest first, one tab-separated line each: date, source, id,
    project, title. Returns 0.

    Args:
        sessions: All sessions.
        query: Search terms; "" lists everything.
        source: "claude", "codex" or None for both.

    Returns:
        Exit code 0.

    Example: stdout gets "2025-03-01 10:00\\tclaude\\ta1\\tproj\\tFix bug\\n" for a1.
    """
    for s in sort_sessions(filter_sessions(sessions, query, source or "all")):
        row = (fmt_ts(s.last_ts), s.source, s.id, s.project, s.title)
        sys.stdout.write("\t".join(one_line(c) for c in row) + "\n")
    return 0


def cmd_show(sessions: List[Session], ident: str, tools: bool, mine_only: bool = False) -> int:
    """Print the transcript of the session whose id equals ident or starts with it.
    Returns 0; 1 (with a message on stderr) if nothing matches or the prefix is ambiguous.

    Args:
        sessions: All sessions.
        ident: A session id or a unique prefix of one.
        tools: True to include tool results.
        mine_only: True to show only your own input (default False).

    Returns:
        Exit code: 0 on success, 1 if no session or several sessions match.

    Examples: cmd_show(sessions, "a1", False) -> prints the 100-column transcript, returns 0;
    cmd_show(sessions, "zz", False) -> "ai-sessions: no session matches 'zz'", returns 1;
    cmd_show(sessions, "a", False) with ids a1 and a2 -> lists both as ambiguous, returns 1.
    """
    ms = [s for s in sessions if s.id == ident] or [s for s in sessions if s.id.startswith(ident)]
    if not ms:
        sys.stderr.write("ai-sessions: no session matches %r\n" % ident)
        return 1
    if len(ms) > 1:
        sys.stderr.write("ai-sessions: %r is ambiguous:\n" % ident)
        for s in ms:
            sys.stderr.write("  %s %s %s\n" % (s.source, s.id, s.title))
        return 1
    s = ms[0]
    lines, _ = render(s, get_transcript(s), 100, tools, mine_only)
    sys.stdout.write("\n".join(t for t, _ in lines) + "\n")
    return 0


def build_arg_parser() -> argparse.ArgumentParser:
    """Build the command-line parser for ai-sessions.

    Returns:
        The ArgumentParser with the query, --list, --search, --source, --show, --tools, --mine,
        --claude-cmd and --codex-cmd options.

    Example: build_arg_parser().parse_args(["--list", "fix"]).query -> ["fix"]
    """
    ap = argparse.ArgumentParser(
        prog="ai-sessions",
        description="Browse and search Claude Code and Codex CLI session transcripts. "
                    "With no --list/--show, launches a curses browser (? for keys).")
    ap.add_argument("query", nargs="*", help="initial filter (TUI) or search terms (with --list)")
    ap.add_argument("--list", action="store_true",
                    help="print tab-separated rows: date, source, id, project, title")
    ap.add_argument("--search", metavar="QUERY", help="with --list: only sessions matching QUERY")
    ap.add_argument("--source", choices=("claude", "codex"), help="restrict to one source")
    ap.add_argument("--show", metavar="ID", help="print a transcript (id or unique prefix)")
    ap.add_argument("--tools", action="store_true", help="with --show: include tool results")
    ap.add_argument("--mine", action="store_true",
                    help="with --show: only your input (prompts and slash commands)")
    ap.add_argument("--claude-cmd", metavar="CMD",
                    help="command to resume Claude sessions (default: $AI_SESSIONS_CLAUDE_CMD or "
                         "'claude'); {id} is replaced by the session id, else '--resume ID' is appended")
    ap.add_argument("--codex-cmd", metavar="CMD",
                    help="command to resume Codex sessions (default: $AI_SESSIONS_CODEX_CMD or "
                         "'codex'); {id} is replaced by the session id, else 'resume ID' is appended")
    return ap


def main() -> int:
    """Command-line entry point: parse arguments, then --list, --show or the TUI. Returns the
    process exit code.

    Returns:
        The process exit code.

    Examples: `ai-sessions --list fix` -> tab-separated rows of sessions matching "fix", 0;
    `ai-sessions --show a1b2 --tools` -> that transcript including tool results, 0;
    `ai-sessions` -> curses browser; `ai-sessions --list | head -1` exits 0 on a closed pipe.
    """
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    ap = build_arg_parser()
    args = ap.parse_args()
    if args.claude_cmd:
        CMD_OVERRIDES["claude"] = args.claude_cmd
    if args.codex_cmd:
        CMD_OVERRIDES["codex"] = args.codex_cmd
    stream: Any
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="replace")
        except (AttributeError, ValueError):
            pass
    q = " ".join(([args.search] if args.search else []) + args.query)
    if args.list or args.show:
        sessions = load_sessions()
        if args.source:
            sessions = [s for s in sessions if s.source == args.source]
        try:
            if args.show:
                return cmd_show(sessions, args.show, args.tools, args.mine)
            return cmd_list(sessions, q, args.source)
        except BrokenPipeError:
            try:
                sys.stdout = None
            except Exception:
                pass
            return 0
    return run_tui(q, args.source)


if __name__ == "__main__":
    sys.exit(main())
