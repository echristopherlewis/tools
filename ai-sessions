class Session(object):
    """A session as the UI sees it: the index Summary fields plus derived search text."""
    # Fields come from the index summary (see Source.make_summary()) via __dict__.update.
    source: str
    id: str
    path: str
    cwd: str
    branch: str
    title: str
    first_ts: float
    last_ts: float
    n_user: int
    n_asst: int
    blob: str
    project: str
    search_text: str
    starred: bool

    def __init__(self, d: Summary) -> None:
        """Build a Session from an index Summary dict, adding project, title fallback and search_text.

        Args:
            d: A Summary dict, as built by Source.make_summary() or loaded from the index.

        Example: Session({"source": "claude", "id": "a1", "cwd": "/work/proj", "title": "",
        "blob": "Fix", ...}) -> .project == "proj", .title == "(untitled)",
        .search_text == "(untitled)\\nproj\\n/work/proj\\nfix"; with cwd "" -> .project == "-";
        .starred is False unless d has "starred" (SessionIndex.load sets it from stars.json)
        """
        self.starred = False
        self.__dict__.update(d)
        self.project = os.path.basename(self.cwd.rstrip("/")) if self.cwd else "-"
        if not self.title:
            self.title = "(untitled)"
        self.search_text = "\n".join((self.title, self.project, self.cwd, self.blob)).lower()

    def resume_argv(self) -> List[str]:
        return SOURCES[self.source].resume_argv(self.id)[0]

    def resume_warning(self) -> Optional[str]:
        """Why the configured resume command was unusable (default is used), or None.

        Returns:
            A short message if the configured command was unusable, else None.
        """
        return SOURCES[self.source].resume_argv(self.id)[1]

    def resume_cmd(self) -> str:
        """Shell command line that resumes this session, prefixed with a cd into its cwd.

        Returns:
            A shell command line such as "cd /dir && claude --resume ID"; no "cd" part when the
            session has no cwd.

        Examples:
            claude session a1 in /work/proj -> "cd /work/proj && claude --resume a1"
            codex session b1 with cwd "" -> "codex resume b1"
        """
        cmd = " ".join(shell_quote(w) for w in self.resume_argv())
        return ("cd %s && %s" % (shell_quote(self.cwd), cmd)) if self.cwd else cmd



class Theme(object):
    """Colors for the TUI: terminal background detection, the row stripe, the palette, and the
    curses attribute table.

    Args:
        background: Terminal background (r, g, b), 0-255 each, from query_background, if known.
        env: Environment mapping to read AI_SESSIONS_THEME, AI_SESSIONS_STRIPE and COLORFGBG
            from (default: os.environ, read each time a method needs it).

    Example: Theme((255, 255, 255)).is_light() -> True; Theme(None, {}).stripe(256) -> 236.
    """

    # How far (in 0-255 brightness) the stripe sits from the terminal background; it moves toward
    # mid-grey so it works on dark and light themes. Dark backgrounds take a bigger step so a black
    # background gets grey 236; light backgrounds keep a small step so the stripe stays faint.
    STRIPE_STEP_DARK = 48
    STRIPE_STEP_LIGHT = 14

    # Claude Code's theme as xterm-256 color numbers (the nearest cube/grey entry to each RGB).
    # Keys: brand (Claude orange, assistant name / Claude Code tag), codex (Codex tag),
    # secondary (muted text: dates, metadata, tool results), tool (tool-call marker),
    # star (starred rows), select_fg / select_bg (selected row), prompt_bg (band behind your
    # messages), head_bg (header and footer bars), hl_fg / hl_bg (search-match highlight),
    # code (inline code and fenced code blocks in assistant replies).
    PALETTES: Dict[str, Dict[str, int]] = {
        # Source RGBs: brand 215,119,87; secondary 153,153,153; tool/success 78,186,101;
        # star/warning 255,193,7; select_fg 177,185,249; prompt_bg 55,55,55.
        "dark": {"brand": 173, "codex": 74, "secondary": 246, "tool": 71, "star": 214,
                 "select_fg": 147, "select_bg": 239, "prompt_bg": 237, "head_bg": 237,
                 "hl_fg": 16, "hl_bg": 214, "code": 153},
        # Source RGBs: brand 215,119,87; secondary 102,102,102; tool/success 44,122,57;
        # star/warning 150,108,30; select_fg 87,105,247; prompt_bg 240,240,240.
        "light": {"brand": 173, "codex": 31, "secondary": 242, "tool": 28, "star": 172,
                  "select_fg": 63, "select_bg": 252, "prompt_bg": 254, "head_bg": 254,
                  "hl_fg": 16, "hl_bg": 214, "code": 25},
    }

    def __init__(self, background: Optional[Tuple[int, int, int]] = None,
                 env: Optional[Dict[str, str]] = None) -> None:
        """Remember the terminal background and environment to decide colors from.

        Args:
            background: Terminal background (r, g, b), 0-255 each, or None when unknown.
            env: Environment mapping; None means os.environ, looked up at call time.

        Example: Theme((0, 0, 0), {"AI_SESSIONS_THEME": "basic"}).palette(256) -> None
        """
        self.background = background
        self.env = env

    def _env(self) -> Dict[str, str]:
        """The environment to read: the one given to __init__, else the current os.environ."""
        return os.environ if self.env is None else self.env

    @staticmethod
    def parse_osc11_reply(reply: str) -> Optional[Tuple[int, int, int]]:
        """Extract the background color from a terminal's reply to the OSC 11 query.

        Args:
            reply: Raw reply text, e.g. "ESC ] 11 ; rgb:RRRR/GGGG/BBBB" ended by BEL or ST, possibly
                followed or preceded by other replies (such as a DA1 reply). Each component has 1-4
                hex digits and is scaled to 0-255.

        Returns:
            An (r, g, b) tuple with 0-255 components, or None when no valid color is present.

        Example: Theme.parse_osc11_reply("\x1b]11;rgb:ffff/ffff/ffff\x1b\\") -> (255, 255, 255);
        Theme.parse_osc11_reply("\x1b]11;rgb:1e/1e/1e\x07") -> (30, 30, 30); Theme.parse_osc11_reply("") -> None.
        """
        m = re.search(r"\]11;rgb:([0-9a-f]{1,4})/([0-9a-f]{1,4})/([0-9a-f]{1,4})", reply, re.I)
        if not m:
            return None
        r, g, b = (round(int(h, 16) * 255 / (16 ** len(h) - 1)) for h in m.groups())
        return (r, g, b)


    @staticmethod
    def query_background(timeout: float = 0.2) -> Optional[Tuple[int, int, int]]:
        """Ask the controlling terminal for its background color (OSC 11). Must run before curses
        starts, or curses would swallow the reply. Never raises.

        The query is followed by a DA1 query (ESC [ c), which nearly every terminal answers; its
        reply marks the end of the output, so terminals that ignore OSC 11 do not cost the full timeout.

        Args:
            timeout: Longest time in seconds to wait for the reply.

        Returns:
            An (r, g, b) tuple with 0-255 components, or None when there is no terminal or it does
            not answer.

        Example: an xterm with a white background -> (255, 255, 255); a terminal that ignores
        OSC 11, or no controlling terminal -> None.
        """
        try:
            fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
        except OSError:
            return None
        buf = b""
        try:
            saved = termios.tcgetattr(fd)
            try:
                raw = list(saved)
                raw[3] = raw[3] & ~(termios.ICANON | termios.ECHO)  # lflag: no line buffering or echo
                raw[6] = list(saved[6])
                raw[6][termios.VMIN] = 0
                raw[6][termios.VTIME] = 0
                termios.tcsetattr(fd, termios.TCSANOW, raw)
                os.write(fd, b"\x1b]11;?\x1b\\" + b"\x1b[c")
                deadline = time.monotonic() + timeout
                while not re.search(rb"\x1b\[\?[0-9;]*c", buf):
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        break
                    ready, _, _ = select.select([fd], [], [], remaining)
                    if not ready:
                        break
                    chunk = os.read(fd, 1024)
                    if not chunk:
                        break
                    buf += chunk
            finally:
                termios.tcsetattr(fd, termios.TCSAFLUSH, saved)
        except (OSError, termios.error, ValueError):
            return None
        finally:
            try:
                os.close(fd)
            except OSError:
                pass
        return Theme.parse_osc11_reply(buf.decode("latin-1"))

    def is_light(self) -> bool:
        """Whether the terminal has a light background.

        The real background color (from query_background) wins: light when its luminance
        is at least 128. Otherwise COLORFGBG ("fg;bg" or "fg;default;bg") decides: light when its
        last field is 7 or 15. With no information at all the terminal is assumed dark.

        Returns:
            True for a light background, False for a dark or unknown one.

        Examples: Theme((255, 255, 255), {}).is_light() -> True; Theme(None, {}).is_light() -> False;
        Theme(None, {"COLORFGBG": "0;15"}).is_light() -> True;
        Theme((0, 0, 0), {"COLORFGBG": "0;15"}).is_light() -> False.
        """
        if self.background is not None:
            r, g, b = self.background
            return 0.299 * r + 0.587 * g + 0.114 * b >= 128
        return (self._env().get("COLORFGBG") or "").split(";")[-1] in ("7", "15")

    @staticmethod
    def stripe_for_background(rgb: Tuple[int, int, int]) -> int:
        """Pick the 256-color grey closest to a shade Theme.STRIPE_STEP_DARK/LIGHT away from the background.

        Args:
            rgb: Terminal background as (r, g, b), 0-255 each.

        Returns:
            An xterm-256 grey color number: 16 (level 0), 231 (level 255) or 232-255 (levels 8, 18, ... 238).

        Example: Theme.stripe_for_background((0, 0, 0)) -> 236; (255, 255, 255) -> 255; (30, 30, 30) -> 239.
        """
        lum = 0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]
        light = Theme(rgb, {}).is_light()
        target = lum - Theme.STRIPE_STEP_LIGHT if light else lum + Theme.STRIPE_STEP_DARK
        greys = [(0, 16), (255, 231)] + [(8 + 10 * k, 232 + k) for k in range(24)]
        # min() keeps the first of equal distances, so ties are deterministic.
        return min(greys, key=lambda g: abs(g[0] - target))[1]

    def stripe(self, ncolors: int) -> Optional[int]:
        """Pick the background color for every other row of the session list, or None for no stripes.

        AI_SESSIONS_STRIPE wins when set: a color number (0..ncolors-1) or "off". Otherwise, on
        256-color terminals, a grey just off the terminal's real background when it is known
        (see Theme.stripe_for_background); failing that, 255 (light grey) when COLORFGBG says the
        background is light (7 or 15), else 236 (very dark grey).

        Args:
            ncolors: Number of colors the terminal supports (curses.COLORS).

        Returns:
            A curses color number, or None when the list should not be striped.

        Example: Theme(None, {}).stripe(256) -> 236; Theme(None, {"COLORFGBG": "0;15"}).stripe(256) -> 255;
        Theme((255, 255, 255), {}).stripe(256) -> 255; Theme(None, {}).stripe(8) -> None;
        Theme(None, {"AI_SESSIONS_STRIPE": "off"}).stripe(256) -> None.
        """
        setting = (self._env().get("AI_SESSIONS_STRIPE") or "").strip().lower()
        if setting:
            if setting.isdigit() and int(setting) < ncolors:
                return int(setting)
            return None  # "off", or a color the terminal cannot show
        if ncolors < 256:
            return None  # 8/16-color palettes have no subtle shades
        if self.background is not None:
            return Theme.stripe_for_background(self.background)  # the real color beats a stale COLORFGBG
        return 255 if self.is_light() else 236

    def palette(self, ncolors: int) -> Optional[Dict[str, int]]:
        """Choose the TUI color palette, or None for the original 8-color ("basic") look.

        AI_SESSIONS_THEME is "claude" (default; unknown values count as "claude") or "basic".
        Basic is also used on terminals with fewer than 256 colors.

        Args:
            ncolors: Number of colors the terminal supports (curses.COLORS).

        Returns:
            A PALETTES entry (dark or light, see is_light), or None for basic.

        Examples: Theme(None, {}).palette(256) -> Theme.PALETTES["dark"];
        Theme(None, {"COLORFGBG": "0;15"}).palette(256) -> Theme.PALETTES["light"];
        Theme(None, {"AI_SESSIONS_THEME": "basic"}).palette(256) -> None; Theme(None, {}).palette(8) -> None.
        """
        if (self._env().get("AI_SESSIONS_THEME") or "").strip().lower() == "basic" or ncolors < 256:
            return None
        return Theme.PALETTES["light" if self.is_light() else "dark"]

    def curses_attrs(self) -> Dict[str, int]:
        """Build the attribute table (name -> curses attribute). Uses color pairs when the
        terminal has colors; otherwise (or on curses errors) it keeps the bold/dim/reverse fallbacks.

        With the "claude" theme on a 256-color terminal (see Theme.palette) the colors come from
        Claude Code's palette; otherwise the original 8-color look is used. Besides the kind
        names (title, meta, dim, user, asst, tool, result, hl, head, and "prompt" in the claude
        theme only) it holds the Markdown row kinds heading, code, quote and table and the inline
        style attributes bold, italic (underline where curses has no A_ITALIC), code and link
        (dim is shared); "code" is cyan in the basic theme and the palette's code color in the
        claude theme, and monochrome terminals fall back to bold, dim and underline. It also holds the session-list row variants: cc, cx, star,
        dim for plain rows and the same with a "stripe_" or "sel_" prefix (plus bare "stripe" / "sel" for the row's
        own background) for every other row and the selected row.

        Example: on a basic color terminal -> self.attrs["cc"] == color_pair(1) | A_BOLD and
        self.attrs["sel"] == A_REVERSE; on a 256-color one, self.attrs["sel"] is the select_fg
        color on the select_bg color and "prompt" is the grey band behind your messages;
        on a monochrome one -> self.attrs["cc"] == A_BOLD and self.attrs["hl"] == A_REVERSE | A_BOLD
        """
        has_italic = hasattr(curses, "A_ITALIC")  # Python 3.7+ only
        italic = getattr(curses, "A_ITALIC", curses.A_UNDERLINE)
        attrs: Dict[str, int] = {"plain": 0, "dim": curses.A_DIM, "bold": curses.A_BOLD, "rev": curses.A_REVERSE,
             "cc": curses.A_BOLD, "cx": curses.A_UNDERLINE, "user": curses.A_BOLD,
             "asst": curses.A_BOLD, "hl": curses.A_REVERSE | curses.A_BOLD,
             "title": curses.A_BOLD, "tool": curses.A_DIM, "result": curses.A_DIM,
             "meta": 0, "head": curses.A_REVERSE, "star": curses.A_BOLD,
             # Markdown: row kinds (heading, code, quote, table) and inline span styles
             # (bold, italic, code, link; dim is shared with the kind above).
             "italic": italic, "code": curses.A_BOLD, "link": curses.A_UNDERLINE,
             "heading": curses.A_BOLD, "quote": curses.A_DIM | (italic if has_italic else 0),
             "table": 0}
        try:
            if curses.has_colors():
                curses.start_color()
                try:
                    curses.use_default_colors()
                    bg = fg = -1
                except curses.error:
                    bg, fg = curses.COLOR_BLACK, curses.COLOR_WHITE
                palette = self.palette(curses.COLORS)
                next_pair = [1]  # pair numbers are handed out in order; 0 is the terminal default

                def pair(f: int, b: int) -> int:
                    """Allocate the next color pair (f on b) and return its attribute; 0 when
                    the terminal has no pairs left. Example: pair(2, -1) -> color_pair(1)."""
                    if next_pair[0] >= curses.COLOR_PAIRS:
                        return 0
                    curses.init_pair(next_pair[0], f, b)
                    next_pair[0] += 1
                    return curses.color_pair(next_pair[0] - 1)

                def row_set(prefix: str, row_bg: int, base: int, cc: int, cx: int,
                            star: int, dim: int) -> None:
                    """Store the list-row attributes for one row background: attrs[prefix] (the
                    row itself) and prefix_cc / _cx / _star / _dim, each fg on row_bg.
                    Example: row_set("sel", 239, base_fg, 173, 74, 214, 246)."""
                    attrs[prefix] = pair(base, row_bg)
                    attrs[prefix + "_cc"] = pair(cc, row_bg) | curses.A_BOLD
                    attrs[prefix + "_cx"] = pair(cx, row_bg) | curses.A_BOLD
                    attrs[prefix + "_star"] = pair(star, row_bg) | curses.A_BOLD
                    attrs[prefix + "_dim"] = pair(dim, row_bg)

                stripe = self.stripe(curses.COLORS)
                if palette is None:
                    attrs["cc"] = pair(curses.COLOR_GREEN, bg) | curses.A_BOLD
                    attrs["cx"] = pair(curses.COLOR_MAGENTA, bg) | curses.A_BOLD
                    attrs["user"] = pair(curses.COLOR_GREEN, bg) | curses.A_BOLD
                    attrs["asst"] = pair(curses.COLOR_CYAN, bg) | curses.A_BOLD
                    attrs["hl"] = pair(curses.COLOR_BLACK, curses.COLOR_YELLOW)
                    attrs["tool"] = pair(curses.COLOR_YELLOW, bg)
                    attrs["head"] = pair(curses.COLOR_WHITE, curses.COLOR_BLUE) | curses.A_BOLD
                    attrs["code"] = pair(curses.COLOR_CYAN, bg)
                    attrs["star"] = pair(curses.COLOR_YELLOW, bg) | curses.A_BOLD
                    # Shaded variants for every other session-list row, so long rows are easy
                    # to follow across a wide screen.
                    if stripe is not None:
                        row_set("stripe", stripe, fg, curses.COLOR_GREEN, curses.COLOR_MAGENTA,
                                curses.COLOR_YELLOW, fg)
                        attrs["stripe_dim"] |= curses.A_DIM
                else:
                    p = palette
                    secondary = pair(p["secondary"], bg)
                    attrs["cc"] = pair(p["brand"], bg) | curses.A_BOLD
                    attrs["cx"] = pair(p["codex"], bg) | curses.A_BOLD
                    attrs["user"] = curses.A_BOLD
                    attrs["asst"] = attrs["cc"]
                    attrs["title"] = curses.A_BOLD
                    attrs["meta"] = attrs["dim"] = attrs["result"] = secondary
                    attrs["tool"] = pair(p["tool"], bg)
                    attrs["star"] = pair(p["star"], bg) | curses.A_BOLD
                    attrs["hl"] = pair(p["hl_fg"], p["hl_bg"])
                    attrs["head"] = pair(fg, p["head_bg"]) | curses.A_BOLD
                    attrs["prompt"] = pair(fg, p["prompt_bg"])
                    attrs["code"] = pair(p["code"], bg)
                    attrs["quote"] = secondary | (italic if has_italic else 0)
                    if stripe is not None:
                        row_set("stripe", stripe, fg, p["brand"], p["codex"], p["star"], p["secondary"])
                    row_set("sel", p["select_bg"], p["select_fg"], p["brand"], p["codex"],
                            p["star"], p["secondary"])
                    attrs["sel"] |= curses.A_BOLD
        except curses.error:
            pass
        # Without a stripe color, odd rows look like the even ones.
        attrs.setdefault("stripe", 0)
        for name in ("cc", "cx", "star", "dim"):
            attrs.setdefault("stripe_" + name, attrs[name])
        # The basic theme (and any failure above) marks the selected row with reverse video.
        attrs.setdefault("sel", curses.A_REVERSE)
        for name in ("cc", "cx", "star", "dim"):
            attrs.setdefault("sel_" + name, attrs[name] | curses.A_REVERSE)
        return attrs


class StarStore(object):
    """The starred sessions, kept in stars.json in the data directory.

    Stars are user data (not cache), so write errors are raised. Paths are computed from
    the environment on every call, never stored, so a changed XDG_DATA_HOME is honored.
    """

    VERSION = 1  # format version of stars.json

    def path(self) -> str:
        """Location of the starred-sessions file: $XDG_DATA_HOME (default ~/.local/share) /
        ai-sessions / stars.json. Stars are user data, so they live in the data dir, not the cache.

        Returns:
            The absolute path of the stars file.

        Example: with XDG_DATA_HOME=/d -> "/d/ai-sessions/stars.json"
        """
        base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
        return os.path.join(base, "ai-sessions", "stars.json")

    def read(self) -> Dict[str, float]:
        """Read the starred sessions from self.path().

        Returns:
            A dict mapping session id -> epoch seconds when it was starred. It is empty if the file
            is missing, unreadable, corrupt or of another version; entries whose value is not a
            number are skipped.

        Example: file {"version": 1, "stars": {"a1": 1700000000, "b2": "x"}} -> {"a1": 1700000000.0};
        no file -> {}
        """
        try:
            with open(self.path(), encoding="utf-8") as f:
                data = json.load(f)
        except (OSError, ValueError):
            return {}
        if not isinstance(data, dict) or data.get("version") != self.VERSION \
                or not isinstance(data.get("stars"), dict):
            return {}
        stars: Dict[str, float] = {}
        for sid, when in data["stars"].items():
            if isinstance(when, (int, float)) and not isinstance(when, bool):
                stars[str(sid)] = float(when)
        return stars

    def write(self, stars: Dict[str, float]) -> None:
        """Atomically write the starred sessions (temp file + rename) to self.path().

        Unlike the index cache, stars are user data, so failures are not swallowed.

        Args:
            stars: Session id -> epoch seconds when it was starred.

        Returns:
            None.

        Raises:
            OSError: If the directory or file cannot be written (a failed temp file is removed).

        Example: StarStore().write({"a1": 1700000000.0}) leaves
        {"version": 1, "stars": {"a1": 1700000000.0}} in $XDG_DATA_HOME/ai-sessions/stars.json.
        """
        sp = self.path()
        os.makedirs(os.path.dirname(sp), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(sp), prefix=".stars-", suffix=".tmp")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump({"version": self.VERSION, "stars": stars}, f, indent=1, sort_keys=True)
                f.write("\n")
            os.replace(tmp, sp)
        except (OSError, TypeError, ValueError) as e:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise OSError(str(e))

    def set(self, sid: str, on: bool) -> None:
        """Star (on=True) or unstar (on=False) session sid.

        The file is re-read right before writing, so stars changed meanwhile by another process
        (the CLI or a skill, while the TUI is open) are not overwritten. Starring an already
        starred session keeps its original timestamp.

        Args:
            sid: The full session id.
            on: True to star, False to unstar.

        Returns:
            None.

        Raises:
            OSError: If stars.json cannot be written.

        Example: set("a1", True) -> read() has "a1"; set("a1", False) -> it does not.
        """
        stars = self.read()
        if on:
            stars.setdefault(sid, time.time())
        else:
            stars.pop(sid, None)
        self.write(stars)


STARS = StarStore()


class SessionIndex(object):
    """The summary index of all sessions, plus an in-memory cache of parsed transcripts.

    Paths come from the environment on every call, never from __init__, so a changed
    XDG_CACHE_HOME or AI_SESSIONS_*_DIR is honored.
    """

    def __init__(self) -> None:
        # LRU cache of fully parsed transcripts (they are not stored in the index), keyed by
        # (path, mtime) so a transcript that is still being written is re-read.
        self.parsed: "collections.OrderedDict[Tuple[str, float], List[Msg]]" = \
            collections.OrderedDict()

    def path(self) -> str:
        """Location of the summary index: $XDG_CACHE_HOME (default ~/.cache) / ai-sessions / index.json.

        Returns:
            The absolute path of the index file.

        Example: with XDG_CACHE_HOME=/c -> "/c/ai-sessions/index.json"
        """
        base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
        return os.path.join(base, "ai-sessions", "index.json")

    def read_cache(self, cp: str) -> Dict[str, Any]:
        """Read the per-file entries of the summary index.

        Args:
            cp: Path of index.json (see path()).

        Returns:
            The "files" mapping (transcript path -> entry); {} if the file is missing, corrupt, or
            written by another INDEX_VERSION.

        Example: a missing file -> {}
        """
        try:
            with open(cp, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict) and data.get("version") == INDEX_VERSION:
                return data.get("files") or {}
        except (OSError, ValueError):
            pass
        return {}

    def write_cache(self, cp: str, files: Dict[str, Any]) -> None:
        """Atomically write the summary index (temp file + rename); failures are ignored.

        Args:
            cp: Path of index.json; its directory is created if needed.
            files: The transcript path -> entry mapping to store.

        Returns:
            None. The cache is only an optimization, so I/O errors are swallowed.

        Example: write_cache("/c/ai-sessions/index.json", {}) leaves
        {"version": INDEX_VERSION, "files": {}} in that file.
        """
        try:
            os.makedirs(os.path.dirname(cp), exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(cp), prefix=".index-", suffix=".tmp")
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump({"version": INDEX_VERSION, "files": files}, f)
            os.replace(tmp, cp)
        except (OSError, TypeError, ValueError):
            pass

    def load(self, progress: bool = False) -> List[Session]:
        """Return all sessions that have at least one user/assistant message.

        Parsing every transcript on each start would be slow, so summaries are cached in
        $XDG_CACHE_HOME/ai-sessions/index.json, keyed by file path. An entry is reused only
        if the file's mtime and size and the source (claude/codex) are unchanged; otherwise
        the file is re-parsed. Entries for files that vanished are pruned, but only under
        the roots scanned this run, so pointing AI_SESSIONS_*_DIR elsewhere temporarily does
        not discard the cache for the real dirs. The cache is rewritten atomically
        (temp file + rename) and only when something changed. A cache from another
        INDEX_VERSION, or a corrupt one, is ignored.

        Codex titles from session_index.jsonl are applied here at load time, after the
        cache, rather than stored in it: that file changes independently of the rollouts,
        so caching its names would leave them stale. Stars (stars.json, see StarStore.read()) are
        applied the same way: read once per call and set as Session.starred.

        Args:
            progress: If True, print an "indexing N file(s)" notice to stderr when files need parsing.

        Returns:
            A list of Session objects (unsorted), omitting sessions with no user or assistant messages.

        Example: with one Claude transcript (user + assistant message) under
        AI_SESSIONS_CLAUDE_DIR and an empty cache -> [Session(source="claude", ...)], and
        index.json now holds its summary; a second call re-parses nothing.
        """
        cp = self.path()
        cache = self.read_cache(cp)
        found = discover()
        seen = set()
        result: List[Session] = []
        dirty = False
        todo: List[Tuple[str, str, os.stat_result]] = []
        entries: Dict[str, Dict[str, Any]] = {}
        for source, path in found:
            try:
                st = os.stat(path)
            except OSError:
                continue
            seen.add(path)
            e = cache.get(path)
            if isinstance(e, dict) and e.get("mtime") == st.st_mtime and e.get("size") == st.st_size \
                    and isinstance(e.get("summary"), dict) and e["summary"].get("source") == source:
                entries[path] = e
            else:
                todo.append((source, path, st))
        if todo and progress:
            sys.stderr.write("ai-sessions: indexing %d file(s)...\n" % len(todo))
        for source, path, st in todo:
            try:
                summary, _ = parse_any(source, path)
            except Exception:  # never let one bad file break the browser
                continue
            entries[path] = {"mtime": st.st_mtime, "size": st.st_size, "summary": summary}
            dirty = True
        roots = tuple(s.scan_root() for s in SOURCE_LIST)
        merged = dict(cache)
        merged.update(entries)
        for p in list(merged):
            if p not in seen and p.startswith(roots):
                del merged[p]
                dirty = True
        if dirty:
            self.write_cache(cp, merged)
        titles: Dict[str, Dict[str, str]] = {s.key: s.title_overrides() for s in SOURCE_LIST}
        stars = STARS.read()
        for entry in entries.values():
            summary = dict(entry["summary"])
            override = titles.get(summary["source"], {}).get(summary["id"])
            if override is not None:
                summary["title"] = override
            if summary["n_user"] + summary["n_asst"] == 0:
                continue
            summary["starred"] = summary["id"] in stars
            result.append(Session(summary))
        return result

    def transcript(self, s: Session) -> List[Msg]:
        """Messages of a session, parsed on demand and kept in a small LRU cache.

        Args:
            s: The session whose transcript file to parse.

        Returns:
            The list of Msg dicts; [] if the file cannot be parsed.

        Example: transcript(s) parses s.path and returns [{"role": "user", "text": "fix the
        bug", "ts": 1.7e9}, ...]; calling it again with the file unchanged returns the cached list.
        """
        try:
            mt = os.stat(s.path).st_mtime
        except OSError:
            mt = 0
        k = (s.path, mt)
        if k in self.parsed:
            self.parsed.move_to_end(k)
            return self.parsed[k]
        try:
            _, msgs = parse_any(s.source, s.path)
        except Exception:
            msgs = []
        self.parsed[k] = msgs
        while len(self.parsed) > TRANSCRIPT_CACHE_SIZE:
            self.parsed.popitem(last=False)
        return msgs


INDEX = SessionIndex()


class SessionFilter(object):
    """Which sessions the list shows and in what order: a search query, a source, a project,
    a starred-only switch, and a sort mode."""

    def __init__(self, query: str = "", source: str = "all", project: Optional[str] = None,
                 starred_only: bool = False, sort: str = "last") -> None:
        """
        Args:
            query: Whitespace-separated terms; all must match. "" matches everything.
            source: "all", "claude" or "codex".
            project: Exact working directory to require, or None for any.
            starred_only: True to keep only starred sessions.
            sort: "last" sorts by last activity; any other value sorts by start time.

        Example: SessionFilter("fix", "claude") -> .query == "fix", .project is None, .sort == "last"
        """
        self.query = query
        self.source = source
        self.project = project
        self.starred_only = starred_only
        self.sort = sort

    def terms(self) -> List[str]:
        """The query's lowercase search terms.

        Example: SessionFilter("Foo  BAR").terms() -> ["foo", "bar"]
        """
        return terms_of(self.query)

    def regex(self) -> Optional[Pattern[str]]:
        """A regex matching any query term (for highlighting), or None when there are none.

        Example: SessionFilter("fo foobar").regex().pattern -> "foobar|fo"; SessionFilter().regex() -> None
        """
        return term_regex(self.terms())

    def matches(self, s: Session, terms: Optional[List[str]] = None) -> bool:
        """Whether one session passes the source, project, starred and query filters.

        The query terms must all appear (case-insensitive substring) in the session's title,
        project, cwd or transcript text.

        Args:
            s: The session to test.
            terms: Precomputed self.terms(), to avoid recomputing them per session; None to compute.

        Returns:
            True if the session should be listed.

        Examples (A = claude "Fix bug" in /work/proj, B = codex "Add tests" in /work/other):
            SessionFilter("fix").matches(A) -> True; SessionFilter("fix").matches(B) -> False
            SessionFilter(source="codex").matches(A) -> False
        """
        if self.source != "all" and s.source != self.source:
            return False
        if self.project is not None and s.cwd != self.project:
            return False
        if self.starred_only and not s.starred:
            return False
        if terms is None:
            terms = self.terms()
        if terms and not all(t in s.search_text for t in terms):
            return False
        return True

    def select(self, sessions: List[Session]) -> List[Session]:
        """The sessions that match, in their original order.

        Args:
            sessions: The sessions to filter.

        Returns:
            The matching sessions.

        Examples (A = claude "Fix bug" in /work/proj, B = codex "Add tests" in /work/other):
            SessionFilter("fix").select([A, B]) -> [A]
            SessionFilter(source="codex").select([A, B]) -> [B]
            SessionFilter(project="/work/proj").select([A, B]) -> [A]
            SessionFilter(starred_only=True).select([A, B]) -> [B] if only B is starred
        """
        terms = self.terms()
        return [s for s in sessions if self.matches(s, terms)]

    def sorted(self, sessions: List[Session]) -> List[Session]:
        """Newest first, by last activity (sort "last") or by start time (any other sort).

        Args:
            sessions: The sessions to sort.

        Returns:
            A new list, newest first.

        Example: A(first_ts=1, last_ts=2), B(first_ts=5, last_ts=3):
            SessionFilter().sorted([A, B]) -> [B, A]; SessionFilter(sort="start").sorted([A, B]) -> [B, A]
            with B(first_ts=0, last_ts=3): SessionFilter(sort="start").sorted([A, B]) -> [A, B]
        """
        key: Callable[[Session], float] = (
            (lambda s: s.last_ts) if self.sort == "last" else (lambda s: s.first_ts))
        return sorted(sessions, key=key, reverse=True)

    def apply(self, sessions: List[Session]) -> List[Session]:
        """The matching sessions, sorted: self.sorted(self.select(sessions)).

        Example: SessionFilter("fix").apply([A, B]) -> [A] (B filtered out, the rest sorted)
        """
        return self.sorted(self.select(sessions))

    def describe(self) -> List[str]:
        """The active filters as short header-bar parts, in a fixed order.

        Returns:
            Parts such as ["source=Codex", "project=proj", "starred", "/fix"]; [] with no filters.

        Examples:
            SessionFilter() -> []
            SessionFilter("fix", "claude", "/work/proj") -> ["source=Claude Code", "project=proj", "/fix"]
            SessionFilter("fix", starred_only=True) -> ["starred", "/fix"]
        """
        parts: List[str] = []
        if self.source != "all":
            parts.append("source=" + SOURCES[self.source].label)
        if self.project is not None:
            parts.append("project=" + (os.path.basename(self.project.rstrip("/")) or "-"))
        if self.starred_only:
            parts.append("starred")
        if self.query:
            parts.append("/" + self.query)
        return parts


# ---------------------------------------------------------------- markdown

class MarkdownRenderer(object):
    """Turns assistant Markdown into transcript Lines of a given width: block structure
    (headings, lists, quotes, fences, tables, rules) plus inline styles as spans.

    The block level (`blocks`, `table_lines`) lays rows out at `self.width`; the inline level
    (`parse_inline`, `wrap_segments` and their helpers) does not depend on it and is static.

    Attributes:
        width: Body width in display columns (at least 4).

    Example: MarkdownRenderer.lines("hi **there**", 40, "  ") ->
        [("  hi there", "text", ((5, 10, "bold"),))]
    """

    # Characters a backslash can escape in inline text.
    ESCAPABLE = "\\`*_[]()#|<>"
    AUTOLINK = re.compile(r"<(https?://[^\s<>]+)>")
    FENCE = re.compile(r"^(\s*)(`{3,}|~{3,})(.*)$")
    HEADING = re.compile(r"^ {0,3}(#{1,6})\s+(.+?)(?:\s+#+)?\s*$")
    HRULE = re.compile(r"^ {0,3}([-*_])(\s*\1){2,}\s*$")
    BULLET = re.compile(r"^(\s*)[-*+]\s+(.*)$")
    ORDERED = re.compile(r"^(\s*)(\d{1,9}[.)])\s+(.*)$")
    QUOTE = re.compile(r"^ {0,3}> ?")
    TABLE_SEP = re.compile(r"^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$")

    def __init__(self, width: int) -> None:
        """Create a renderer for rows `width` columns wide.

        Args:
            width: Display width for the rows; values under 4 are raised to 4.

        Example: MarkdownRenderer(2).width -> 4
        """
        self.width = max(width, 4)

    @classmethod
    def lines(cls, text: str, width: int, prefix: str = "") -> List[Line]:
        """Render Markdown text (an assistant reply) into transcript rows with inline spans.

        Markers are removed and the layout kept: headings ("heading"), fenced code ("code", verbatim,
        hard-wrapped, indented 2 more), bullet / ordered lists with hanging indents, block quotes
        ("quote", marked with a bar), horizontal rules ("dim"), box-drawn tables ("table") and
        paragraphs ("text") whose **bold**, *italic*, `code` and [link](url) markup becomes spans.
        Single newlines stay line breaks and blank-line runs collapse to one.

        Args:
            text: The Markdown source.
            width: Total display width in columns, including prefix (at least len(prefix) + 4).
            prefix: Plain text put before every non-blank row (the body indent), e.g. "  ".

        Returns:
            Line tuples (row text, kind, spans); spans are character offsets into the row text.

        Examples:
            MarkdownRenderer.lines("hi **there**", 40, "  ") ->
                [("  hi there", "text", ((5, 10, "bold"),))]
            MarkdownRenderer.lines("# T\\n- a", 40, "  ") ->
                [("  T", "heading", ()), ("  • a", "text", ())]
        """
        rows = cls(max(width - len(prefix), 4)).blocks(clean(text).split("\n"))
        return [((prefix + t, k, tuple((a + len(prefix), b + len(prefix), s) for a, b, s in sp))
                 if t else ("", k, ())) for t, k, sp in rows]

    def blocks(self, lines: List[str]) -> List[Line]:
        """Render Markdown source lines into rows (no outer prefix), `self.width` columns wide.

        Blocks: fenced code, ATX headings, tables, horizontal rules, block quotes, bullet and
        ordered lists, and paragraphs (each source line stays its own line). Blank-line runs
        collapse to one and leading/trailing blanks are dropped. See `lines`.

        Args:
            lines: Source lines (already sanitized with clean()).

        Returns:
            The rows as Line tuples.

        Example: MarkdownRenderer(20).blocks(["# Hi", "- a"]) ->
            [("Hi", "heading", ()), ("• a", "text", ())]
        """
        bullet, bar = markdown_glyphs()
        out: List[Line] = []
        levels: List[int] = []   # source indents of the open list nesting levels
        i, n = 0, len(lines)

        def add_wrapped(segs: List[Seg], kind: str, first: str, rest: str) -> None:
            for k, (t, sp) in enumerate(self.wrap_segments(segs, self.width - len(rest))):
                lead = first if k == 0 else rest
                out.append((lead + t, kind, tuple((a + len(lead), b + len(lead), s) for a, b, s in sp)))

        while i < n:
            raw = lines[i].rstrip()
            if not raw.strip():
                if out and out[-1][0] != "":
                    out.append(("", "text", ()))
                i += 1
                continue
            fence = self.FENCE.match(raw)
            heading = self.HEADING.match(raw)
            if fence and not (fence.group(2)[0] == "`" and "`" in fence.group(3)):
                levels = []
                indent, mark = len(fence.group(1)), fence.group(2)
                i += 1
                while i < n:
                    st = lines[i].strip()
                    if st and set(st) == {mark[0]} and len(st) >= len(mark):
                        i += 1
                        break
                    body = lines[i].rstrip()
                    lead = len(body) - len(body.lstrip(" "))
                    for chunk in self._hard_wrap(body[min(lead, indent):], self.width - 2):
                        out.append(("  " + chunk if chunk else "", "code", ()))
                    i += 1
            elif heading:
                levels = []
                if out and out[-1][0] != "":
                    out.append(("", "text", ()))
                add_wrapped(self.parse_inline(heading.group(2)), "heading", "", "")
                i += 1
            elif ("|" in raw and i + 1 < n and "|" in lines[i + 1]
                  and self.TABLE_SEP.match(lines[i + 1].rstrip())
                  and len(self._split_table_row(raw)) == len(self._split_table_row(lines[i + 1]))):
                levels = []
                seps = self._split_table_row(lines[i + 1])
                aligns = ["center" if s.startswith(":") and s.endswith(":") else
                          "right" if s.endswith(":") else "left" for s in seps]
                header = self._split_table_row(raw)
                rows: List[List[str]] = []
                i += 2
                while i < n and lines[i].strip() and "|" in lines[i]:
                    rows.append(self._split_table_row(lines[i]))
                    i += 1
                out.extend(self.table_lines(header, aligns, rows))
            elif self.HRULE.match(raw):
                levels = []
                out.append((rule_chars()[0] * self.width, "dim", ()))
                i += 1
            elif self.QUOTE.match(raw):
                levels = []
                inner: List[str] = []
                while i < n and self.QUOTE.match(lines[i]):
                    inner.append(self.QUOTE.sub("", lines[i], count=1))
                    i += 1
                for t, kind, sp in MarkdownRenderer(self.width - 2).blocks(inner):
                    lead = bar + " " if t else bar
                    if kind == "text":
                        kind = "quote"
                    out.append((lead + t, kind, tuple((a + len(lead), b + len(lead), s)
                                                      for a, b, s in sp)))
            elif self.BULLET.match(raw) or self.ORDERED.match(raw):
                mb, mo = self.BULLET.match(raw), self.ORDERED.match(raw)
                src_indent = len((mb or mo).group(1))  # type: ignore
                while levels and levels[-1] > src_indent:
                    levels.pop()
                if not levels or levels[-1] < src_indent:
                    levels.append(src_indent)
                marker = (bullet if mb else mo.group(2)) + " "  # type: ignore
                content = (mb.group(2) if mb else mo.group(3))  # type: ignore
                pad = "  " * (len(levels) - 1)
                add_wrapped(self.parse_inline(content), "text", pad + marker, pad + " " * len(marker))
                i += 1
            else:
                levels = []
                add_wrapped(self.parse_inline(raw), "text", "", "")
                i += 1
        while out and out[-1][0] == "":
            out.pop()
        return out

    def table_lines(self, header: List[str], aligns: List[str],
                    body: List[List[str]]) -> List[Line]:
        """Lay out a table as box-drawn "table" rows, all the same display width.

        Column widths come from the rendered (marker-stripped) cell text. When the table is wider
        than `self.width`, the widest columns shrink (to at least 3, then 1 columns) and cell text wraps
        onto several rows inside its cell. Header cells are bold, borders are "dim" spans and
        columns honour the alignment ("left", "center" or "right").

        Args:
            header: Header cell source strings.
            aligns: One alignment per column.
            body: Body rows of cell source strings (padded or cut to the header's length).
        Returns:
            The rows: top border, header, rule, body rows, bottom border.

        Example: MarkdownRenderer(40).table_lines(["a", "b"], ["left", "left"], [["1", "2"]]) ->
            "┌───┬───┐", "│ a │ b │", "├───┼───┤", "│ 1 │ 2 │", "└───┴───┘"
        """
        ncols = len(header)
        utf8 = utf8_locale()
        h, v = ("─", "│") if utf8 else ("-", "|")
        corners = ("┌┬┐", "├┼┤", "└┴┘") if utf8 else ("+++", "+++", "+++")

        def cells_of(row: List[str], bold: bool) -> List[List[Seg]]:
            row = (row + [""] * ncols)[:ncols]
            return [[(t, st + ("bold",)) if bold else (t, st) for t, st in self.parse_inline(c)]
                    for c in row]

        grid = [cells_of(header, True)] + [cells_of(r, False) for r in body]
        colw = [max(1, max(str_width(self.segs_text(r[c])) for r in grid)) for c in range(ncols)]
        minw = 3
        while sum(colw) + 3 * ncols + 1 > self.width:
            widest = max(range(ncols), key=lambda c: colw[c])
            if colw[widest] > minw:
                colw[widest] -= 1
            elif minw > 1:
                minw = 1
            else:
                break

        def border(kind: Tuple[str, str, str]) -> Line:
            text = kind[0] + kind[1].join(h * (w + 2) for w in colw) + kind[2]
            return (text, "table", ((0, len(text), "dim"),))

        def row_lines(row: List[List[Seg]]) -> List[Line]:
            wrapped = [self.wrap_segments(row[c], colw[c]) for c in range(ncols)]
            out: List[Line] = []
            for k in range(max(len(w) for w in wrapped)):
                text = v
                spans: List[Span] = [(0, 1, "dim")]
                for c in range(ncols):
                    ct, cs = wrapped[c][k] if k < len(wrapped[c]) else ("", ())
                    gap = max(colw[c] - str_width(ct), 0)
                    left = {"right": gap, "center": gap // 2}.get(aligns[c], 0)
                    text += " " + " " * left
                    spans.extend((a + len(text), b + len(text), s) for a, b, s in cs)
                    text += ct + " " * (gap - left) + " "
                    spans.append((len(text), len(text) + 1, "dim"))
                    text += v
                out.append((text, "table", tuple(spans)))
            return out

        out = [border(corners[0])]
        out.extend(row_lines(grid[0]))
        out.append(border(corners[1]))
        for r in grid[1:]:
            out.extend(row_lines(r))
        out.append(border(corners[2]))
        return out

    @staticmethod
    def _code_run_end(text: str, start: int, n: int) -> int:
        """Index of the first run of exactly n backticks at or after start, or -1.

        Example: _code_run_end("a `b` c", 3, 1) -> 4
        """
        j = start
        while True:
            j = text.find("`" * n, j)
            if j < 0:
                return -1
            k = j
            while k < len(text) and text[k] == "`":
                k += 1
            if k - j == n:
                return j
            j = k


    @staticmethod
    def _run_end(text: str, start: int) -> int:
        """Index just past the run of identical characters beginning at start.

        Example: _run_end("a**b", 1) -> 3
        """
        k = start
        while k < len(text) and text[k] == text[start]:
            k += 1
        return k


    @staticmethod
    def _find_closer(text: str, start: int, ch: str, n: int) -> int:
        """Find the closing emphasis delimiter (a run of exactly n `ch`) at or after start.

        Skips code spans and backslash escapes. A closer must follow non-space text and, for "_",
        must not be followed by a letter or digit (so snake_case_names stay literal).

        Args:
            text: The inline text.
            start: Index just after the opening delimiter.
            ch: "*" or "_".
            n: Length of the opening delimiter run (1, 2 or 3).

        Returns:
            The index of the closing run, or -1 if there is none.

        Example: _find_closer("a b* c", 0, "*", 1) -> 3; _find_closer("a * b", 0, "*", 1) -> -1
        """
        j, size = start, len(text)
        while j < size:
            c = text[j]
            if c == "\\":
                j += 2
            elif c == "`":
                k = MarkdownRenderer._run_end(text, j)
                e = MarkdownRenderer._code_run_end(text, k, k - j)
                j = k if e < 0 else e + (k - j)
            elif c == ch:
                k = MarkdownRenderer._run_end(text, j)
                if (k - j == n and j > start and not text[j - 1].isspace()
                        and (ch == "*" or k >= size or not text[k].isalnum())):
                    return j
                j = k
            else:
                j += 1
        return -1


    @staticmethod
    def _match_link(text: str, i: int) -> Optional[Tuple[str, str, int]]:
        """Match an inline link "[label](url)" starting at text[i] == "[".

        Returns:
            (label, url, end_index) or None when text[i:] is not a link. A title after the url
            ("[a](u "t")") is dropped.

        Example: _match_link("[a](http://x) y", 0) -> ("a", "http://x", 13)
        """
        size, depth, j = len(text), 0, i
        while j < size:
            c = text[j]
            if c == "\\":
                j += 2
                continue
            if c == "[":
                depth += 1
            elif c == "]":
                depth -= 1
                if depth == 0:
                    break
            j += 1
        if j >= size or j + 1 >= size or text[j + 1] != "(":
            return None
        depth, k = 1, j + 2
        while k < size:
            if text[k] == "(":
                depth += 1
            elif text[k] == ")":
                depth -= 1
                if depth == 0:
                    break
            k += 1
        if k >= size:
            return None
        inner = text[j + 2:k].strip()
        return text[i + 1:j], (inner.split(" ")[0] if inner else ""), k + 1


    @staticmethod
    def _merge_segs(segs: List[Seg]) -> List[Seg]:
        """Drop empty segments and join neighbours that have the same styles.

        Example: [("a", ()), ("b", ()), ("", ("bold",))] -> [("ab", ())]
        """
        out: List[Seg] = []
        for t, st in segs:
            if not t:
                continue
            if out and out[-1][1] == st:
                out[-1] = (out[-1][0] + t, st)
            else:
                out.append((t, st))
        return out


    @staticmethod
    def parse_inline(text: str, styles: Tuple[str, ...] = ()) -> List[Seg]:
        """Parse inline Markdown into styled segments with the markers removed.

        Handles `code` (any backtick run length, literal content), **bold** / __bold__,
        *italic* / _italic_ (underscores only at word boundaries), ***both***, [text](url)
        (text styled "link" then " (url)" styled "dim" unless url == text), <https://autolinks>
        and backslash escapes. Unmatched markers stay literal. Styles may nest.

        Args:
            text: One line of text (no newlines needed).
            styles: Styles applied to everything in text (used for recursion).

        Returns:
            A list of (text, styles) segments with no empty or mergeable neighbours.

        Examples:
            parse_inline("a **b** c") -> [("a ", ()), ("b", ("bold",)), (" c", ())]
            parse_inline("snake_case_name and 2 * 3") -> [("snake_case_name and 2 * 3", ())]
            parse_inline("[x](http://u)") -> [("x", ("link",)), (" (http://u)", ("dim",))]
        """
        segs: List[Seg] = []
        buf: List[str] = []

        def flush() -> None:
            if buf:
                segs.append(("".join(buf), styles))
                del buf[:]

        i, size = 0, len(text)
        while i < size:
            c = text[i]
            if c == "\\" and i + 1 < size and text[i + 1] in MarkdownRenderer.ESCAPABLE:
                buf.append(text[i + 1])
                i += 2
            elif c == "`":
                k = MarkdownRenderer._run_end(text, i)
                e = MarkdownRenderer._code_run_end(text, k, k - i)
                if e < 0:
                    buf.append(text[i:k])
                    i = k
                    continue
                inner = text[k:e]
                if len(inner) > 2 and inner[0] == " " and inner[-1] == " " and inner.strip():
                    inner = inner[1:-1]
                flush()
                segs.append((inner, styles + ("code",)))
                i = e + (k - i)
            elif c == "[":
                link = MarkdownRenderer._match_link(text, i)
                if link is None:
                    buf.append(c)
                    i += 1
                    continue
                label, url, end = link
                flush()
                segs.extend(MarkdownRenderer.parse_inline(label, styles + ("link",)))
                if url and url != label:
                    segs.append((" (%s)" % url, styles + ("dim",)))
                i = end
            elif c == "<" and MarkdownRenderer.AUTOLINK.match(text, i):
                m = MarkdownRenderer.AUTOLINK.match(text, i)
                assert m is not None
                flush()
                segs.append((m.group(1), styles + ("link",)))
                i = m.end()
            elif c in "*_":
                k = MarkdownRenderer._run_end(text, i)
                n = k - i
                if (n <= 3 and k < size and not text[k].isspace()
                        and (c == "*" or i == 0 or not text[i - 1].isalnum())):
                    e = MarkdownRenderer._find_closer(text, k, c, n)
                    if e >= 0:
                        flush()
                        added = {1: ("italic",), 2: ("bold",), 3: ("bold", "italic")}[n]
                        segs.extend(MarkdownRenderer.parse_inline(text[k:e], styles + added))
                        i = e + n
                        continue
                buf.append(text[i:k])
                i = k
            else:
                buf.append(c)
                i += 1
        flush()
        return MarkdownRenderer._merge_segs(segs)


    @staticmethod
    def segs_text(segs: List[Seg]) -> str:
        """The plain text of styled segments.

        Example: segs_text([("a ", ()), ("b", ("bold",))]) -> "a b"
        """
        return "".join(t for t, _ in segs)


    @staticmethod
    def _pairs_to_row(pairs: Pairs) -> Tuple[str, Tuple[Span, ...]]:
        """Turn (char, styles) pairs into row text plus spans (one span per style run).

        Example: [("a", ()), ("b", ("bold",)), ("c", ("bold",))] -> ("abc", ((1, 3, "bold"),))
        """
        spans: List[Span] = []
        opened: Dict[str, int] = {}
        for i, (_, st) in enumerate(pairs):
            for name in list(opened):
                if name not in st:
                    spans.append((opened.pop(name), i, name))
            for name in st:
                if name not in opened:
                    opened[name] = i
        for name, start in opened.items():
            spans.append((start, len(pairs), name))
        spans.sort()
        return "".join(c for c, _ in pairs), tuple(spans)


    @staticmethod
    def wrap_segments(segs: List[Seg], width: int) -> List[Tuple[str, Tuple[Span, ...]]]:
        """Word-wrap styled text to a display width, keeping each character's styles.

        Like wrap() for a single line: a line that fits is kept as is (minus trailing spaces);
        otherwise runs of spaces collapse to one, continuation lines keep the leading indent (up to
        half the width) and over-long words are split by display width (wide chars count 2).

        Args:
            segs: The styled text, as from parse_inline (no newlines).
            width: Display width in columns (at least 1).

        Returns:
            A list of (row text, spans) pairs; never empty ([("", ())] for empty input).

        Example: wrap_segments([("aa ", ()), ("bb", ("bold",))], 2) -> [("aa", ()), ("bb", ((0, 2, "bold"),))]
        """
        width = max(width, 1)
        pairs: Pairs = [(ch, st) for t, st in segs for ch in t]
        while pairs and pairs[-1][0] == " ":
            pairs.pop()
        if not pairs:
            return [("", ())]
        if sum(char_width(c) for c, _ in pairs) <= width:
            return [MarkdownRenderer._pairs_to_row(pairs)]
        lead = 0
        while lead < len(pairs) and pairs[lead][0] == " ":
            lead += 1
        indent = min(lead, width // 2)
        # Split into (gap space, word) items.
        items: List[Tuple[Optional[Tuple[str, Tuple[str, ...]]], Pairs]] = []
        gap: Optional[Tuple[str, Tuple[str, ...]]] = None
        word: Pairs = []
        for p in pairs[lead:] + [(" ", ())]:
            if p[0] == " ":
                if word:
                    items.append((gap, word))
                    word = []
                    gap = None
                if gap is None:
                    gap = p
            else:
                word.append(p)
        pad: Pairs = [(" ", ())] * indent
        rows: List[Pairs] = []
        cur: Pairs = list(pad)
        curw = indent
        has_word = False
        for gap_p, word in items:
            ww = sum(char_width(c) for c, _ in word)
            if has_word and gap_p is not None and curw + 1 + ww <= width:
                cur += [gap_p] + word
                curw += 1 + ww
                continue
            if not has_word and curw + ww <= width:
                cur += word
                curw += ww
                has_word = True
                continue
            if has_word:
                rows.append(cur)
                cur, curw, has_word = list(pad), indent, False
            for p in word:   # a word that does not fit on a line of its own is split
                cw = char_width(p[0])
                if has_word and curw + cw > width:
                    rows.append(cur)
                    cur, curw, has_word = list(pad), indent, False
                cur.append(p)
                curw += cw
                has_word = True
        if has_word:
            rows.append(cur)
        return [MarkdownRenderer._pairs_to_row(r) for r in rows]


    @staticmethod
    def _hard_wrap(s: str, width: int) -> List[str]:
        """Split s into chunks of at most width display columns (no word handling).

        Example: _hard_wrap("abcdef", 4) -> ["abcd", "ef"]; _hard_wrap("", 4) -> [""]
        """
        width = max(width, 1)
        chunks: List[str] = []
        while str_width(s) > width:
            piece = clip(s, width) or s[:1]
            chunks.append(piece)
            s = s[len(piece):]
        chunks.append(s)
        return chunks


    @staticmethod
    def _split_table_row(line: str) -> List[str]:
        """Split a table row into stripped cell strings; leading/trailing pipes are optional and
        "\\|" does not split.

        Example: _split_table_row("| a | b \\| c |") -> ["a", "b \\| c"]
        """
        s = line.strip()
        cells: List[str] = []
        cur: List[str] = []
        j = 0
        while j < len(s):
            if s[j] == "\\" and j + 1 < len(s):
                cur.append(s[j:j + 2])
                j += 2
                continue
            if s[j] == "|":
                cells.append("".join(cur))
                cur = []
            else:
                cur.append(s[j])
            j += 1
        cells.append("".join(cur))
        if s.startswith("|"):
            cells = cells[1:]
        if s.endswith("|") and not s.endswith("\\|"):
            cells = cells[:-1]
        return [c.strip() for c in cells]


# ---------------------------------------------------------------- rendering

def result_preview_lines(text: str, width: int) -> List[Line]:
    """Render a tool result as at most RESULT_PREVIEW_LINES "result" rows plus a "more" note,
    Claude Code style: an elbow before the first row, the rest indented to the same column.

    Args:
        text: The tool result text.
        width: Display width in terminal columns.

    Returns:
        (row, "result", ()) tuples: the first non-blank lines of text (or "(empty)"), each clipped
        to fit, and a final "... (N more lines)" row when some were cut. The first row starts
        with "    ⎿  " (see transcript_glyphs); later rows are indented with spaces.

    Examples:
        result_preview_lines("", 40) -> [("    ⎿  (empty)", "result", ())]
        result_preview_lines("a\\n\\nb", 40) -> [("    ⎿  a", "result", ()), ("       b", "result", ())]
    """
    first = "    %s  " % transcript_glyphs()[1]
    rest = " " * len(first)
    body = [x for x in clean(text).split("\n") if x.strip()] or ["(empty)"]
    shown = [clip(x.rstrip(), width - len(first)) for x in body[:RESULT_PREVIEW_LINES]]
    if len(body) > RESULT_PREVIEW_LINES:
        shown.append("... (%d more lines)" % (len(body) - RESULT_PREVIEW_LINES))
    return [((first if i == 0 else rest) + x, "result", ()) for i, x in enumerate(shown)]


def render(s: Session, msgs: List[Msg], width: int, show_results: bool,
           mine_only: bool = False) -> Tuple[List[Line], int]:
    """Return (lines, body_start) for a session at the given display width.

    lines are (text, kind, spans) tuples, already wrapped/clipped to width. The first
    body_start lines are the header (title, id, dir, branch, dates, counts, rule);
    the transcript body follows. Kinds: title, meta, dim (header); user / asst (speaker
    labels); prompt (body of your own messages); text (other message bodies and blank
    separators and paragraphs); heading, code, quote, table (Markdown blocks in assistant
    replies); tool (calls and slash commands); result (tool output). Assistant replies are
    rendered as Markdown (see MarkdownRenderer.lines) and carry inline style spans; everything else
    has spans (). show_results includes tool results; mine_only keeps only your own input (prompts
    and slash commands).

    Args:
        s: The session, used for the header.
        msgs: Its parsed transcript.
        width: Display width in terminal columns (minimum 10).
        show_results: Include tool results.
        mine_only: Keep only your own prompts and slash commands (default False).

    Returns:
        A (lines, body_start) tuple: lines is a list of (text, kind, spans) rows; body_start is the index
        of the first row after the header.

    Example: for a claude session "Fix bug" (id a1, cwd /work/proj, no branch) with messages
    [user "fix the bug", assistant "ok", tool "Read: /x"], width 40, show_results False ->
    lines (body_start == 6):
        ("Fix bug", "title", ()), ("Claude Code   a1", "meta", ()), ("Dir:     /work/proj", "meta", ()),
        ("Started: ...   Updated: ...", "meta", ()), ("Messages: 1 you, 1 claude", "meta", ()),
        ("────...", "dim", ()), ("", "text", ()), ("You:  10:00", "user", ()),
        ("  fix the bug", "prompt", ()), ("", "text", ()), ("Claude:", "asst", ()),
        ("  ok", "text", ()), ("  ⏺ Read: /x", "tool", ())
    """
    width = max(width, 10)
    lines: List[Line] = []

    def add_wrapped(text: str, kind: str, prefix: str = "") -> None:
        for ln in wrap(text, width - len(prefix)):
            lines.append(((prefix + ln) if ln else "", kind, ()))

    add_wrapped(s.title, "title")
    lines.append(("%s   %s" % (SOURCES[s.source].label, s.id), "meta", ()))
    add_wrapped("Dir:     " + (s.cwd or "-"), "meta")
    if s.branch:
        add_wrapped("Branch:  " + s.branch, "meta")
    lines.append(("Started: %s   Updated: %s" % (fmt_ts(s.first_ts), fmt_ts(s.last_ts)), "meta", ()))
    lines.append(("Messages: %d you, %d %s" % (s.n_user, s.n_asst, SOURCES[s.source].assistant_name.lower()),
                  "meta", ()))
    lines.append((rule_chars()[0] * min(width, 200), "dim", ()))
    body_start = len(lines)
    for msg in msgs:
        role = msg["role"]
        if role == "result" and not show_results:
            continue
        if mine_only and role not in ("user", "cmd"):
            continue
        if role in ("user", "assistant"):
            if lines and lines[-1][0] != "":
                lines.append(("", "text", ()))
            who = "You:" if role == "user" else SOURCES[s.source].assistant_name + ":"
            lines.append((who + ("  " + fmt_ts(msg["ts"], False) if msg.get("ts") else ""),
                          "user" if role == "user" else "asst", ()))
            if role == "user":
                add_wrapped(msg["text"], "prompt", "  ")
            else:
                lines.extend(MarkdownRenderer.lines(msg["text"], width, "  "))
        elif role == "cmd":
            lines.append(("  > " + clip(clean(msg["text"]), width - 4), "tool", ()))
        elif role == "tool":
            lines.append(("  %s " % transcript_glyphs()[0] + clip(clean(msg["text"]), width - 4), "tool", ()))
        elif role == "result":
            lines.extend(result_preview_lines(msg["text"], width))
    return lines, body_start


def hit_lines(lines: List[Line], start: int, terms: List[str]) -> List[int]:
    """Indexes of body lines (from `start`, so never the header) containing any term.

    Args:
        lines: Rendered (text, kind, spans) rows.
        start: Index of the first body row; header rows before it never count.
        terms: Lowercase search terms; a row matches if it contains any of them.

    Returns:
        The indexes of matching rows, in order; [] when terms is empty.

    Example: lines [("Fix bug", "title", ()), ..., ("  fix the bug", "prompt", ())] with start=6 and
    terms ["bug"] -> [8] (the title at index 0 is in the header, so it is not a hit).
    """
    if not terms:
        return []
    return [i for i in range(start, len(lines))
            if lines[i][1] in ("text", "prompt", "tool", "result", "user", "asst",
                               "heading", "code", "quote", "table")
            and any(t in lines[i][0].lower() for t in terms)]


# ---------------------------------------------------------------- clipboard

def copy_clipboard(text: str) -> Optional[str]:
    """Copy text with the first available tool; return its name, or None if none worked.

    Args:
        text: Text to put on the clipboard.

    Returns:
        The name of the tool that worked (e.g. "pbcopy"), or None if none did.

    Examples: on macOS copy_clipboard("cd /x && claude --resume a1") -> "pbcopy";
    on a Linux box with only xclip -> "xclip"; with no clipboard tool -> None
    """
    # Try pbcopy (macOS) first; prefer wl-copy ahead of the X11 tools on a Wayland session.
    candidates: List[List[str]] = [["pbcopy"]]
    if os.environ.get("WAYLAND_DISPLAY"):
        candidates.append(["wl-copy"])
    candidates += [["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"],
                   ["wl-copy"]]
    for cmd in candidates:
        if not shutil.which(cmd[0]):
            continue
        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL)
            proc.communicate(text.encode("utf-8"), timeout=5)
            if proc.returncode == 0:
                return cmd[0]
        except (OSError, subprocess.SubprocessError):
            continue
    return None


