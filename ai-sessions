                    Tuple)

# A parsed transcript message: a dict with keys
#   role  one of:
#           "user"       a prompt you typed
#           "assistant"  a reply from Claude / Codex
#           "cmd"        a slash command you ran (Claude only), e.g. "/review src/x.py"
#           "tool"       a tool call, summarized to one line, e.g. "Read: /path"
#           "result"     the output of a tool call (capped at RESULT_CAP chars)
#   text  the message text (for "tool": the one-line summary)
#   ts    epoch seconds (float) or None
#   name  only for "tool": the bare tool name (used for searching)
Msg = Dict[str, Any]
# One session's index entry (what is cached in index.json and what Session wraps).
# Keys: source ("claude"/"codex"), id, path, cwd, branch, title, first_ts, last_ts,
#       n_user, n_asst (message counts), blob (lowercased search text, capped).
# INDEX_VERSION must be bumped whenever these keys or their meaning change, so
# stale caches are discarded instead of being misread.
Summary = Dict[str, Any]
# Inline style span: (start, end, style) character offsets into a row's text; style is one of
# "bold", "italic", "code", "link", "dim". Several spans may cover the same characters.
Span = Tuple[int, int, str]
# A run of inline text sharing one set of styles, e.g. ("bold text", ("bold",)).
Seg = Tuple[str, Tuple[str, ...]]
# One rendered transcript row: (text, kind, spans). kind picks the color/attribute:
# title, meta, dim, text, prompt, user, asst, tool, result, plus the Markdown body kinds
# heading, code, quote, table (see Theme.curses_attrs). "prompt" is the body of your own messages
# (drawn on a grey band); "text" is everything else. spans is () for unstyled rows.
Line = Tuple[str, str, Tuple[Span, ...]]

# (character, styles) pairs: styled text split into single characters (see wrap_segments).
Pairs = List[Tuple[str, Tuple[str, ...]]]
# curses window (curses._CursesWindow is not importable at runtime).
Window = Any
# (y, x, height, width) screen region.
Box = Tuple[int, int, int, int]

# curses waits ESCDELAY ms after Esc to see whether it starts an escape sequence
# (arrow keys etc.); the default of 1000ms makes Esc feel sluggish. Must be set
# before curses initializes, and we respect a user-provided value.
os.environ.setdefault("ESCDELAY", "25")

INDEX_VERSION = 2          # bump when Summary keys/meaning change (see Summary above)
BLOB_CAP = 200000          # max chars of lowercased search text kept per session
RESULT_CAP = 4000          # max chars kept per tool result
TITLE_MAX = 100            # titles derived from a first prompt are cut to this length
FIRST_LINE_MAX = 160       # first_line() default: tool-argument summaries are cut here
CMD_PEEK = 400             # how far into a user message to look for <command-name>
RESULT_PREVIEW_LINES = 6   # tool-result lines shown before "... (N more lines)"
TRANSCRIPT_CACHE_SIZE = 6  # parsed transcripts kept in memory (LRU)
DATE_COL_WIDTH = 17        # "YYYY-MM-DD HH:MM" plus a space, in the session list
STAR_COL_WIDTH = 2         # "* " (starred) or "  " in the session list, before the tag
TAG_COL_WIDTH = 3          # "CC " / "CX " in the session list
SIDE_BY_SIDE_MIN_COLS = 100  # at least this wide: list | preview, else list over preview
# ISO-8601-ish timestamps with optional fraction and Z / +hh:mm / +hhmm offset.
TS_RE: Pattern[str] = re.compile(
    r"(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d):(\d\d)(?:\.(\d+))?\s*(Z|[+-]\d\d:?\d\d)?")


# ---------------------------------------------------------------- helpers

def parse_ts(v: Any) -> Optional[float]:
    """Epoch seconds from an ISO-8601 string or a numeric epoch; None if unusable.

    Args:
        v: ISO-8601 string (optional fraction, Z or +hh:mm offset) or a numeric epoch. Numbers above
            1e11 are taken as milliseconds. Anything else gives None.

    Returns:
        Epoch seconds as a float, or None if v cannot be read as a time.

    Examples:
        parse_ts("2025-03-01T10:00:00.000Z") -> 1740823200.0
        parse_ts("2025-03-01T10:00:00+02:00") -> 1740816000
        parse_ts(1700000000000) -> 1700000000.0   (milliseconds are converted)
        parse_ts("nope") -> None
    """
    if v is None:
        return None
    if isinstance(v, (int, float)):
        # Epoch seconds are ~1.7e9 today; 1e11 seconds is the year ~5000, so anything
        # larger must be milliseconds.
        return v / 1000.0 if v > 1e11 else float(v)
    if not isinstance(v, str):
        return None
    m = TS_RE.match(v)
    if not m:
        return None
    try:
        y, mo, d, h, mi, s = [int(m.group(i)) for i in range(1, 7)]
        t: float = calendar.timegm((y, mo, d, h, mi, s, 0, 0, 0))
    except (ValueError, OverflowError):
        return None
    if m.group(7):
        t += float("0." + m.group(7))
    z = m.group(8)
    if z and z != "Z":
        sign = 1 if z[0] == "+" else -1
        zz = z[1:].replace(":", "")
        t -= sign * (int(zz[:2]) * 3600 + int(zz[2:4]) * 60)
    return t


def fmt_ts(ts: Optional[float], with_date: bool = True) -> str:
    """Format an epoch timestamp as local time ("YYYY-MM-DD HH:MM", or "HH:MM" without the
    date); "-" when it is missing, zero or out of range.

    Args:
        ts: Epoch seconds, or None/0 for "unknown".
        with_date: True for "YYYY-MM-DD HH:MM", False for just "HH:MM".

    Returns:
        The local-time text, or "-" when ts is missing, zero or out of range.

    Examples (local timezone UTC):
        fmt_ts(1740823200.0) -> "2025-03-01 10:00"
        fmt_ts(1740823200.0, with_date=False) -> "10:00"
        fmt_ts(None) -> "-"
    """
    if not ts:
        return "-"
    try:
        return datetime.datetime.fromtimestamp(ts).strftime(
            "%Y-%m-%d %H:%M" if with_date else "%H:%M")
    except (ValueError, OverflowError, OSError):
        return "-"


def clean(s: Any) -> str:
    """Make text safe for a terminal cell grid.

    Args:
        s: Text to sanitize; non-strings are converted with str().

    Returns:
        s with tabs as 4 spaces, carriage returns removed and other control characters replaced by
        spaces. Newlines are kept.

    Example: clean("a\\tb\\x07c") -> "a    b c"   (tab -> 4 spaces, control char -> space)
    """
    if not isinstance(s, str):
        s = str(s)
    s = s.replace("\t", "    ").replace("\r", "")
    return "".join(c if (c == "\n" or (ord(c) >= 32 and ord(c) != 127 and
                                       not (0x80 <= ord(c) < 0xa0))) else " " for c in s)


_wcache: Dict[str, int] = {}


def char_width(c: str) -> int:
    """Terminal columns one character occupies: 0 for combining marks, 2 for wide/fullwidth
    (CJK), else 1. Results are memoized in _wcache.

    Args:
        c: A single character.

    Returns:
        The width in terminal columns: 0, 1 or 2.

    Examples: char_width("a") -> 1; char_width("日") -> 2; char_width("\\u0301") -> 0
    """
    w = _wcache.get(c)
    if w is None:
        if unicodedata.combining(c):
            w = 0
        elif unicodedata.east_asian_width(c) in ("W", "F"):
            w = 2
        else:
            w = 1
        _wcache[c] = w
    return w


def str_width(s: str) -> int:
    return sum(char_width(c) for c in s)


def rule_chars() -> Tuple[str, str]:
    """(horizontal, vertical) separator characters: box-drawing when UTF-8, else ASCII.

    Returns:
        A (horizontal, vertical) pair of one-character strings.

    Examples: with a UTF-8 locale -> ("─", "│"); with an ASCII locale -> ("-", "|")
    """
    enc = (locale.getpreferredencoding(False) or "").lower().replace("-", "").replace("_", "")
    return ("─", "│") if enc == "utf8" else ("-", "|")


def transcript_glyphs() -> Tuple[str, str]:
    """(tool call marker, result elbow) as Claude Code draws them: UTF-8 glyphs, else ASCII.

    Returns:
        A (marker, elbow) pair of one-character strings.

    Examples: with a UTF-8 locale -> ("⏺", "⎿"); with an ASCII locale -> ("*", "|")
    """
    enc = (locale.getpreferredencoding(False) or "").lower().replace("-", "").replace("_", "")
    return ("⏺", "⎿") if enc == "utf8" else ("*", "|")


def utf8_locale() -> bool:
    """True when the locale encodes UTF-8 (so box-drawing and bullet glyphs can be printed).

    Example: with a UTF-8 locale -> True; with an ASCII ("C") locale -> False
    """
    enc = (locale.getpreferredencoding(False) or "").lower().replace("-", "").replace("_", "")
    return enc == "utf8"


def markdown_glyphs() -> Tuple[str, str]:
    """(bullet, quote bar) used when rendering Markdown: UTF-8 glyphs, else ASCII.

    Returns:
        A (bullet, quote_bar) pair of one-character strings.

    Examples: with a UTF-8 locale -> ("•", "▎"); with an ASCII locale -> ("-", "|")
    """
    return ("•", "▎") if utf8_locale() else ("-", "|")


def clip(s: str, width: int) -> str:
    """Cut s to at most width display columns (wide chars count as 2).

    Args:
        s: Text to cut.
        width: Maximum display width in terminal columns; <= 0 gives "".

    Returns:
        The longest prefix of s that fits in width columns.

    Examples:
        clip("日本語abc", 5) -> "日本"
        clip("hello", 3) -> "hel"
        clip("hello", 0) -> ""
    """
    if width <= 0:
        return ""
    out, w = [], 0
    for c in s:
        k = char_width(c)
        if w + k > width:
            break
        out.append(c)
        w += k
    return "".join(out)


def pad(s: str, width: int) -> str:
    """Clip s to width display columns, then right-pad with spaces to exactly width.

    Args:
        s: Text to fit.
        width: Exact display width wanted, in terminal columns.

    Returns:
        s clipped to width columns, then padded with trailing spaces to exactly width.

    Examples:
        pad("ab", 5) -> "ab   "
        pad("日本語", 5) -> "日本 "   (the third wide char would not fit)
    """
    s = clip(s, width)
    return s + " " * (width - str_width(s))


def wrap(text: str, width: int) -> List[str]:
    """Word-wrap text to a display width; blank-line runs collapse to one.

    Args:
        text: Text to wrap; may contain newlines. Leading indentation of a line is kept on its
            continuation lines (up to half the width).
        width: Display width in terminal columns; values below 4 are treated as 4.

    Returns:
        The wrapped lines, with no trailing blank lines.

    Examples:
        wrap("the quick brown fox jumps", 10) -> ["the quick", "brown fox", "jumps"]
        wrap("a\\n\\n\\n\\nb", 10) -> ["a", "", "b"]
        wrap("abcdefghijkl", 6) -> ["abcdef", "ghijkl"]   (over-long words are split)
    """
    width = max(width, 4)
    lines: List[str] = []
    for para in text.split("\n"):
        para = para.rstrip()
        if not para.strip():
            if lines and lines[-1] != "":
                lines.append("")
            continue
        if str_width(para) <= width:
            lines.append(para)
            continue
        # Continuation lines keep the paragraph's leading indent (capped at half the width).
        indent = min(len(para) - len(para.lstrip(" ")), width // 2)
        current = " " * indent
        for word in para.strip().split(" "):
            if not word:
                continue
            # A word wider than a line is split across lines, `width - indent` columns at a time.
            while str_width(word) > width - indent:
                if current.strip():
                    lines.append(current)
                    current = " " * indent
                piece = clip(word, width - indent)
                if not piece:  # a single char wider than the line: emit it anyway
                    piece, word = word[:1], word[1:]
                else:
                    word = word[len(piece):]
                lines.append(" " * indent + piece)
            if not current.strip():
                current = " " * indent + word
            elif str_width(current) + 1 + str_width(word) <= width:
                current += " " + word
            else:
                lines.append(current)
                current = " " * indent + word
        if current.strip():
            lines.append(current)
    while lines and lines[-1] == "":
        lines.pop()
    return lines


def first_line(s: Any, n: int = FIRST_LINE_MAX) -> str:
    """First non-blank line of s, stripped and cut to n chars.

    Args:
        s: Any value; it is converted with str().
        n: Maximum number of characters to keep (default FIRST_LINE_MAX).

    Returns:
        The first non-blank line, stripped and cut to n characters; "" if there is none.

    Examples:
        first_line("\\n  hi there \\nmore") -> "hi there"
        first_line("abcdef", 3) -> "abc"
    """
    for ln in str(s).split("\n"):
        ln = ln.strip()
        if ln:
            return ln[:n]
    return ""


def one_line(s: Any) -> str:
    """Collapse all whitespace runs (including newlines) to single spaces.

    Args:
        s: Any value; it is converted with str().

    Returns:
        s with every whitespace run replaced by a single space, and the ends stripped.

    Example: one_line("a \\n b\\t c") -> "a b c"
    """
    return " ".join(str(s).split())


def shell_quote(s: str) -> str:
    """Quote s for a POSIX shell, leaving it bare when it only has safe characters.

    Args:
        s: Any string.

    Returns:
        s unchanged if it has only safe characters, otherwise s wrapped in single quotes.

    Examples:
        shell_quote("/tmp/x") -> "/tmp/x"
        shell_quote("a b") -> "'a b'"
        shell_quote("it's") -> "'it'\\\\''s'"
    """
    if re.match(r"^[\w@%+=:,./-]+$", s):
        return s
    return "'" + s.replace("'", "'\\''") + "'"


def terms_of(query: Optional[str]) -> List[str]:
    """Split a filter query into lowercase terms (all must match).

    Args:
        query: The raw filter text, or None.

    Returns:
        The whitespace-separated words of query, lowercased; [] when query is empty or None.

    Examples: terms_of("Foo  BAR") -> ["foo", "bar"]; terms_of(None) -> []
    """
    return [t for t in (query or "").lower().split() if t]


def term_regex(terms: List[str]) -> Optional[Pattern[str]]:
    """Case-insensitive regex matching any term, longest first (for highlighting).

    Args:
        terms: Lowercase search terms, such as the result of terms_of().

    Returns:
        A compiled case-insensitive regex that matches any term, or None if terms is empty.

    Examples:
        term_regex(["fo", "foobar"]).pattern -> "foobar|fo"
        term_regex([]) -> None
    """
    if not terms:
        return None
    return re.compile("|".join(re.escape(t) for t in sorted(terms, key=len, reverse=True)),
                      re.I)


# ---------------------------------------------------------------- parsing

class Source(object):
    """Base class: one AI tool whose transcripts ai-sessions reads.

    A subclass fills in the class attributes and implements root(), scan_root(), discover()
    and parse(); to support another tool, add a subclass and put an instance in SOURCE_LIST.
    """
    key = ""              # "claude" / "codex": the value stored in Summary["source"]
    tag = ""              # two-letter tag shown in the session list ("CC" / "CX")
    label = ""            # display name ("Claude Code" / "Codex")
    assistant_name = ""   # name of the assistant in transcripts ("Claude" / "Codex")
    default_cmd = ""      # bare command that starts the tool
    resume_args: List[str] = []   # appended to the command when it has no {id} word
    session_env_var = ""  # environment variable the tool sets to the current session id
    # Command template from --claude-cmd/--codex-cmd. Written once by main() before
    # anything reads it, because resume commands are built deep inside Session/App;
    # threading it through every layer would add plumbing for no benefit.
    cmd_override: Optional[str] = None

    def root(self) -> str:
        """The tool's data directory (set by AI_SESSIONS_<KEY>_DIR).

        Returns:
            The expanded directory path.
        """
        raise NotImplementedError

    def scan_root(self) -> str:
        """The directory whose vanished transcript files SessionIndex.load() prunes from the index.

        Returns:
            A directory path, equal to or below root().
        """
        raise NotImplementedError

    def discover(self) -> List[str]:
        """List this tool's transcript files without opening any of them.

        Returns:
            The transcript paths found.
        """
        raise NotImplementedError

    def parse(self, path: str) -> Tuple[Summary, List[Msg]]:
        """Parse one transcript file.

        Args:
            path: Path of a file returned by discover().

        Returns:
            A (summary, messages) tuple: summary is the index Summary, messages the Msg list.
        """
        raise NotImplementedError

    def title_overrides(self) -> Dict[str, str]:
        """Titles kept outside the transcripts, which replace the parsed ones.

        Returns:
            A dict mapping session id to title; empty unless the tool keeps names elsewhere.

        Example: the base class -> {}
        """
        return {}

    def resume_template(self) -> str:
        """Command template: CLI flag, then AI_SESSIONS_<KEY>_CMD, then the bare command.

        Returns:
            The command template: the --claude-cmd/--codex-cmd flag if given, else the
            AI_SESSIONS_<KEY>_CMD variable, else the bare command name.

        Examples:
            with no override and no env var: ClaudeSource().resume_template() -> "claude"
            with AI_SESSIONS_CLAUDE_CMD="mycl --x {id}":
                ClaudeSource().resume_template() -> "mycl --x {id}"
        """
        return (self.cmd_override
                or os.environ.get("AI_SESSIONS_%s_CMD" % self.key.upper())
                or self.default_cmd)

    def resume_argv(self, sid: str) -> Tuple[List[str], Optional[str]]:
        """Returns (argv, warning). warning is None unless the template was unusable.

        Args:
            sid: Session id, substituted for "{id}" in the command template.

        Returns:
            An (argv, warning) tuple: argv is the command as a list of words; warning is a message when
            the template was unparsable or empty (the default command is used), else None.

        Examples:
            ClaudeSource().resume_argv("abc") -> (["claude", "--resume", "abc"], None)
            CodexSource().resume_argv("abc") -> (["codex", "resume", "abc"], None)
            with AI_SESSIONS_CLAUDE_CMD="mycl --x {id} --y":
                ClaudeSource().resume_argv("abc") -> (["mycl", "--x", "abc", "--y"], None)
            with AI_SESSIONS_CLAUDE_CMD="'unterminated":
                ClaudeSource().resume_argv("abc") ->
                    (["claude", "--resume", "abc"], "bad claude command: No closing quotation")
        """
        warn: Optional[str] = None
        try:
            words = shlex.split(self.resume_template())
        except ValueError as e:
            words, warn = [], "bad %s command: %s" % (self.key, e)
        if not words:
            words = [self.default_cmd]
            warn = warn or "empty %s command" % self.key
        if not any("{id}" in w for w in words):
            words = words + self.resume_args
        return [w.replace("{id}", sid) for w in words], warn

    # -- shared parsing helpers

    # Tool-call argument names worth showing, in priority order (first one present wins).
    TOOL_KEYS: Tuple[str, ...] = ("command", "cmd", "file_path", "path", "notebook_path", "pattern",
                                  "url", "description", "query", "prompt", "text", "message",
                                  "target")

    @staticmethod
    def decode_json_object(s: str) -> Any:
        """Decode s if it looks like a JSON object; otherwise (or if invalid) return it unchanged.

        Args:
            s: A string, possibly holding a JSON object.

        Returns:
            The decoded value, or s itself.

        Examples:
            Source.decode_json_object(' {"a": 1}') -> {"a": 1}
            Source.decode_json_object("{oops") -> "{oops"
            Source.decode_json_object("plain") -> "plain"
        """
        if s.strip().startswith("{"):
            try:
                return json.loads(s.strip())
            except ValueError:
                pass
        return s

    @staticmethod
    def first_tool_arg(inp: Dict[str, Any]) -> str:
        """The most telling argument of a tool call, as one line.

        Args:
            inp: The tool's input dict.

        Returns:
            The first TOOL_KEYS entry present (a non-blank string, or a list of strings joined by
            spaces); failing that the first non-blank string value; "" if none.

        Examples:
            Source.first_tool_arg({"x": "1", "command": "ls"}) -> "ls"
            Source.first_tool_arg({"command": ["ls", "-l"]}) -> "ls -l"
            Source.first_tool_arg({"x": "v"}) -> "v"
            Source.first_tool_arg({"n": 3}) -> ""
        """
        for k in Source.TOOL_KEYS:
            v = inp.get(k)
            if isinstance(v, str) and v.strip():
                return first_line(v)
            if isinstance(v, list) and v and all(isinstance(x, str) for x in v):
                return first_line(" ".join(v))
        for v in inp.values():
            if isinstance(v, str) and v.strip():
                return first_line(v)
        return ""

    @staticmethod
    def summarize_tool(name: Any, inp: Any) -> str:
        """One-line "Name: key argument" summary of a tool call.

        inp is a dict (Claude), or a dict / JSON string / plain string (Codex). The
        argument shown is the first TOOL_KEYS entry present, else the first string value.

        Args:
            name: The tool name; None or empty becomes "tool".
            inp: The tool's input: a dict, a JSON string (decoded if it starts with "{"), a plain
                string, or anything else (then no argument is shown).

        Returns:
            "Name: argument", or just "Name" when no argument can be found.

        Examples:
            Source.summarize_tool("Read", {"file_path": "/x"}) -> "Read: /x"
            Source.summarize_tool("shell", '{"command": ["ls", "-l"]}') -> "shell: ls -l"
            Source.summarize_tool("Foo", {"zzz": "v"}) -> "Foo: v"
            Source.summarize_tool("Foo", {}) -> "Foo"
        """
        name = str(name or "tool")
        if isinstance(inp, str):
            inp = Source.decode_json_object(inp)
        if isinstance(inp, str):
            val = first_line(inp)
        elif isinstance(inp, dict):
            val = Source.first_tool_arg(inp)
        else:
            val = ""
        return "%s: %s" % (name, val) if val else name

    @staticmethod
    def content_text(c: Any) -> str:
        """Flatten tool_result / output content to text.

        Content is a plain string or a list of strings / {"type":"text","text":...} blocks;
        other block kinds (images etc.) are dropped.

        Args:
            c: A string, a list of strings / {"type": "text", "text": ...} blocks, or anything else.

        Returns:
            The text parts joined with newlines; "" for unsupported content.

        Examples:
            Source.content_text([{"type": "text", "text": "a"}, "b", {"type": "image"}]) -> "a\\nb"
            Source.content_text("x") -> "x"
            Source.content_text(None) -> ""
        """
        if isinstance(c, str):
            return c
        if not isinstance(c, list):
            return ""
        parts: List[str] = []
        for block in c:
            text = block.get("text") if isinstance(block, dict) else block
            if isinstance(text, str):
                parts.append(text)
        return "\n".join(parts)

    @staticmethod
    def iter_json(path: str) -> Iterator[Dict[str, Any]]:
        """Yield each JSON-object line of a .jsonl file, skipping blank/garbled lines.

        Args:
            path: Path of a .jsonl file (one JSON value per line).

        Yields:
            Each line that decodes to a JSON object (dict), in file order.

        Example: for a file whose lines are `{"type": "user"}`, `garbage`, `` and `[1]`,
        Source.iter_json(path) yields only {"type": "user"}; a missing file yields nothing.
        """
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line or line[0] != "{":
                        continue
                    try:
                        obj = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(obj, dict):
                        yield obj
        except OSError:
            return

    def make_summary(self, sid: str, path: str, cwd: Optional[str], branch: Optional[str],
                     title: Optional[str], first_ts: Optional[float], last_ts: Optional[float],
                     msgs: List[Msg]) -> Summary:
        """Build the index Summary from parsed fields and messages.

        Args:
            sid: The session id.
            path: Transcript file path (its mtime is the fallback for missing timestamps).
            cwd: Working directory, or None if unknown.
            branch: Git branch, or None.
            title: Session title, or None.
            first_ts: Epoch seconds of the first message, or None.
            last_ts: Epoch seconds of the last message, or None.
            msgs: The parsed Msg list, used for the message counts and the search blob.

        Returns:
            The Summary dict. Missing text fields become ""; missing timestamps fall back to the file's
            mtime (or 0).

        Example: ClaudeSource().make_summary("abc", "/p/abc.jsonl", "/work/proj", None, "Fix bug",
        1.0, 2.0, [user "fix the bug", assistant "ok", tool Read]) ->
        {"source": "claude", "id": "abc", "path": "/p/abc.jsonl", "cwd": "/work/proj",
        "branch": "", "title": "Fix bug", "first_ts": 1.0, "last_ts": 2.0, "n_user": 1,
        "n_asst": 1, "blob": "fix the bug\\nok\\nread"}
        """
        n_user = sum(1 for m in msgs if m["role"] == "user")
        n_asst = sum(1 for m in msgs if m["role"] == "assistant")
        # "blob" is the text the filter searches: prompts, replies and tool names (not tool
        # results: too big and too noisy), lowercased once here, capped at BLOB_CAP.
        blob: List[str] = []
        size = 0
        for m in msgs:
            if m["role"] in ("user", "assistant"):
                piece = m["text"]
            elif m["role"] == "tool":
                piece = m.get("name", "")
            else:
                continue
            blob.append(piece)
            size += len(piece) + 1
            if size > BLOB_CAP:
                break
        try:
            st = os.stat(path)
            mtime = st.st_mtime
        except OSError:
            mtime = 0
        return {
            "source": self.key, "id": sid, "path": path, "cwd": cwd or "", "branch": branch or "",
            "title": one_line(title or ""), "first_ts": first_ts or mtime, "last_ts": last_ts or first_ts or mtime,
            "n_user": n_user, "n_asst": n_asst, "blob": "\n".join(blob)[:BLOB_CAP].lower(),
        }


class ClaudeSource(Source):
    """Claude Code: ~/.claude/projects/<project-dir>/<uuid>.jsonl transcripts."""
    key = "claude"
    tag = "CC"
    label = "Claude Code"
    assistant_name = "Claude"
    default_cmd = "claude"
    resume_args = ["--resume", "{id}"]
    session_env_var = "CLAUDE_CODE_SESSION_ID"

    # User "messages" that the harness injects rather than the human typing them. They
    # would otherwise pollute titles and search, so parse() drops them.
    NOISE: Tuple[str, ...] = (
        "<local-command-caveat>", "<local-command-stdout>", "<local-command-stderr>",
        "<system-reminder>", "<task-notification>", "<bash-input>", "<bash-stdout>",
        "<bash-stderr>", "<command-message>", "<user-prompt-submit-hook>",
        "Caveat:", "[Request interrupted", "This session is being continued",
    )
    # Claude records a slash command as a user message containing these tags.
    CMD_NAME: Pattern[str] = re.compile(r"<command-name>\s*(.*?)\s*</command-name>", re.S)
    CMD_ARGS: Pattern[str] = re.compile(r"<command-args>\s*(.*?)\s*</command-args>", re.S)

    def root(self) -> str:
        """The Claude Code projects directory.

        Returns:
            $AI_SESSIONS_CLAUDE_DIR, else ~/.claude/projects, with "~" expanded.

        Example: no env var -> "/home/me/.claude/projects"
        """
        return os.path.expanduser(os.environ.get("AI_SESSIONS_CLAUDE_DIR") or "~/.claude/projects")

    def scan_root(self) -> str:
        """Transcripts live anywhere under the projects directory.

        Returns:
            root().

        Example: no env var -> "/home/me/.claude/projects"
        """
        return self.root()

    def discover(self) -> List[str]:
        """List the transcripts: <root>/<project-dir>/*.jsonl.

        Returns:
            The transcript paths found.

        Example: ~/.claude/projects/-work-proj/abc.jsonl on disk ->
        ["/home/me/.claude/projects/-work-proj/abc.jsonl"]
        """
        found: List[str] = []
        try:
            project_dirs = list(os.scandir(self.root()))
        except OSError:
            project_dirs = []
        for d in project_dirs:
            # ~/.claude/projects/memory holds memory files, not session transcripts.
            if not d.is_dir(follow_symlinks=True) or d.name == "memory":
                continue
            try:
                for f in os.scandir(d.path):
                    if f.name.endswith(".jsonl") and f.is_file():
                        found.append(f.path)
            except OSError:
                pass
        return found

    @staticmethod
    def content_blocks(content: Any) -> Optional[List[Any]]:
        """Normalize Claude message content to a block list: a bare string becomes one text
        block; anything that is neither string nor list yields None (caller skips it).

        Args:
            content: A Claude message's "content": a string, a list of blocks, or something else.

        Returns:
            A list of blocks, or None if content is neither a string nor a list.

        Examples:
            ClaudeSource.content_blocks("hi") -> [{"type": "text", "text": "hi"}]
            ClaudeSource.content_blocks([{"type": "text", "text": "hi"}]) -> the same list
            ClaudeSource.content_blocks(5) -> None
        """
        if isinstance(content, str):
            return [{"type": "text", "text": content}]
        return content if isinstance(content, list) else None

    def user_msgs(self, blocks: List[Any], ts: Optional[float]) -> List[Msg]:
        """Turn the content blocks of a Claude "user" record into Msgs.

        Text blocks become "user" messages, or "cmd" messages for slash commands; harness-injected
        text (NOISE) is dropped; tool_result blocks become "result" messages.

        Args:
            blocks: The normalized content blocks (see content_blocks()); non-dict blocks are skipped.
            ts: The record's timestamp, copied onto every message.

        Returns:
            The messages in block order.

        Examples:
            ClaudeSource().user_msgs([{"type": "text", "text": " hi "}], 1.0) -> [{"role": "user", "text": "hi", "ts": 1.0}]
            ClaudeSource().user_msgs([{"type": "text", "text": "<command-name>/clear</command-name>"}], None)
                -> [{"role": "cmd", "text": "/clear", "ts": None}]
            ClaudeSource().user_msgs([{"type": "tool_result", "content": "ok"}], None)
                -> [{"role": "result", "text": "ok", "ts": None}]
        """
        out: List[Msg] = []
        for block in blocks:
            if not isinstance(block, dict):
                continue
            block_type = block.get("type")
            if block_type == "tool_result":
                out.append({"role": "result",
                            "text": self.content_text(block.get("content"))[:RESULT_CAP], "ts": ts})
                continue
            if block_type != "text":
                continue
            text = block.get("text")
            if not isinstance(text, str) or not text.strip():
                continue
            stripped = text.lstrip()
            # Peek only at the start: a command tag deep inside a long prompt is
            # just text the user pasted, not a slash command.
            head = stripped[:CMD_PEEK]
            cmd_match = self.CMD_NAME.search(head) if "<command-name>" in head else None
            if cmd_match:
                args_match = self.CMD_ARGS.search(stripped)
                cmd = cmd_match.group(1)
                if args_match and args_match.group(1):
                    cmd += " " + one_line(args_match.group(1))
                out.append({"role": "cmd", "text": cmd, "ts": ts})
            elif not stripped.startswith(self.NOISE):
                out.append({"role": "user", "text": text.strip(), "ts": ts})
        return out

    def assistant_msgs(self, blocks: List[Any], ts: Optional[float]) -> List[Msg]:
        """Turn the content blocks of a Claude "assistant" record into Msgs.

        Args:
            blocks: The normalized content blocks (see content_blocks()); non-dict blocks are skipped.
            ts: The record's timestamp, copied onto every message.

        Returns:
            "assistant" messages for non-blank text blocks and "tool" messages for tool_use blocks,
            in block order.

        Examples:
            ClaudeSource().assistant_msgs([{"type": "text", "text": "done"}], 2.0)
                -> [{"role": "assistant", "text": "done", "ts": 2.0}]
            ClaudeSource().assistant_msgs([{"type": "tool_use", "name": "Read", "input": {"file_path": "/x"}}], None)
                -> [{"role": "tool", "name": "Read", "text": "Read: /x", "ts": None}]
        """
        out: List[Msg] = []
        for block in blocks:
            if not isinstance(block, dict):
                continue
            block_type = block.get("type")
            if block_type == "text" and isinstance(block.get("text"), str) and block["text"].strip():
                out.append({"role": "assistant", "text": block["text"].strip(), "ts": ts})
            elif block_type == "tool_use":
                out.append({"role": "tool", "name": str(block.get("name") or "tool"),
                            "text": self.summarize_tool(block.get("name"), block.get("input")), "ts": ts})
        return out

    def parse(self, path: str) -> Tuple[Summary, List[Msg]]:
        """Parse a Claude Code transcript (~/.claude/projects/<project-dir>/<uuid>.jsonl).

        One JSON object per line. Records used (everything else is ignored):

            {"type": "custom-title", "customTitle": "Name set with /rename"}
            {"type": "ai-title", "aiTitle": "Generated title"}
            {"type": "summary", "summary": "Compaction summary"}
            {"type": "user", "cwd": "/work/proj", "gitBranch": "main",
             "timestamp": "2025-03-01T10:00:00.000Z", "isSidechain": false, "isMeta": false,
             "message": {"role": "user", "content": "text"
                         | [{"type": "text", "text": "..."},
                            {"type": "tool_result", "tool_use_id": "t1", "content": "..."}]}}
            {"type": "assistant", ...,
             "message": {"role": "assistant", "content": "text"
                         | [{"type": "text", "text": "..."},
                            {"type": "tool_use", "id": "t1", "name": "Read",
                             "input": {"file_path": "/x"}}]}}

        Skipped on purpose:
          * isSidechain records: subagent transcripts interleaved in the file; they are not
            the conversation with you.
          * isMeta records: synthetic messages the harness adds. Their cwd/branch are
            still harvested, but not their text or timestamps.
          * gitBranch "HEAD": a detached HEAD, which says nothing about the branch.
          * harness-injected user text (NOISE: system reminders, hook output,
            "Caveat:" notices, ...).
        Slash commands arrive as user text with <command-name>/<command-args> tags and
        become "cmd" messages.

        The session id is the filename stem. Title priority: custom-title > ai-title >
        summary > the first real prompt (shortened to TITLE_MAX). Later records of the
        same title type replace earlier ones.

        Args:
            path: Path of the Claude Code .jsonl transcript. The session id is its filename without
                ".jsonl".

        Returns:
            A (summary, messages) tuple: summary is the index Summary (via Source.make_summary), messages is
            the list of Msg dicts in file order.

        Example: for ~/.claude/projects/-work-proj/abc.jsonl holding one user line
        {"type": "user", "cwd": "/work/proj", "timestamp": "2025-03-01T10:00:00Z",
        "message": {"content": "fix the bug"}} and one assistant text reply "done":

            ClaudeSource().parse(path) -> ({"source": "claude", "id": "abc", "cwd": "/work/proj",
                                            "title": "fix the bug", "n_user": 1, "n_asst": 1, ...},
                                           [{"role": "user", "text": "fix the bug", "ts": 1740823200.0},
                                            {"role": "assistant", "text": "done", "ts": ...}])
        """
        sid = os.path.basename(path)[:-6]
        cwd: Optional[str] = None
        branch: Optional[str] = None
        custom: Optional[str] = None
        ai_title: Optional[str] = None
        summary_title: Optional[str] = None
        first_ts: Optional[float] = None
        last_ts: Optional[float] = None
        msgs: List[Msg] = []
        for record in self.iter_json(path):
            rtype = record.get("type")
            if rtype == "custom-title" and record.get("customTitle"):
                custom = record["customTitle"]
                continue
            if rtype == "ai-title" and record.get("aiTitle"):
                ai_title = record["aiTitle"]
                continue
            if rtype == "summary" and record.get("summary"):
                summary_title = record["summary"]
                continue
            if rtype not in ("user", "assistant"):
                continue
            if record.get("isSidechain"):
                continue
            if not cwd and isinstance(record.get("cwd"), str):
                cwd = record["cwd"]
            if not branch and isinstance(record.get("gitBranch"), str) and record["gitBranch"] != "HEAD":
                branch = record["gitBranch"]
            if record.get("isMeta"):
                continue
            message = record.get("message")
            if not isinstance(message, dict):
                continue
            ts = parse_ts(record.get("timestamp"))
            if ts:
                first_ts = first_ts or ts
                last_ts = ts
            blocks = self.content_blocks(message.get("content"))
            if blocks is None:
                continue
            if rtype == "user":
                msgs.extend(self.user_msgs(blocks, ts))
            else:
                msgs.extend(self.assistant_msgs(blocks, ts))
        first_prompt = next((m["text"] for m in msgs if m["role"] == "user"), None)
        title = custom or ai_title or summary_title or (
            one_line(first_prompt)[:TITLE_MAX] if first_prompt else None)
        return self.make_summary(sid, path, cwd, branch, title, first_ts, last_ts, msgs), msgs


class CodexSource(Source):
    """Codex: ~/.codex/sessions/YYYY/MM/DD/rollout-<time>-<uuid>.jsonl transcripts."""
    key = "codex"
    tag = "CX"
    label = "Codex"
    assistant_name = "Codex"
    default_cmd = "codex"
    resume_args = ["resume", "{id}"]
    session_env_var = "CODEX_THREAD_ID"

    # Codex injects context as user messages: a leading XML-ish tag wrapping the whole
    # message (WRAPPER_TAG, checked together with a trailing ">") or one of these prefixes.
    WRAPPER_TAG: Pattern[str] = re.compile(r"^<[A-Za-z_][\w\-]*[\s>/]")
    NOISE: Tuple[str, ...] = ("# AGENTS.md", "<environment_context>", "<user_instructions>",
                              "<permissions", "<INSTRUCTIONS>")

    def root(self) -> str:
        """The Codex home directory.

        Returns:
            $AI_SESSIONS_CODEX_DIR, else ~/.codex, with "~" expanded.

        Example: no env var -> "/home/me/.codex"
        """
        return os.path.expanduser(os.environ.get("AI_SESSIONS_CODEX_DIR") or "~/.codex")

    def scan_root(self) -> str:
        """Transcripts live under <root>/sessions (the rest of the Codex home is not scanned).

        Returns:
            <root>/sessions.

        Example: no env var -> "/home/me/.codex/sessions"
        """
        return os.path.join(self.root(), "sessions")

    def discover(self) -> List[str]:
        """List the rollouts: <root>/sessions/**/rollout-*.jsonl.

        Returns:
            The transcript paths found.

        Example: ~/.codex/sessions/2025/03/01/rollout-2025-03-01T10-00-00-<uuid>.jsonl on disk ->
        ["/home/me/.codex/sessions/2025/03/01/rollout-2025-03-01T10-00-00-<uuid>.jsonl"]
        """
        found: List[str] = []
        for dirpath, _dirnames, filenames in os.walk(self.scan_root()):
            for name in filenames:
                if name.startswith("rollout-") and name.endswith(".jsonl"):
                    found.append(os.path.join(dirpath, name))
        return found

    def title_overrides(self) -> Dict[str, str]:
        """Map Codex session id -> thread name from session_index.jsonl (may be absent).

        Returns:
            A dict mapping session id to a one-line title; empty if the file is missing or has no usable
            entries.

        Example: a session_index.jsonl line {"id": "u1", "thread_name": "Fix\\nbug"} ->
        {"u1": "Fix bug"}; a missing file -> {}
        """
        names: Dict[str, str] = {}
        for o in self.iter_json(os.path.join(self.root(), "session_index.jsonl")):
            if isinstance(o.get("id"), str) and isinstance(o.get("thread_name"), str) \
                    and o["thread_name"].strip():
                names[o["id"]] = one_line(o["thread_name"])
        return names

    def user_noise(self, text: str) -> bool:
        """True for Codex user messages that are injected context, not typed prompts.

        Args:
            text: The text of a Codex user message.

        Returns:
            True if it is injected context (AGENTS.md text, an XML-style wrapper tag, ...) rather than
            something the user typed.

        Examples:
            CodexSource().user_noise("<environment_context>cwd: /x</environment_context>") -> True
            CodexSource().user_noise("# AGENTS.md instructions for /x") -> True
            CodexSource().user_noise("fix the bug") -> False
        """
        s = text.lstrip()
        return s.startswith(self.NOISE) or bool(self.WRAPPER_TAG.match(s) and s.rstrip().endswith(">"))

    def message_text(self, payload: Dict[str, Any]) -> str:
        """Join the non-blank text parts of a Codex "message" payload.

        Args:
            payload: A response_item payload; its "content" is a string or a list of blocks that
                carry "text" (input_text / output_text).

        Returns:
            The text parts joined with newlines and stripped; "" if there are none.

        Examples:
            CodexSource().message_text({"content": [{"type": "input_text", "text": "a"}, {"text": " "}, {"text": "b"}]})
                -> "a\\nb"
            CodexSource().message_text({"content": "hi"}) -> "hi"
            CodexSource().message_text({}) -> ""
        """
        blocks = payload.get("content")
        if isinstance(blocks, str):
            blocks = [{"text": blocks}]
        texts = [block["text"] for block in (blocks or []) if isinstance(block, dict)
                 and isinstance(block.get("text"), str) and block["text"].strip()]
        return "\n".join(texts).strip()

    def parse(self, path: str) -> Tuple[Summary, List[Msg]]:
        """Parse a Codex rollout (~/.codex/sessions/YYYY/MM/DD/rollout-<time>-<uuid>.jsonl).

        One JSON object per line, {"timestamp", "type", "payload"}. Records used:

            {"type": "session_meta", "payload": {"id": "<uuid>", "timestamp": "...",
                                                  "cwd": "/work/proj", "git": {"branch": "main"}}}
            {"type": "turn_context", "payload": {"cwd": "/work/proj", ...}}
            {"type": "response_item", "payload": {
                "type": "message", "role": "user" | "assistant",
                "content": [{"type": "input_text" | "output_text", "text": "..."}]}}
            {"type": "response_item", "payload": {
                "type": "function_call", "name": "shell", "arguments": "{\\"command\\": [...]}"}}
            {"type": "response_item", "payload": {
                "type": "custom_tool_call", "name": "apply_patch", "input": "*** Begin Patch..."}}
            {"type": "response_item", "payload": {
                "type": "function_call_output" | "custom_tool_call_output", "output": "..."}}

        Skipped: other roles (developer/system), other record types, and user messages that
        are injected context (see CodexSource.user_noise: AGENTS.md text, <environment_context>...).

        The id comes from session_meta when present. Otherwise it is the last 36 characters
        of the filename stem: rollout-<timestamp>-<uuid> always ends in a 36-char UUID.
        Codex has no title records, so the title is the first user prompt (or the first
        assistant message); SessionIndex.load() overrides it with session_index.jsonl names.

        Args:
            path: Path of the Codex rollout .jsonl file.

        Returns:
            A (summary, messages) tuple: summary is the index Summary (via Source.make_summary), messages is
            the list of Msg dicts in file order.

        Example: for ~/.codex/sessions/2025/03/01/rollout-2025-03-01T10-00-00-<uuid>.jsonl with a
        session_meta record (id "<uuid>", cwd "/work/proj"), a user message "fix the bug" and a
        shell function_call:

            CodexSource().parse(path) -> ({"source": "codex", "id": "<uuid>", "cwd": "/work/proj",
                                           "title": "fix the bug", "n_user": 1, "n_asst": 0, ...},
                                          [{"role": "user", "text": "fix the bug", "ts": 1.7e9},
                                           {"role": "tool", "name": "shell", "text": "shell: ls -l", "ts": 1.7e9}])
        """
        stem = os.path.basename(path)[:-6]
        sid = stem[-36:] if len(stem) >= 36 else stem
        cwd: Optional[str] = None
        branch: Optional[str] = None
        first_ts: Optional[float] = None
        last_ts: Optional[float] = None
        msgs: List[Msg] = []
        for record in self.iter_json(path):
            rtype = record.get("type")
            payload = record.get("payload")
            if not isinstance(payload, dict):
                continue
            ts = parse_ts(record.get("timestamp"))
            if rtype == "session_meta":
                if isinstance(payload.get("id"), str):
                    sid = payload["id"]
                if isinstance(payload.get("cwd"), str):
                    cwd = payload["cwd"]
                git = payload.get("git")
                if isinstance(git, dict) and isinstance(git.get("branch"), str):
                    branch = git["branch"]
                first_ts = parse_ts(payload.get("timestamp")) or first_ts
                continue
            if rtype == "turn_context" and not cwd and isinstance(payload.get("cwd"), str):
                cwd = payload["cwd"]
                continue
            if rtype != "response_item":
                continue
            ptype = payload.get("type")
            if ptype == "message":
                role = payload.get("role")
                if role not in ("user", "assistant"):
                    continue
                text = self.message_text(payload)
                if not text or (role == "user" and self.user_noise(text)):
                    continue
                if ts:
                    first_ts = first_ts or ts
                    last_ts = ts
                msgs.append({"role": role, "text": text, "ts": ts})
            elif ptype in ("function_call", "custom_tool_call"):
                inp = payload.get("arguments") if ptype == "function_call" else payload.get("input")
                if inp is None:
                    inp = payload.get("arguments", payload.get("input"))
                if ts:
                    last_ts = ts
                msgs.append({"role": "tool", "name": str(payload.get("name") or "tool"),
                             "text": self.summarize_tool(payload.get("name"), inp), "ts": ts})
            elif ptype in ("function_call_output", "custom_tool_call_output"):
                msgs.append({"role": "result", "text": self.content_text(payload.get("output"))[:RESULT_CAP],
                             "ts": ts})
        # Title: the first user prompt, else the first assistant message.
        first_prompt = (next((m["text"] for m in msgs if m["role"] == "user"), None)
                        or next((m["text"] for m in msgs if m["role"] == "assistant"), None))
        title = one_line(first_prompt)[:TITLE_MAX] if first_prompt else None
        return self.make_summary(sid, path, cwd, branch, title, first_ts, last_ts, msgs), msgs


SOURCE_LIST: Tuple[Source, ...] = (ClaudeSource(), CodexSource())   # order matters: claude first
SOURCES: Dict[str, Source] = {s.key: s for s in SOURCE_LIST}  # iterate SOURCE_LIST when order matters


def parse_any(source: str, path: str) -> Tuple[Summary, List[Msg]]:
    """Parse a transcript with the Source named by source.

    Args:
        source: "claude" or "codex".
        path: Path of the transcript file.

    Returns:
        The (summary, messages) tuple from Source.parse().

    Example: parse_any("claude", "/p/abc.jsonl") -> ClaudeSource().parse("/p/abc.jsonl")
    """
    return SOURCES[source].parse(path)


def discover() -> List[Tuple[str, str]]:
    """List every transcript file as (source, path) without opening any of them.

    Returns:
        A list of (source, path) pairs, one per transcript file found; all Claude Code files
        first, then all Codex files.

    Example: with ~/.claude/projects/-work-proj/abc.jsonl and
    ~/.codex/sessions/2025/03/01/rollout-...-<uuid>.jsonl on disk ->
    [("claude", "~/.claude/projects/-work-proj/abc.jsonl"),
    ("codex", "~/.codex/sessions/2025/03/01/rollout-...-<uuid>.jsonl")] (paths expanded)
    """
    return [(s.key, path) for s in SOURCE_LIST for path in s.discover()]


