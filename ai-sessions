#!/usr/bin/env python3
"""ai-sessions: browse and search Claude Code and Codex CLI session transcripts.

Interactive (curses) by default; --list and --show are plain-text, scriptable.
Standard library only; works on Python 3.6+.

Environment:
  AI_SESSIONS_CLAUDE_DIR  Claude Code projects dir (default ~/.claude/projects)
  AI_SESSIONS_CODEX_DIR   Codex home dir          (default ~/.codex)
  AI_SESSIONS_CLAUDE_CMD  command used to resume Claude sessions (default "claude")
  AI_SESSIONS_CODEX_CMD   command used to resume Codex sessions  (default "codex")
                          A word containing {id} gets the session id substituted;
                          otherwise the default resume args are appended
                          (claude: --resume ID, codex: resume ID). Examples:
                            claude --dangerously-skip-permissions --model opus
                            codex resume {id} --yolo
                          --claude-cmd / --codex-cmd override these.
  XDG_CACHE_HOME          cache root (index in $XDG_CACHE_HOME/ai-sessions/index.json)
"""

import argparse
import calendar
import collections
import curses
import datetime
import json
import locale
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from typing import Any, Callable, Dict, Iterator, List, Optional, Pattern, Tuple

# A parsed transcript message: a dict with keys
#   role  one of:
#           "user"       a prompt you typed
#           "assistant"  a reply from Claude / Codex
#           "cmd"        a slash command you ran (Claude only), e.g. "/review src/x.py"
#           "tool"       a tool call, summarized to one line, e.g. "Read: /path"
#           "result"     the output of a tool call (capped at RESULT_CAP chars)
#   text  the message text (for "tool": the one-line summary)
#   ts    epoch seconds (float) or None
#   name  only for "tool": the bare tool name (used for searching)
Msg = Dict[str, Any]
# One session's index entry (what is cached in index.json and what Session wraps).
# Keys: source ("claude"/"codex"), id, path, cwd, branch, title, first_ts, last_ts,
#       n_user, n_asst (message counts), blob (lowercased search text, capped).
# INDEX_VERSION must be bumped whenever these keys or their meaning change, so
# stale caches are discarded instead of being misread.
Summary = Dict[str, Any]
# One rendered transcript row: (text, kind). kind picks the color/attribute:
# title, meta, dim, text, user, asst, tool, result (see App.init_colors).
Line = Tuple[str, str]
# curses window (curses._CursesWindow is not importable at runtime).
Window = Any
# (y, x, height, width) screen region.
Box = Tuple[int, int, int, int]

# curses waits ESCDELAY ms after Esc to see whether it starts an escape sequence
# (arrow keys etc.); the default of 1000ms makes Esc feel sluggish. Must be set
# before curses initializes, and we respect a user-provided value.
os.environ.setdefault("ESCDELAY", "25")

INDEX_VERSION = 2          # bump when Summary keys/meaning change (see Summary above)
BLOB_CAP = 200000          # max chars of lowercased search text kept per session
RESULT_CAP = 4000          # max chars kept per tool result
TITLE_MAX = 100            # titles derived from a first prompt are cut to this length
FIRST_LINE_MAX = 160       # first_line() default: tool-argument summaries are cut here
CMD_PEEK = 400             # how far into a user message to look for <command-name>
RESULT_PREVIEW_LINES = 6   # tool-result lines shown before "... (N more lines)"
TRANSCRIPT_CACHE_SIZE = 6  # parsed transcripts kept in memory (LRU)
DATE_COL_WIDTH = 17        # "YYYY-MM-DD HH:MM" plus a space, in the session list
TAG_COL_WIDTH = 3          # "CC " / "CX " in the session list
SIDE_BY_SIDE_MIN_COLS = 100  # at least this wide: list | preview, else list over preview
TAG: Dict[str, str] = {"claude": "CC", "codex": "CX"}
LABEL: Dict[str, str] = {"claude": "Claude Code", "codex": "Codex"}
ASSISTANT_NAME: Dict[str, str] = {"claude": "Claude", "codex": "Codex"}

# User "messages" that the harness injects rather than the human typing them. They
# would otherwise pollute titles and search, so parse_claude drops them.
CLAUDE_NOISE: Tuple[str, ...] = (
    "<local-command-caveat>", "<local-command-stdout>", "<local-command-stderr>",
    "<system-reminder>", "<task-notification>", "<bash-input>", "<bash-stdout>",
    "<bash-stderr>", "<command-message>", "<user-prompt-submit-hook>",
    "Caveat:", "[Request interrupted", "This session is being continued",
)
# Codex injects context as user messages: a leading XML-ish tag wrapping the whole
# message (CODEX_TAG, checked together with a trailing ">") or one of these prefixes.
CODEX_TAG: Pattern[str] = re.compile(r"^<[A-Za-z_][\w\-]*[\s>/]")
CODEX_NOISE: Tuple[str, ...] = ("# AGENTS.md", "<environment_context>", "<user_instructions>",
               "<permissions", "<INSTRUCTIONS>")
# Claude records a slash command as a user message containing these tags.
CMD_NAME: Pattern[str] = re.compile(r"<command-name>\s*(.*?)\s*</command-name>", re.S)
CMD_ARGS: Pattern[str] = re.compile(r"<command-args>\s*(.*?)\s*</command-args>", re.S)
# ISO-8601-ish timestamps with optional fraction and Z / +hh:mm / +hhmm offset.
TS_RE: Pattern[str] = re.compile(
    r"(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d):(\d\d)(?:\.(\d+))?\s*(Z|[+-]\d\d:?\d\d)?")


# ---------------------------------------------------------------- helpers

def parse_ts(v: Any) -> Optional[float]:
    """Epoch seconds from an ISO-8601 string or a numeric epoch; None if unusable.

    Args:
        v: ISO-8601 string (optional fraction, Z or +hh:mm offset) or a numeric epoch. Numbers above
            1e11 are taken as milliseconds. Anything else gives None.

    Returns:
        Epoch seconds as a float, or None if v cannot be read as a time.

    Examples:
        parse_ts("2025-03-01T10:00:00.000Z") -> 1740823200.0
        parse_ts("2025-03-01T10:00:00+02:00") -> 1740816000
        parse_ts(1700000000000) -> 1700000000.0   (milliseconds are converted)
        parse_ts("nope") -> None
    """
    if v is None:
        return None
    if isinstance(v, (int, float)):
        # Epoch seconds are ~1.7e9 today; 1e11 seconds is the year ~5000, so anything
        # larger must be milliseconds.
        return v / 1000.0 if v > 1e11 else float(v)
    if not isinstance(v, str):
        return None
    m = TS_RE.match(v)
    if not m:
        return None
    try:
        y, mo, d, h, mi, s = [int(m.group(i)) for i in range(1, 7)]
        t: float = calendar.timegm((y, mo, d, h, mi, s, 0, 0, 0))
    except (ValueError, OverflowError):
        return None
    if m.group(7):
        t += float("0." + m.group(7))
    z = m.group(8)
    if z and z != "Z":
        sign = 1 if z[0] == "+" else -1
        zz = z[1:].replace(":", "")
        t -= sign * (int(zz[:2]) * 3600 + int(zz[2:4]) * 60)
    return t


def fmt_ts(ts: Optional[float], with_date: bool = True) -> str:
    """Format an epoch timestamp as local time ("YYYY-MM-DD HH:MM", or "HH:MM" without the
    date); "-" when it is missing, zero or out of range.

    Args:
        ts: Epoch seconds, or None/0 for "unknown".
        with_date: True for "YYYY-MM-DD HH:MM", False for just "HH:MM".

    Returns:
        The local-time text, or "-" when ts is missing, zero or out of range.

    Examples (local timezone UTC):
        fmt_ts(1740823200.0) -> "2025-03-01 10:00"
        fmt_ts(1740823200.0, with_date=False) -> "10:00"
        fmt_ts(None) -> "-"
    """
    if not ts:
        return "-"
    try:
        return datetime.datetime.fromtimestamp(ts).strftime(
            "%Y-%m-%d %H:%M" if with_date else "%H:%M")
    except (ValueError, OverflowError, OSError):
        return "-"


def clean(s: Any) -> str:
    """Make text safe for a terminal cell grid.

    Args:
        s: Text to sanitize; non-strings are converted with str().

    Returns:
        s with tabs as 4 spaces, carriage returns removed and other control characters replaced by
        spaces. Newlines are kept.

    Example: clean("a\\tb\\x07c") -> "a    b c"   (tab -> 4 spaces, control char -> space)
    """
    if not isinstance(s, str):
        s = str(s)
    s = s.replace("\t", "    ").replace("\r", "")
    return "".join(c if (c == "\n" or (ord(c) >= 32 and ord(c) != 127 and
                                       not (0x80 <= ord(c) < 0xa0))) else " " for c in s)


_wcache: Dict[str, int] = {}


def char_width(c: str) -> int:
    """Terminal columns one character occupies: 0 for combining marks, 2 for wide/fullwidth
    (CJK), else 1. Results are memoized in _wcache.

    Args:
        c: A single character.

    Returns:
        The width in terminal columns: 0, 1 or 2.

    Examples: char_width("a") -> 1; char_width("日") -> 2; char_width("\\u0301") -> 0
    """
    w = _wcache.get(c)
    if w is None:
        if unicodedata.combining(c):
            w = 0
        elif unicodedata.east_asian_width(c) in ("W", "F"):
            w = 2
        else:
            w = 1
        _wcache[c] = w
    return w


def str_width(s: str) -> int:
    return sum(char_width(c) for c in s)


def rule_chars() -> Tuple[str, str]:
    """(horizontal, vertical) separator characters: box-drawing when UTF-8, else ASCII.

    Returns:
        A (horizontal, vertical) pair of one-character strings.

    Examples: with a UTF-8 locale -> ("─", "│"); with an ASCII locale -> ("-", "|")
    """
    enc = (locale.getpreferredencoding(False) or "").lower().replace("-", "").replace("_", "")
    return ("─", "│") if enc == "utf8" else ("-", "|")


def clip(s: str, width: int) -> str:
    """Cut s to at most width display columns (wide chars count as 2).

    Args:
        s: Text to cut.
        width: Maximum display width in terminal columns; <= 0 gives "".

    Returns:
        The longest prefix of s that fits in width columns.

    Examples:
        clip("日本語abc", 5) -> "日本"
        clip("hello", 3) -> "hel"
        clip("hello", 0) -> ""
    """
    if width <= 0:
        return ""
    out, w = [], 0
    for c in s:
        k = char_width(c)
        if w + k > width:
            break
        out.append(c)
        w += k
    return "".join(out)


def pad(s: str, width: int) -> str:
    """Clip s to width display columns, then right-pad with spaces to exactly width.

    Args:
        s: Text to fit.
        width: Exact display width wanted, in terminal columns.

    Returns:
        s clipped to width columns, then padded with trailing spaces to exactly width.

    Examples:
        pad("ab", 5) -> "ab   "
        pad("日本語", 5) -> "日本 "   (the third wide char would not fit)
    """
    s = clip(s, width)
    return s + " " * (width - str_width(s))


def wrap(text: str, width: int) -> List[str]:
    """Word-wrap text to a display width; blank-line runs collapse to one.

    Args:
        text: Text to wrap; may contain newlines. Leading indentation of a line is kept on its
            continuation lines (up to half the width).
        width: Display width in terminal columns; values below 4 are treated as 4.

    Returns:
        The wrapped lines, with no trailing blank lines.

    Examples:
        wrap("the quick brown fox jumps", 10) -> ["the quick", "brown fox", "jumps"]
        wrap("a\\n\\n\\n\\nb", 10) -> ["a", "", "b"]
        wrap("abcdefghijkl", 6) -> ["abcdef", "ghijkl"]   (over-long words are split)
    """
    width = max(width, 4)
    lines: List[str] = []
    for para in text.split("\n"):
        para = para.rstrip()
        if not para.strip():
            if lines and lines[-1] != "":
                lines.append("")
            continue
        if str_width(para) <= width:
            lines.append(para)
            continue
        # Continuation lines keep the paragraph's leading indent (capped at half the width).
        indent = min(len(para) - len(para.lstrip(" ")), width // 2)
        current = " " * indent
        for word in para.strip().split(" "):
            if not word:
                continue
            # A word wider than a line is split across lines, `width - indent` columns at a time.
            while str_width(word) > width - indent:
                if current.strip():
                    lines.append(current)
                    current = " " * indent
                piece = clip(word, width - indent)
                if not piece:  # a single char wider than the line: emit it anyway
                    piece, word = word[:1], word[1:]
                else:
                    word = word[len(piece):]
                lines.append(" " * indent + piece)
            if not current.strip():
                current = " " * indent + word
            elif str_width(current) + 1 + str_width(word) <= width:
                current += " " + word
            else:
                lines.append(current)
                current = " " * indent + word
        if current.strip():
            lines.append(current)
    while lines and lines[-1] == "":
        lines.pop()
    return lines


def first_line(s: Any, n: int = FIRST_LINE_MAX) -> str:
    """First non-blank line of s, stripped and cut to n chars.

    Args:
        s: Any value; it is converted with str().
        n: Maximum number of characters to keep (default FIRST_LINE_MAX).

    Returns:
        The first non-blank line, stripped and cut to n characters; "" if there is none.

    Examples:
        first_line("\\n  hi there \\nmore") -> "hi there"
        first_line("abcdef", 3) -> "abc"
    """
    for ln in str(s).split("\n"):
        ln = ln.strip()
        if ln:
            return ln[:n]
    return ""


def one_line(s: Any) -> str:
    """Collapse all whitespace runs (including newlines) to single spaces.

    Args:
        s: Any value; it is converted with str().

    Returns:
        s with every whitespace run replaced by a single space, and the ends stripped.

    Example: one_line("a \\n b\\t c") -> "a b c"
    """
    return " ".join(str(s).split())


def terms_of(query: Optional[str]) -> List[str]:
    """Split a filter query into lowercase terms (all must match).

    Args:
        query: The raw filter text, or None.

    Returns:
        The whitespace-separated words of query, lowercased; [] when query is empty or None.

    Examples: terms_of("Foo  BAR") -> ["foo", "bar"]; terms_of(None) -> []
    """
    return [t for t in (query or "").lower().split() if t]


def term_regex(terms: List[str]) -> Optional[Pattern[str]]:
    """Case-insensitive regex matching any term, longest first (for highlighting).

    Args:
        terms: Lowercase search terms, such as the result of terms_of().

    Returns:
        A compiled case-insensitive regex that matches any term, or None if terms is empty.

    Examples:
        term_regex(["fo", "foobar"]).pattern -> "foobar|fo"
        term_regex([]) -> None
    """
    if not terms:
        return None
    return re.compile("|".join(re.escape(t) for t in sorted(terms, key=len, reverse=True)),
                      re.I)


# Tool-call argument names worth showing, in priority order (first one present wins).
TOOL_KEYS: Tuple[str, ...] = ("command", "cmd", "file_path", "path", "notebook_path", "pattern", "url",
             "description", "query", "prompt", "text", "message", "target")


def decode_json_object(s: str) -> Any:
    """Decode s if it looks like a JSON object; otherwise (or if invalid) return it unchanged.

    Args:
        s: A string, possibly holding a JSON object.

    Returns:
        The decoded value, or s itself.

    Examples:
        decode_json_object(' {"a": 1}') -> {"a": 1}
        decode_json_object("{oops") -> "{oops"
        decode_json_object("plain") -> "plain"
    """
    if s.strip().startswith("{"):
        try:
            return json.loads(s.strip())
        except ValueError:
            pass
    return s


def first_tool_arg(inp: Dict[str, Any]) -> str:
    """The most telling argument of a tool call, as one line.

    Args:
        inp: The tool's input dict.

    Returns:
        The first TOOL_KEYS entry present (a non-blank string, or a list of strings joined by
        spaces); failing that the first non-blank string value; "" if none.

    Examples:
        first_tool_arg({"x": "1", "command": "ls"}) -> "ls"
        first_tool_arg({"command": ["ls", "-l"]}) -> "ls -l"
        first_tool_arg({"x": "v"}) -> "v"
        first_tool_arg({"n": 3}) -> ""
    """
    for k in TOOL_KEYS:
        v = inp.get(k)
        if isinstance(v, str) and v.strip():
            return first_line(v)
        if isinstance(v, list) and v and all(isinstance(x, str) for x in v):
            return first_line(" ".join(v))
    for v in inp.values():
        if isinstance(v, str) and v.strip():
            return first_line(v)
    return ""


def summarize_tool(name: Any, inp: Any) -> str:
    """One-line "Name: key argument" summary of a tool call.

    inp is a dict (Claude), or a dict / JSON string / plain string (Codex). The
    argument shown is the first TOOL_KEYS entry present, else the first string value.

    Args:
        name: The tool name; None or empty becomes "tool".
        inp: The tool's input: a dict, a JSON string (decoded if it starts with "{"), a plain
            string, or anything else (then no argument is shown).

    Returns:
        "Name: argument", or just "Name" when no argument can be found.

    Examples:
        summarize_tool("Read", {"file_path": "/x"}) -> "Read: /x"
        summarize_tool("shell", '{"command": ["ls", "-l"]}') -> "shell: ls -l"
        summarize_tool("Foo", {"zzz": "v"}) -> "Foo: v"
        summarize_tool("Foo", {}) -> "Foo"
    """
    name = str(name or "tool")
    if isinstance(inp, str):
        inp = decode_json_object(inp)
    if isinstance(inp, str):
        val = first_line(inp)
    elif isinstance(inp, dict):
        val = first_tool_arg(inp)
    else:
        val = ""
    return "%s: %s" % (name, val) if val else name


def content_text(c: Any) -> str:
    """Flatten tool_result / output content to text.

    Content is a plain string or a list of strings / {"type":"text","text":...} blocks;
    other block kinds (images etc.) are dropped.

    Args:
        c: A string, a list of strings / {"type": "text", "text": ...} blocks, or anything else.

    Returns:
        The text parts joined with newlines; "" for unsupported content.

    Examples:
        content_text([{"type": "text", "text": "a"}, "b", {"type": "image"}]) -> "a\\nb"
        content_text("x") -> "x"
        content_text(None) -> ""
    """
    if isinstance(c, str):
        return c
    if not isinstance(c, list):
        return ""
    parts: List[str] = []
    for block in c:
        text = block.get("text") if isinstance(block, dict) else block
        if isinstance(text, str):
            parts.append(text)
    return "\n".join(parts)


# ---------------------------------------------------------------- parsing

def iter_json(path: str) -> Iterator[Dict[str, Any]]:
    """Yield each JSON-object line of a .jsonl file, skipping blank/garbled lines.

    Args:
        path: Path of a .jsonl file (one JSON value per line).

    Yields:
        Each line that decodes to a JSON object (dict), in file order.

    Example: for a file whose lines are `{"type": "user"}`, `garbage`, `` and `[1]`,
    iter_json(path) yields only {"type": "user"}; a missing file yields nothing.
    """
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line or line[0] != "{":
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if isinstance(obj, dict):
                    yield obj
    except OSError:
        return


def content_blocks(content: Any) -> Optional[List[Any]]:
    """Normalize Claude message content to a block list: a bare string becomes one text
    block; anything that is neither string nor list yields None (caller skips it).

    Args:
        content: A Claude message's "content": a string, a list of blocks, or something else.

    Returns:
        A list of blocks, or None if content is neither a string nor a list.

    Examples:
        content_blocks("hi") -> [{"type": "text", "text": "hi"}]
        content_blocks([{"type": "text", "text": "hi"}]) -> the same list
        content_blocks(5) -> None
    """
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    return content if isinstance(content, list) else None


def claude_user_msgs(blocks: List[Any], ts: Optional[float]) -> List[Msg]:
    """Turn the content blocks of a Claude "user" record into Msgs.

    Text blocks become "user" messages, or "cmd" messages for slash commands; harness-injected
    text (CLAUDE_NOISE) is dropped; tool_result blocks become "result" messages.

    Args:
        blocks: The normalized content blocks (see content_blocks()); non-dict blocks are skipped.
        ts: The record's timestamp, copied onto every message.

    Returns:
        The messages in block order.

    Examples:
        claude_user_msgs([{"type": "text", "text": " hi "}], 1.0) -> [{"role": "user", "text": "hi", "ts": 1.0}]
        claude_user_msgs([{"type": "text", "text": "<command-name>/clear</command-name>"}], None)
            -> [{"role": "cmd", "text": "/clear", "ts": None}]
        claude_user_msgs([{"type": "tool_result", "content": "ok"}], None)
            -> [{"role": "result", "text": "ok", "ts": None}]
    """
    out: List[Msg] = []
    for block in blocks:
        if not isinstance(block, dict):
            continue
        block_type = block.get("type")
        if block_type == "tool_result":
            out.append({"role": "result",
                        "text": content_text(block.get("content"))[:RESULT_CAP], "ts": ts})
            continue
        if block_type != "text":
            continue
        text = block.get("text")
        if not isinstance(text, str) or not text.strip():
            continue
        stripped = text.lstrip()
        # Peek only at the start: a command tag deep inside a long prompt is
        # just text the user pasted, not a slash command.
        head = stripped[:CMD_PEEK]
        cmd_match = CMD_NAME.search(head) if "<command-name>" in head else None
        if cmd_match:
            args_match = CMD_ARGS.search(stripped)
            cmd = cmd_match.group(1)
            if args_match and args_match.group(1):
                cmd += " " + one_line(args_match.group(1))
            out.append({"role": "cmd", "text": cmd, "ts": ts})
        elif not stripped.startswith(CLAUDE_NOISE):
            out.append({"role": "user", "text": text.strip(), "ts": ts})
    return out


def claude_assistant_msgs(blocks: List[Any], ts: Optional[float]) -> List[Msg]:
    """Turn the content blocks of a Claude "assistant" record into Msgs.

    Args:
        blocks: The normalized content blocks (see content_blocks()); non-dict blocks are skipped.
        ts: The record's timestamp, copied onto every message.

    Returns:
        "assistant" messages for non-blank text blocks and "tool" messages for tool_use blocks,
        in block order.

    Examples:
        claude_assistant_msgs([{"type": "text", "text": "done"}], 2.0)
            -> [{"role": "assistant", "text": "done", "ts": 2.0}]
        claude_assistant_msgs([{"type": "tool_use", "name": "Read", "input": {"file_path": "/x"}}], None)
            -> [{"role": "tool", "name": "Read", "text": "Read: /x", "ts": None}]
    """
    out: List[Msg] = []
    for block in blocks:
        if not isinstance(block, dict):
            continue
        block_type = block.get("type")
        if block_type == "text" and isinstance(block.get("text"), str) and block["text"].strip():
            out.append({"role": "assistant", "text": block["text"].strip(), "ts": ts})
        elif block_type == "tool_use":
            out.append({"role": "tool", "name": str(block.get("name") or "tool"),
                        "text": summarize_tool(block.get("name"), block.get("input")), "ts": ts})
    return out


def parse_claude(path: str) -> Tuple[Summary, List[Msg]]:
    """Parse a Claude Code transcript (~/.claude/projects/<project-dir>/<uuid>.jsonl).

    One JSON object per line. Records used (everything else is ignored):

        {"type": "custom-title", "customTitle": "Name set with /rename"}
        {"type": "ai-title", "aiTitle": "Generated title"}
        {"type": "summary", "summary": "Compaction summary"}
        {"type": "user", "cwd": "/work/proj", "gitBranch": "main",
         "timestamp": "2025-03-01T10:00:00.000Z", "isSidechain": false, "isMeta": false,
         "message": {"role": "user", "content": "text"
                     | [{"type": "text", "text": "..."},
                        {"type": "tool_result", "tool_use_id": "t1", "content": "..."}]}}
        {"type": "assistant", ...,
         "message": {"role": "assistant", "content": "text"
                     | [{"type": "text", "text": "..."},
                        {"type": "tool_use", "id": "t1", "name": "Read",
                         "input": {"file_path": "/x"}}]}}

    Skipped on purpose:
      * isSidechain records: subagent transcripts interleaved in the file; they are not
        the conversation with you.
      * isMeta records: synthetic messages the harness adds. Their cwd/branch are
        still harvested, but not their text or timestamps.
      * gitBranch "HEAD": a detached HEAD, which says nothing about the branch.
      * harness-injected user text (CLAUDE_NOISE: system reminders, hook output,
        "Caveat:" notices, ...).
    Slash commands arrive as user text with <command-name>/<command-args> tags and
    become "cmd" messages.

    The session id is the filename stem. Title priority: custom-title > ai-title >
    summary > the first real prompt (shortened to TITLE_MAX). Later records of the
    same title type replace earlier ones.

    Args:
        path: Path of the Claude Code .jsonl transcript. The session id is its filename without
            ".jsonl".

    Returns:
        A (summary, messages) tuple: summary is the index Summary (via make_summary), messages is
        the list of Msg dicts in file order.

    Example: for ~/.claude/projects/-work-proj/abc.jsonl holding one user line
    {"type": "user", "cwd": "/work/proj", "timestamp": "2025-03-01T10:00:00Z",
    "message": {"content": "fix the bug"}} and one assistant text reply "done":

        parse_claude(path) -> ({"source": "claude", "id": "abc", "cwd": "/work/proj",
                                "title": "fix the bug", "n_user": 1, "n_asst": 1, ...},
                               [{"role": "user", "text": "fix the bug", "ts": 1740823200.0},
                                {"role": "assistant", "text": "done", "ts": ...}])
    """
    sid = os.path.basename(path)[:-6]
    cwd: Optional[str] = None
    branch: Optional[str] = None
    custom: Optional[str] = None
    ai_title: Optional[str] = None
    summary_title: Optional[str] = None
    first_ts: Optional[float] = None
    last_ts: Optional[float] = None
    msgs: List[Msg] = []
    for record in iter_json(path):
        rtype = record.get("type")
        if rtype == "custom-title" and record.get("customTitle"):
            custom = record["customTitle"]
            continue
        if rtype == "ai-title" and record.get("aiTitle"):
            ai_title = record["aiTitle"]
            continue
        if rtype == "summary" and record.get("summary"):
            summary_title = record["summary"]
            continue
        if rtype not in ("user", "assistant"):
            continue
        if record.get("isSidechain"):
            continue
        if not cwd and isinstance(record.get("cwd"), str):
            cwd = record["cwd"]
        if not branch and isinstance(record.get("gitBranch"), str) and record["gitBranch"] != "HEAD":
            branch = record["gitBranch"]
        if record.get("isMeta"):
            continue
        message = record.get("message")
        if not isinstance(message, dict):
            continue
        ts = parse_ts(record.get("timestamp"))
        if ts:
            first_ts = first_ts or ts
            last_ts = ts
        blocks = content_blocks(message.get("content"))
        if blocks is None:
            continue
        if rtype == "user":
            msgs.extend(claude_user_msgs(blocks, ts))
        else:
            msgs.extend(claude_assistant_msgs(blocks, ts))
    first_prompt = next((m["text"] for m in msgs if m["role"] == "user"), None)
    title = custom or ai_title or summary_title or (
        one_line(first_prompt)[:TITLE_MAX] if first_prompt else None)
    return make_summary("claude", sid, path, cwd, branch, title, first_ts, last_ts, msgs), msgs


def codex_user_noise(text: str) -> bool:
    """True for Codex user messages that are injected context, not typed prompts.

    Args:
        text: The text of a Codex user message.

    Returns:
        True if it is injected context (AGENTS.md text, an XML-style wrapper tag, ...) rather than
        something the user typed.

    Examples:
        codex_user_noise("<environment_context>cwd: /x</environment_context>") -> True
        codex_user_noise("# AGENTS.md instructions for /x") -> True
        codex_user_noise("fix the bug") -> False
    """
    s = text.lstrip()
    return s.startswith(CODEX_NOISE) or bool(CODEX_TAG.match(s) and s.rstrip().endswith(">"))


def codex_message_text(payload: Dict[str, Any]) -> str:
    """Join the non-blank text parts of a Codex "message" payload.

    Args:
        payload: A response_item payload; its "content" is a string or a list of blocks that
            carry "text" (input_text / output_text).

    Returns:
        The text parts joined with newlines and stripped; "" if there are none.

    Examples:
        codex_message_text({"content": [{"type": "input_text", "text": "a"}, {"text": " "}, {"text": "b"}]})
            -> "a\\nb"
        codex_message_text({"content": "hi"}) -> "hi"
        codex_message_text({}) -> ""
    """
    blocks = payload.get("content")
    if isinstance(blocks, str):
        blocks = [{"text": blocks}]
    texts = [block["text"] for block in (blocks or []) if isinstance(block, dict)
             and isinstance(block.get("text"), str) and block["text"].strip()]
    return "\n".join(texts).strip()


def parse_codex(path: str) -> Tuple[Summary, List[Msg]]:
    """Parse a Codex rollout (~/.codex/sessions/YYYY/MM/DD/rollout-<time>-<uuid>.jsonl).

    One JSON object per line, {"timestamp", "type", "payload"}. Records used:

        {"type": "session_meta", "payload": {"id": "<uuid>", "timestamp": "...",
                                              "cwd": "/work/proj", "git": {"branch": "main"}}}
        {"type": "turn_context", "payload": {"cwd": "/work/proj", ...}}
        {"type": "response_item", "payload": {
            "type": "message", "role": "user" | "assistant",
            "content": [{"type": "input_text" | "output_text", "text": "..."}]}}
        {"type": "response_item", "payload": {
            "type": "function_call", "name": "shell", "arguments": "{\\"command\\": [...]}"}}
        {"type": "response_item", "payload": {
            "type": "custom_tool_call", "name": "apply_patch", "input": "*** Begin Patch..."}}
        {"type": "response_item", "payload": {
            "type": "function_call_output" | "custom_tool_call_output", "output": "..."}}

    Skipped: other roles (developer/system), other record types, and user messages that
    are injected context (see codex_user_noise: AGENTS.md text, <environment_context>...).

    The id comes from session_meta when present. Otherwise it is the last 36 characters
    of the filename stem: rollout-<timestamp>-<uuid> always ends in a 36-char UUID.
    Codex has no title records, so the title is the first user prompt (or the first
    assistant message); load_sessions() overrides it with session_index.jsonl names.

    Args:
        path: Path of the Codex rollout .jsonl file.

    Returns:
        A (summary, messages) tuple: summary is the index Summary (via make_summary), messages is
        the list of Msg dicts in file order.

    Example: for ~/.codex/sessions/2025/03/01/rollout-2025-03-01T10-00-00-<uuid>.jsonl with a
    session_meta record (id "<uuid>", cwd "/work/proj"), a user message "fix the bug" and a
    shell function_call:

        parse_codex(path) -> ({"source": "codex", "id": "<uuid>", "cwd": "/work/proj",
                               "title": "fix the bug", "n_user": 1, "n_asst": 0, ...},
                              [{"role": "user", "text": "fix the bug", "ts": 1.7e9},
                               {"role": "tool", "name": "shell", "text": "shell: ls -l", "ts": 1.7e9}])
    """
    stem = os.path.basename(path)[:-6]
    sid = stem[-36:] if len(stem) >= 36 else stem
    cwd: Optional[str] = None
    branch: Optional[str] = None
    first_ts: Optional[float] = None
    last_ts: Optional[float] = None
    msgs: List[Msg] = []
    for record in iter_json(path):
        rtype = record.get("type")
        payload = record.get("payload")
        if not isinstance(payload, dict):
            continue
        ts = parse_ts(record.get("timestamp"))
        if rtype == "session_meta":
            if isinstance(payload.get("id"), str):
                sid = payload["id"]
            if isinstance(payload.get("cwd"), str):
                cwd = payload["cwd"]
            git = payload.get("git")
            if isinstance(git, dict) and isinstance(git.get("branch"), str):
                branch = git["branch"]
            first_ts = parse_ts(payload.get("timestamp")) or first_ts
            continue
        if rtype == "turn_context" and not cwd and isinstance(payload.get("cwd"), str):
            cwd = payload["cwd"]
            continue
        if rtype != "response_item":
            continue
        ptype = payload.get("type")
        if ptype == "message":
            role = payload.get("role")
            if role not in ("user", "assistant"):
                continue
            text = codex_message_text(payload)
            if not text or (role == "user" and codex_user_noise(text)):
                continue
            if ts:
                first_ts = first_ts or ts
                last_ts = ts
            msgs.append({"role": role, "text": text, "ts": ts})
        elif ptype in ("function_call", "custom_tool_call"):
            inp = payload.get("arguments") if ptype == "function_call" else payload.get("input")
            if inp is None:
                inp = payload.get("arguments", payload.get("input"))
            if ts:
                last_ts = ts
            msgs.append({"role": "tool", "name": str(payload.get("name") or "tool"),
                         "text": summarize_tool(payload.get("name"), inp), "ts": ts})
        elif ptype in ("function_call_output", "custom_tool_call_output"):
            msgs.append({"role": "result", "text": content_text(payload.get("output"))[:RESULT_CAP],
                         "ts": ts})
    # Title: the first user prompt, else the first assistant message.
    first_prompt = (next((m["text"] for m in msgs if m["role"] == "user"), None)
                    or next((m["text"] for m in msgs if m["role"] == "assistant"), None))
    title = one_line(first_prompt)[:TITLE_MAX] if first_prompt else None
    return make_summary("codex", sid, path, cwd, branch, title, first_ts, last_ts, msgs), msgs


def make_summary(source: str, sid: str, path: str, cwd: Optional[str], branch: Optional[str],
           title: Optional[str], first_ts: Optional[float], last_ts: Optional[float],
           msgs: List[Msg]) -> Summary:
    """Build the index Summary from parsed fields and messages.

    Args:
        source: "claude" or "codex".
        sid: The session id.
        path: Transcript file path (its mtime is the fallback for missing timestamps).
        cwd: Working directory, or None if unknown.
        branch: Git branch, or None.
        title: Session title, or None.
        first_ts: Epoch seconds of the first message, or None.
        last_ts: Epoch seconds of the last message, or None.
        msgs: The parsed Msg list, used for the message counts and the search blob.

    Returns:
        The Summary dict. Missing text fields become ""; missing timestamps fall back to the file's
        mtime (or 0).

    Example: make_summary("claude", "abc", "/p/abc.jsonl", "/work/proj", None, "Fix bug",
    1.0, 2.0, [user "fix the bug", assistant "ok", tool Read]) ->
    {"source": "claude", "id": "abc", "path": "/p/abc.jsonl", "cwd": "/work/proj",
    "branch": "", "title": "Fix bug", "first_ts": 1.0, "last_ts": 2.0, "n_user": 1,
    "n_asst": 1, "blob": "fix the bug\\nok\\nread"}
    """
    n_user = sum(1 for m in msgs if m["role"] == "user")
    n_asst = sum(1 for m in msgs if m["role"] == "assistant")
    # "blob" is the text the filter searches: prompts, replies and tool names (not tool
    # results: too big and too noisy), lowercased once here, capped at BLOB_CAP.
    blob: List[str] = []
    size = 0
    for m in msgs:
        if m["role"] in ("user", "assistant"):
            piece = m["text"]
        elif m["role"] == "tool":
            piece = m.get("name", "")
        else:
            continue
        blob.append(piece)
        size += len(piece) + 1
        if size > BLOB_CAP:
            break
    try:
        st = os.stat(path)
        mtime = st.st_mtime
    except OSError:
        mtime = 0
    return {
        "source": source, "id": sid, "path": path, "cwd": cwd or "", "branch": branch or "",
        "title": one_line(title or ""), "first_ts": first_ts or mtime, "last_ts": last_ts or first_ts or mtime,
        "n_user": n_user, "n_asst": n_asst, "blob": "\n".join(blob)[:BLOB_CAP].lower(),
    }


def parse_any(source: str, path: str) -> Tuple[Summary, List[Msg]]:
    return parse_claude(path) if source == "claude" else parse_codex(path)


# ---------------------------------------------------------------- index

class Session(object):
    """A session as the UI sees it: the index Summary fields plus derived search text."""
    # Fields come from the index summary (see make_summary()) via __dict__.update.
    source: str
    id: str
    path: str
    cwd: str
    branch: str
    title: str
    first_ts: float
    last_ts: float
    n_user: int
    n_asst: int
    blob: str
    project: str
    search_text: str

    def __init__(self, d: Summary) -> None:
        """Build a Session from an index Summary dict, adding project, title fallback and search_text.

        Args:
            d: A Summary dict, as built by make_summary() or loaded from the index.

        Example: Session({"source": "claude", "id": "a1", "cwd": "/work/proj", "title": "",
        "blob": "Fix", ...}) -> .project == "proj", .title == "(untitled)",
        .search_text == "(untitled)\\nproj\\n/work/proj\\nfix"; with cwd "" -> .project == "-"
        """
        self.__dict__.update(d)
        self.project = os.path.basename(self.cwd.rstrip("/")) if self.cwd else "-"
        if not self.title:
            self.title = "(untitled)"
        self.search_text = "\n".join((self.title, self.project, self.cwd, self.blob)).lower()

    def resume_argv(self) -> List[str]:
        return build_resume_argv(self.source, self.id)[0]

    def resume_warning(self) -> Optional[str]:
        """Why the configured resume command was unusable (default is used), or None.

        Returns:
            A short message if the configured command was unusable, else None.
        """
        return build_resume_argv(self.source, self.id)[1]

    def resume_cmd(self) -> str:
        """Shell command line that resumes this session, prefixed with a cd into its cwd.

        Returns:
            A shell command line such as "cd /dir && claude --resume ID"; no "cd" part when the
            session has no cwd.

        Examples:
            claude session a1 in /work/proj -> "cd /work/proj && claude --resume a1"
            codex session b1 with cwd "" -> "codex resume b1"
        """
        cmd = " ".join(shell_quote(w) for w in self.resume_argv())
        return ("cd %s && %s" % (shell_quote(self.cwd), cmd)) if self.cwd else cmd


# source -> command template from --claude-cmd/--codex-cmd. A module global, written once
# by main() before anything reads it, because resume commands are built deep inside
# Session/App; threading it through every layer would add plumbing for no benefit.
CMD_OVERRIDES: Dict[str, str] = {}
DEFAULT_CMDS: Dict[str, str] = {"claude": "claude", "codex": "codex"}
DEFAULT_RESUME_ARGS: Dict[str, List[str]] = {"claude": ["--resume", "{id}"], "codex": ["resume", "{id}"]}


def resume_template(source: str) -> str:
    """Command template: CLI flag, then AI_SESSIONS_<SRC>_CMD, then the bare command.

    Args:
        source: "claude" or "codex".

    Returns:
        The command template: the --claude-cmd/--codex-cmd flag if given, else the
        AI_SESSIONS_<SOURCE>_CMD variable, else the bare command name.

    Examples:
        with no override and no env var: resume_template("claude") -> "claude"
        with AI_SESSIONS_CLAUDE_CMD="mycl --x {id}": resume_template("claude") -> "mycl --x {id}"
    """
    return (CMD_OVERRIDES.get(source)
            or os.environ.get("AI_SESSIONS_%s_CMD" % source.upper())
            or DEFAULT_CMDS[source])


def build_resume_argv(source: str, sid: str) -> Tuple[List[str], Optional[str]]:
    """Returns (argv, warning). warning is None unless the template was unusable.

    Args:
        source: "claude" or "codex".
        sid: Session id, substituted for "{id}" in the command template.

    Returns:
        An (argv, warning) tuple: argv is the command as a list of words; warning is a message when
        the template was unparsable or empty (the default command is used), else None.

    Examples:
        build_resume_argv("claude", "abc") -> (["claude", "--resume", "abc"], None)
        build_resume_argv("codex", "abc") -> (["codex", "resume", "abc"], None)
        with AI_SESSIONS_CLAUDE_CMD="mycl --x {id} --y":
            build_resume_argv("claude", "abc") -> (["mycl", "--x", "abc", "--y"], None)
        with AI_SESSIONS_CLAUDE_CMD="'unterminated":
            build_resume_argv("claude", "abc") ->
                (["claude", "--resume", "abc"], "bad claude command: No closing quotation")
    """
    warn: Optional[str] = None
    try:
        words = shlex.split(resume_template(source))
    except ValueError as e:
        words, warn = [], "bad %s command: %s" % (source, e)
    if not words:
        words = [DEFAULT_CMDS[source]]
        warn = warn or "empty %s command" % source
    if not any("{id}" in w for w in words):
        words = words + DEFAULT_RESUME_ARGS[source]
    return [w.replace("{id}", sid) for w in words], warn


def shell_quote(s: str) -> str:
    """Quote s for a POSIX shell, leaving it bare when it only has safe characters.

    Args:
        s: Any string.

    Returns:
        s unchanged if it has only safe characters, otherwise s wrapped in single quotes.

    Examples:
        shell_quote("/tmp/x") -> "/tmp/x"
        shell_quote("a b") -> "'a b'"
        shell_quote("it's") -> "'it'\\\\''s'"
    """
    if re.match(r"^[\w@%+=:,./-]+$", s):
        return s
    return "'" + s.replace("'", "'\\''") + "'"


def claude_dir() -> str:
    return os.path.expanduser(os.environ.get("AI_SESSIONS_CLAUDE_DIR") or "~/.claude/projects")


def codex_dir() -> str:
    return os.path.expanduser(os.environ.get("AI_SESSIONS_CODEX_DIR") or "~/.codex")


def cache_path() -> str:
    """Location of the summary index: $XDG_CACHE_HOME (default ~/.cache) / ai-sessions / index.json.

    Returns:
        The absolute path of the index file.

    Example: with XDG_CACHE_HOME=/c -> "/c/ai-sessions/index.json"
    """
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "ai-sessions", "index.json")


def discover() -> List[Tuple[str, str]]:
    """List every transcript file as (source, path) without opening any of them.

    Returns:
        A list of (source, path) pairs, one per transcript file found.

    Example: with ~/.claude/projects/-work-proj/abc.jsonl and
    ~/.codex/sessions/2025/03/01/rollout-...-<uuid>.jsonl on disk ->
    [("claude", "~/.claude/projects/-work-proj/abc.jsonl"),
    ("codex", "~/.codex/sessions/2025/03/01/rollout-...-<uuid>.jsonl")] (paths expanded)
    """
    found: List[Tuple[str, str]] = []
    try:
        project_dirs = list(os.scandir(claude_dir()))
    except OSError:
        project_dirs = []
    for d in project_dirs:
        # ~/.claude/projects/memory holds memory files, not session transcripts.
        if not d.is_dir(follow_symlinks=True) or d.name == "memory":
            continue
        try:
            for f in os.scandir(d.path):
                if f.name.endswith(".jsonl") and f.is_file():
                    found.append(("claude", f.path))
        except OSError:
            pass
    for dirpath, _dirnames, filenames in os.walk(os.path.join(codex_dir(), "sessions")):
        for name in filenames:
            if name.startswith("rollout-") and name.endswith(".jsonl"):
                found.append(("codex", os.path.join(dirpath, name)))
    return found


def read_codex_titles() -> Dict[str, str]:
    """Map Codex session id -> thread name from session_index.jsonl (may be absent).

    Returns:
        A dict mapping session id to a one-line title; empty if the file is missing or has no usable
        entries.

    Example: a session_index.jsonl line {"id": "u1", "thread_name": "Fix\\nbug"} ->
    {"u1": "Fix bug"}; a missing file -> {}
    """
    names: Dict[str, str] = {}
    for o in iter_json(os.path.join(codex_dir(), "session_index.jsonl")):
        if isinstance(o.get("id"), str) and isinstance(o.get("thread_name"), str) \
                and o["thread_name"].strip():
            names[o["id"]] = one_line(o["thread_name"])
    return names


def read_index_cache(cp: str) -> Dict[str, Any]:
    """Read the per-file entries of the summary index.

    Args:
        cp: Path of index.json (see cache_path()).

    Returns:
        The "files" mapping (transcript path -> entry); {} if the file is missing, corrupt, or
        written by another INDEX_VERSION.

    Example: a missing file -> {}
    """
    try:
        with open(cp, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict) and data.get("version") == INDEX_VERSION:
            return data.get("files") or {}
    except (OSError, ValueError):
        pass
    return {}


def write_index_cache(cp: str, files: Dict[str, Any]) -> None:
    """Atomically write the summary index (temp file + rename); failures are ignored.

    Args:
        cp: Path of index.json; its directory is created if needed.
        files: The transcript path -> entry mapping to store.

    Returns:
        None. The cache is only an optimization, so I/O errors are swallowed.

    Example: write_index_cache("/c/ai-sessions/index.json", {}) leaves
    {"version": INDEX_VERSION, "files": {}} in that file.
    """
    try:
        os.makedirs(os.path.dirname(cp), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(cp), prefix=".index-", suffix=".tmp")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({"version": INDEX_VERSION, "files": files}, f)
        os.replace(tmp, cp)
    except (OSError, TypeError, ValueError):
        pass


def load_sessions(progress: bool = False) -> List[Session]:
    """Return all sessions that have at least one user/assistant message.

    Parsing every transcript on each start would be slow, so summaries are cached in
    $XDG_CACHE_HOME/ai-sessions/index.json, keyed by file path. An entry is reused only
    if the file's mtime and size and the source (claude/codex) are unchanged; otherwise
    the file is re-parsed. Entries for files that vanished are pruned, but only under
    the roots scanned this run, so pointing AI_SESSIONS_*_DIR elsewhere temporarily does
    not discard the cache for the real dirs. The cache is rewritten atomically
    (temp file + rename) and only when something changed. A cache from another
    INDEX_VERSION, or a corrupt one, is ignored.

    Codex titles from session_index.jsonl are applied here at load time, after the
    cache, rather than stored in it: that file changes independently of the rollouts,
    so caching its names would leave them stale.

    Args:
        progress: If True, print an "indexing N file(s)" notice to stderr when files need parsing.

    Returns:
        A list of Session objects (unsorted), omitting sessions with no user or assistant messages.

    Example: with one Claude transcript (user + assistant message) under
    AI_SESSIONS_CLAUDE_DIR and an empty cache -> [Session(source="claude", ...)], and
    index.json now holds its summary; a second call re-parses nothing.
    """
    cp = cache_path()
    cache = read_index_cache(cp)
    found = discover()
    seen = set()
    result: List[Session] = []
    dirty = False
    todo: List[Tuple[str, str, os.stat_result]] = []
    entries: Dict[str, Dict[str, Any]] = {}
    for source, path in found:
        try:
            st = os.stat(path)
        except OSError:
            continue
        seen.add(path)
        e = cache.get(path)
        if isinstance(e, dict) and e.get("mtime") == st.st_mtime and e.get("size") == st.st_size \
                and isinstance(e.get("summary"), dict) and e["summary"].get("source") == source:
            entries[path] = e
        else:
            todo.append((source, path, st))
    if todo and progress:
        sys.stderr.write("ai-sessions: indexing %d file(s)...\n" % len(todo))
    for source, path, st in todo:
        try:
            summary, _ = parse_any(source, path)
        except Exception:  # never let one bad file break the browser
            continue
        entries[path] = {"mtime": st.st_mtime, "size": st.st_size, "summary": summary}
        dirty = True
    roots = (claude_dir(), os.path.join(codex_dir(), "sessions"))
    merged = dict(cache)
    merged.update(entries)
    for p in list(merged):
        if p not in seen and p.startswith(roots):
            del merged[p]
            dirty = True
    if dirty:
        write_index_cache(cp, merged)
    titles = read_codex_titles()
    for entry in entries.values():
        summary = dict(entry["summary"])
        if summary["source"] == "codex" and summary["id"] in titles:
            summary["title"] = titles[summary["id"]]
        if summary["n_user"] + summary["n_asst"] == 0:
            continue
        result.append(Session(summary))
    return result


def filter_sessions(sessions: List[Session], query: str = "", source: str = "all",
                    project: Optional[str] = None) -> List[Session]:
    """Sessions matching source ("all"/"claude"/"codex"), exact project cwd, and query.

    The query is split on whitespace; every term must appear (case-insensitive
    substring) in the session's title, project, cwd or transcript text.

    Args:
        sessions: The sessions to filter.
        query: Whitespace-separated terms; all must match. "" matches everything.
        source: "all", "claude" or "codex".
        project: Exact working directory to require, or None for any.

    Returns:
        The matching sessions, in their original order.

    Examples (sessions A = claude "Fix bug" in /work/proj, B = codex "Add tests" in /work/other):
        filter_sessions([A, B], "fix") -> [A]
        filter_sessions([A, B], "", source="codex") -> [B]
        filter_sessions([A, B], "", project="/work/proj") -> [A]
    """
    terms = terms_of(query)
    out: List[Session] = []
    for s in sessions:
        if source != "all" and s.source != source:
            continue
        if project is not None and s.cwd != project:
            continue
        if terms and not all(t in s.search_text for t in terms):
            continue
        out.append(s)
    return out


def sort_sessions(sessions: List[Session], mode: str = "last") -> List[Session]:
    """Newest first, by last activity (mode "last") or by start time (any other mode, e.g. "start").

    Args:
        sessions: The sessions to sort.
        mode: "last" (default) sorts by last activity; any other value sorts by start time.

    Returns:
        A new list, newest first.

    Example: A(first_ts=1, last_ts=2), B(first_ts=5, last_ts=3):
        sort_sessions([A, B]) -> [B, A]; sort_sessions([A, B], "start") -> [B, A]
        with B(first_ts=0, last_ts=3): sort_sessions([A, B], "start") -> [A, B]
    """
    key: Callable[[Session], float] = (
        (lambda s: s.last_ts) if mode == "last" else (lambda s: s.first_ts))
    return sorted(sessions, key=key, reverse=True)


# ---------------------------------------------------------------- rendering

# LRU cache of fully parsed transcripts (they are not stored in the index), keyed by
# (path, mtime) so a transcript that is still being written is re-read.
_parsed: "collections.OrderedDict[Tuple[str, float], List[Msg]]" = collections.OrderedDict()


def get_transcript(s: Session) -> List[Msg]:
    """Messages of a session, parsed on demand and kept in a small LRU cache.

    Args:
        s: The session whose transcript file to parse.

    Returns:
        The list of Msg dicts; [] if the file cannot be parsed.

    Example: get_transcript(s) parses s.path and returns [{"role": "user", "text": "fix the
    bug", "ts": 1.7e9}, ...]; calling it again with the file unchanged returns the cached list.
    """
    try:
        mt = os.stat(s.path).st_mtime
    except OSError:
        mt = 0
    k = (s.path, mt)
    if k in _parsed:
        _parsed.move_to_end(k)
        return _parsed[k]
    try:
        _, msgs = parse_any(s.source, s.path)
    except Exception:
        msgs = []
    _parsed[k] = msgs
    while len(_parsed) > TRANSCRIPT_CACHE_SIZE:
        _parsed.popitem(last=False)
    return msgs


def result_preview_lines(text: str, width: int) -> List[Line]:
    """Render a tool result as at most RESULT_PREVIEW_LINES "result" rows plus a "more" note.

    Args:
        text: The tool result text.
        width: Display width in terminal columns.

    Returns:
        (row, "result") pairs: the first non-blank lines of text (or "(empty)"), each clipped
        to fit, and a final "... (N more lines)" row when some were cut.

    Examples:
        result_preview_lines("", 40) -> [("    ← (empty)", "result")]
        result_preview_lines("a\\n\\nb", 40) -> [("    ← a", "result"), ("    ← b", "result")]
    """
    body = [x for x in clean(text).split("\n") if x.strip()] or ["(empty)"]
    rows: List[Line] = [("    ← " + clip(x.rstrip(), width - 6), "result")
                        for x in body[:RESULT_PREVIEW_LINES]]
    if len(body) > RESULT_PREVIEW_LINES:
        rows.append(("    ← ... (%d more lines)" % (len(body) - RESULT_PREVIEW_LINES), "result"))
    return rows


def render(s: Session, msgs: List[Msg], width: int, show_results: bool,
           mine_only: bool = False) -> Tuple[List[Line], int]:
    """Return (lines, body_start) for a session at the given display width.

    lines are (text, kind) pairs, already wrapped/clipped to width. The first
    body_start lines are the header (title, id, dir, branch, dates, counts, rule);
    the transcript body follows. Kinds: title, meta, dim (header); user / asst (speaker
    labels); text (message body); tool (calls and slash commands); result (tool output).
    show_results includes tool results; mine_only keeps only your own input (prompts
    and slash commands).

    Args:
        s: The session, used for the header.
        msgs: Its parsed transcript.
        width: Display width in terminal columns (minimum 10).
        show_results: Include tool results.
        mine_only: Keep only your own prompts and slash commands (default False).

    Returns:
        A (lines, body_start) tuple: lines is a list of (text, kind) rows; body_start is the index
        of the first row after the header.

    Example: for a claude session "Fix bug" (id a1, cwd /work/proj, no branch) with messages
    [user "fix the bug", assistant "ok", tool "Read: /x"], width 40, show_results False ->
    lines (body_start == 6):
        ("Fix bug", "title"), ("Claude Code   a1", "meta"), ("Dir:     /work/proj", "meta"),
        ("Started: ...   Updated: ...", "meta"), ("Messages: 1 you, 1 claude", "meta"),
        ("────...", "dim"), ("", "text"), ("You:  10:00", "user"), ("  fix the bug", "text"),
        ("", "text"), ("Claude:", "asst"), ("  ok", "text"), ("  → Read: /x", "tool")
    """
    width = max(width, 10)
    lines: List[Line] = []

    def add_wrapped(text: str, kind: str, prefix: str = "") -> None:
        for ln in wrap(text, width - len(prefix)):
            lines.append(((prefix + ln) if ln else "", kind))

    add_wrapped(s.title, "title")
    lines.append(("%s   %s" % (LABEL[s.source], s.id), "meta"))
    add_wrapped("Dir:     " + (s.cwd or "-"), "meta")
    if s.branch:
        add_wrapped("Branch:  " + s.branch, "meta")
    lines.append(("Started: %s   Updated: %s" % (fmt_ts(s.first_ts), fmt_ts(s.last_ts)), "meta"))
    lines.append(("Messages: %d you, %d %s" % (s.n_user, s.n_asst, ASSISTANT_NAME[s.source].lower()),
                  "meta"))
    lines.append((rule_chars()[0] * min(width, 200), "dim"))
    body_start = len(lines)
    for msg in msgs:
        role = msg["role"]
        if role == "result" and not show_results:
            continue
        if mine_only and role not in ("user", "cmd"):
            continue
        if role in ("user", "assistant"):
            if lines and lines[-1][0] != "":
                lines.append(("", "text"))
            who = "You:" if role == "user" else ASSISTANT_NAME[s.source] + ":"
            lines.append((who + ("  " + fmt_ts(msg["ts"], False) if msg.get("ts") else ""),
                          "user" if role == "user" else "asst"))
            add_wrapped(msg["text"], "text", "  ")
        elif role == "cmd":
            lines.append(("  > " + clip(clean(msg["text"]), width - 4), "tool"))
        elif role == "tool":
            lines.append(("  → " + clip(clean(msg["text"]), width - 4), "tool"))
        elif role == "result":
            lines.extend(result_preview_lines(msg["text"], width))
    return lines, body_start


def hit_lines(lines: List[Line], start: int, terms: List[str]) -> List[int]:
    """Indexes of body lines (from `start`, so never the header) containing any term.

    Args:
        lines: Rendered (text, kind) rows.
        start: Index of the first body row; header rows before it never count.
        terms: Lowercase search terms; a row matches if it contains any of them.

    Returns:
        The indexes of matching rows, in order; [] when terms is empty.

    Example: lines [("Fix bug", "title"), ..., ("  fix the bug", "text")] with start=6 and
    terms ["bug"] -> [8] (the title at index 0 is in the header, so it is not a hit).
    """
    if not terms:
        return []
    return [i for i in range(start, len(lines))
            if lines[i][1] in ("text", "tool", "result", "user", "asst")
            and any(t in lines[i][0].lower() for t in terms)]


# ---------------------------------------------------------------- clipboard

def copy_clipboard(text: str) -> Optional[str]:
    """Copy text with the first available tool; return its name, or None if none worked.

    Args:
        text: Text to put on the clipboard.

    Returns:
        The name of the tool that worked (e.g. "pbcopy"), or None if none did.

    Examples: on macOS copy_clipboard("cd /x && claude --resume a1") -> "pbcopy";
    on a Linux box with only xclip -> "xclip"; with no clipboard tool -> None
    """
    # Try pbcopy (macOS) first; prefer wl-copy ahead of the X11 tools on a Wayland session.
    candidates: List[List[str]] = [["pbcopy"]]
    if os.environ.get("WAYLAND_DISPLAY"):
        candidates.append(["wl-copy"])
    candidates += [["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"],
                   ["wl-copy"]]
    for cmd in candidates:
        if not shutil.which(cmd[0]):
            continue
        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL)
            proc.communicate(text.encode("utf-8"), timeout=5)
            if proc.returncode == 0:
                return cmd[0]
        except (OSError, subprocess.SubprocessError):
            continue
    return None


